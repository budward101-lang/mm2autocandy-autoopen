local function mkBtn(order, text, color, textColor)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 26), LayoutOrder = order,
        BackgroundColor3 = color, Text = text,
        TextColor3 = textColor or Color3.fromRGB(225, 225, 230),
        Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0,
    }, body)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
    return b
end

local function makeToggle(order, text, getter, setter)
    local b = mkBtn(order, "", Color3.fromRGB(35, 28, 45))
    local function refresh()
        b.Text = text .. ": " .. (getter() and "ON" or "OFF")
        b.TextColor3 = getter() and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(255, 110, 110)
    end
    b.MouseButton1Click:Connect(function() setter(not getter()); refresh() end)
    refresh()
end

makeToggle(2, "Candy Autofarm", function() return STATE.farm end, function(v) STATE.farm = v end)
makeToggle(3, "Auto Open Halloween Box", function() return STATE.open end, function(v) STATE.open = v end)
makeToggle(4, "Require balance", function() return CONFIG.RequireBalance end, function(v) CONFIG.RequireBalance = v end)
makeToggle(5, "Force (ignore balance)", function() return STATE.force end, function(v) STATE.force = v end)

local modeBtn = mkBtn(6, "", Color3.fromRGB(50, 40, 70))
refreshMode = function()
    modeBtn.Text = "Open mode: " .. STATE.mode:upper() .. "  (F3)"
    modeBtn.TextColor3 = STATE.mode == "learn" and Color3.fromRGB(140, 210, 255)
        or STATE.mode == "remote" and Color3.fromRGB(255, 190, 110)
        or Color3.fromRGB(200, 200, 210)
end
modeBtn.MouseButton1Click:Connect(function() doCycleMode() end)
refreshMode()

mkBtn(7, "SELF TEST (read this first)", Color3.fromRGB(60, 45, 20), Color3.fromRGB(255, 220, 140))
    .MouseButton1Click:Connect(function() selfTest() end)

