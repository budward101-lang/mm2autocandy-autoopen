    Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Color3.fromRGB(34, 24, 46),
    Text = " MM2 HALLOWEEN", TextColor3 = Color3.fromRGB(255, 170, 70),
    Font = Enum.Font.GothamBold, TextSize = 14,
    TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0, Active = true,
}, win)
