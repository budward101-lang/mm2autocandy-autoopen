--============================================================
--  MM2 HALLOWEEN - Candy Autofarm + Halloween Box Opener
--  Noclip | TweenSpeed 25 | core APIs only
--  RightShift = hide UI | F1 = farm | F2 = open box
--============================================================

local CFG = {
	Tween         = 25,                 -- studs per second
	Hold          = 0.10,               -- seconds parked on a candy
	MaxSize       = 8,                  -- ignore map parts bigger than this
	AntiAFK       = true,
	Mode          = "Remote",           -- Remote | GUI
	Crate         = "Halloween2026Box", -- arg 1 (captured from OpenCrate)
	BoxType       = "MysteryBox",       -- arg 2
	Pay           = "Candies2026",      -- arg 3 (currency)
	-- collection tuning
	MaxTween      = 1.2,                -- seconds, hard cap on one tween
	SnapBeyond    = 250,                -- studs; farther than this = teleport instead of tween
	MaxRise       = 80,                 -- reject parts this far above the candy median (skybox)
	VoidDrop      = 120,                -- if we fall this far below the candies, snap back
	ScanRate      = 0.20,               -- seconds between full scans
}

local P   = game:GetService("Players")
local RS  = game:GetService("ReplicatedStorage")
local TS  = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local RUN = game:GetService("RunService")
local CS  = game:GetService("CollectionService")
local VU  = game:GetService("VirtualUser")
local lp  = P.LocalPlayer

local farmOn, picked, boxes = false, 0, 0
local lastRarity = "-"
local started = os.clock()
local status

local Shop      = RS:WaitForChild("Remotes"):WaitForChild("Shop")
local OpenCrate = Shop:WaitForChild("OpenCrate")

local moving  = false      -- true while a grab owns the CFrame
local holdCF  = nil        -- CFrame to pin the character to while parked

local function getHRP()
	local ch = lp.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

--==================== BUILD UI ====================
local function new(c, props, parent)
	local o = Instance.new(c)
	for k, v in pairs(props) do pcall(function() o[k] = v end) end
	o.Parent = parent
	return o
end

local pg  = lp:WaitForChild("PlayerGui")
local gui = new("ScreenGui", {
	Name = "MM2Halloween", ResetOnSpawn = false,
	IgnoreGuiInset = true, DisplayOrder = 99,
}, pg)

local win = new("Frame", {
	Size = UDim2.new(0, 240, 0, 306), Position = UDim2.new(0, 20, 0, 80),
	BackgroundColor3 = Color3.fromRGB(20, 16, 30),
	BorderSizePixel = 0, Active = true,
}, gui)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, win)
new("UIStroke", { Color = Color3.fromRGB(255, 140, 40), Thickness = 1.5 }, win)

local head = new("TextLabel", {
	Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Color3.fromRGB(34, 24, 46),
	Text = "  MM2 HALLOWEEN", TextColor3 = Color3.fromRGB(255, 170, 70),
	Font = Enum.Font.GothamBold, TextSize = 14,
	TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0, Active = true,
}, win)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, head)

local body = new("Frame", {
	Size = UDim2.new(1, -16, 1, -42), Position = UDim2.new(0, 8, 0, 36),
	BackgroundTransparency = 1,
}, win)
new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)

local function btn(text, order, color)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), LayoutOrder = order,
		BackgroundColor3 = color or Color3.fromRGB(46, 34, 62),
		TextColor3 = Color3.fromRGB(235, 235, 240),
		Font = Enum.Font.GothamMedium, TextSize = 13,
		BorderSizePixel = 0, Text = text,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	return b
end

local stats = new("TextLabel", {
	Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 0,
	BackgroundColor3 = Color3.fromRGB(28, 22, 38), BorderSizePixel = 0,
	TextColor3 = Color3.fromRGB(200, 200, 215), Font = Enum.Font.Code,
	TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
}, body)
new("UICorner", { CornerRadius = UDim.new(0, 6) }, stats)
new("UIPadding", { PaddingTop = UDim.new(0, 5), PaddingLeft = UDim.new(0, 7) }, stats)

local farmBtn = btn("Farm Candy: OFF", 1)
local boxBtn  = btn("Open Halloween Box", 2, Color3.fromRGB(70, 40, 95))
local modeBtn = btn("Box Mode: Remote", 3)
local scanBtn = btn("Scan Candies + Remotes", 4)

status = new("TextLabel", {
	Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 5,
	BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(180, 180, 200),
	Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top, Text = "ready",
}, body)

local function say(s) status.Text = tostring(s) end

--==================== DRAG + KEYS ====================
do
	local drag, from, origin
	head.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then
			drag, from, origin = true, i.Position, win.Position
		end
	end)
	head.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then drag = false end
	end)
	UIS.InputChanged:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - from
			win.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X,
			                         origin.Y.Scale, origin.Y.Offset + d.Y)
		end
	end)
	UIS.InputBegan:Connect(function(i, gp)
		if gp then return end
		if i.KeyCode == Enum.KeyCode.RightShift then
			win.Visible = not win.Visible
		elseif i.KeyCode == Enum.KeyCode.F1 then
			farmBtn.MouseButton1Click:Fire()
		elseif i.KeyCode == Enum.KeyCode.F2 then
			boxBtn.MouseButton1Click:Fire()
		end
	end)
end

--==================== NOCLIP ====================
RUN.Stepped:Connect(function()
	local ch = lp.Character
	if not ch then return end
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
	end
end)

--==================== CANDY ====================
-- Candies spawn in place of Coins during rounds; collected by touch.
-- Detection is attribute-first so decorations named "candy"/"coin" don't get targeted.

local function candyAttr(d)
	local id = d:GetAttribute("CoinID")
	if id ~= nil then
		return tostring(id):lower():find("candy", 1, true) ~= nil
	end
	return nil
end

local function tagHasCandy(d)
	for _, t in ipairs(CS:GetTags(d)) do
		local tl = t:lower()
		if tl:find("candy", 1, true) or tl:find("coin", 1, true) then return true end
	end
	return false
end

local function isCandy(d)
	if not d:IsA("BasePart") then return false end
	local m = d:FindFirstAncestorOfClass("Model")
	if m and P:GetPlayerFromCharacter(m) then return false end
	local s = d.Size
	if math.max(s.X, s.Y, s.Z) > CFG.MaxSize then return false end

	local attr = candyAttr(d)
	if attr ~= nil then return attr end       -- authoritative when the game sets it
	if tagHasCandy(d) then return true end
	local n = d.Name:lower()
	return n:find("candy", 1, true) ~= nil or n:find("coin", 1, true) ~= nil
end

-- find the folder/model that actually holds the candies (don't scan all of workspace)
local scopeCache, scopeAt
local function candyScope()
	if scopeCache and scopeCache.Parent and os.clock() - scopeAt < 5 then
		return scopeCache
	end
	local best, bestN
	for _, d in ipairs(workspace:GetChildren()) do
		if d:IsA("Folder") or d:IsA("Model") then
			local n = 0
			for _, x in ipairs(d:GetDescendants()) do
				if x:IsA("BasePart") and x:GetAttribute("CoinID") ~= nil then n = n + 1 end
			end
			if n > 0 and (not bestN or n > bestN) then best, bestN = d, n end
		end
	end
	scopeCache, scopeAt = best or workspace, os.clock()
	return scopeCache
end

local function scanCandy()
	local scope = candyScope()
	local out = {}
	for _, d in ipairs(scope:GetDescendants()) do
		if isCandy(d) then out[#out + 1] = d end
	end
	if #out < 3 then return out end

	-- reject vertical outliers (skybox / props floating way above the pickups)
	local ys = {}
	for i, c in ipairs(out) do ys[i] = c.Position.Y end
	table.sort(ys)
	local medY = ys[math.max(1, math.ceil(#ys / 2))]
	local keep = {}
	for _, c in ipairs(out) do
		local dy = c.Position.Y - medY
		if dy <= CFG.MaxRise and dy >= -CFG.MaxRise then keep[#keep + 1] = c end
	end
	return keep
end

-- throttled scan + drop dead refs
local list, listAt = {}, 0
local function candies()
	if os.clock() - listAt > CFG.ScanRate then
		list, listAt = scanCandy(), os.clock()
	end
	local live = {}
	for _, c in ipairs(list) do if c.Parent then live[#live + 1] = c end end
	list = live
	return live
end

--==================== MOVEMENT ====================
-- noclip means nothing supports the character, so we pin it while parked.

RUN.RenderStepped:Connect(function()
	if not farmOn or moving or not holdCF then return end
	local hrp = getHRP()
	if not hrp then return end
	hrp.CFrame = holdCF
	hrp.AssemblyLinearVelocity  = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
end)

local function grab(part, hrp)
	moving = true

	local dist = (part.Position - hrp.Position).Magnitude
	local dest = CFrame.new(part.Position)

	if dist > CFG.SnapBeyond then
		hrp.CFrame = dest                                  -- too far to tween slowly
	else
		local dur = math.clamp(dist / CFG.Tween, 0.05, CFG.MaxTween)
		local tw = TS:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = dest })
		tw:Play()
		local t0 = os.clock()
		repeat RUN.RenderStepped:Wait() until os.clock() - t0 >= dur
	end

	if not part.Parent then                                -- candy got taken mid-flight
		holdCF = hrp.CFrame
		moving = false
		return false
	end

	-- nudge to force the Touched, then settle
	hrp.CFrame = part.CFrame * CFrame.new(0, 0.8, 0)
	task.wait(0.03)
	hrp.CFrame = part.CFrame
	hrp.AssemblyLinearVelocity  = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	holdCF = hrp.CFrame
	task.wait(CFG.Hold)

	for _, x in ipairs(part:GetDescendants()) do
		if x:IsA("ProximityPrompt") then
			pcall(function()
				if fireproximityprompt then
					fireproximityprompt(x)
				else
					x:InputHoldBegin(); task.wait(x.HoldDuration); x:InputHoldEnd()
				end
			end)
		elseif x:IsA("ClickDetector") and fireclickdetector then
			pcall(fireclickdetector, x)
		end
	end

	moving = false
	return not part.Parent
end

task.spawn(function()
	while task.wait(0.05) do
		if farmOn then
			local hrp = getHRP()
			if hrp then
				local cs = candies()
				if #cs > 0 then
					-- void watchdog: if we dropped below the pickups, snap to the nearest
					local sumY = 0
					for _, c in ipairs(cs) do sumY = sumY + c.Position.Y end
					if hrp.Position.Y < (sumY / #cs) - CFG.VoidDrop then
						holdCF = nil
						hrp.CFrame = CFrame.new(cs[1].Position)
					end

					local best, bd
					for _, c in ipairs(cs) do
						local d = (c.Position - hrp.Position).Magnitude
						if not bd or d < bd then best, bd = c, d end
					end

					local ok, got = pcall(grab, best, hrp)
					if ok and got then picked = picked + 1 end
				else
					holdCF = hrp.CFrame                      -- pin in place, don't drift
					task.wait(0.1)
				end
			else
				task.wait(0.2)
			end
		end
	end
end)

lp.CharacterAdded:Connect(function() holdCF, moving = nil, false end)

--==================== BOX ====================
local function visibleButtons()
	local out = {}
	local p = lp:FindFirstChildOfClass("PlayerGui")
	if not p then return out end
	for _, d in ipairs(p:GetDescendants()) do
		if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
			out[#out + 1] = d
		end
	end
	return out
end

local function clickKeyword(kws)
	for _, b in ipairs(visibleButtons()) do
		local label = b.Name .. " "
		if b:IsA("TextButton") then label = label .. b.Text end
		label = label:lower()
		for _, k in ipairs(kws) do
			if label:find(k, 1, true) then
				pcall(function()
					if firesignal then
						firesignal(b.MouseButton1Click)
					else
						b:Activate()
					end
				end)
				return b
			end
		end
	end
end

local function openBox()
	if CFG.Mode == "Remote" then
		local ok, result = pcall(function()
			return OpenCrate:InvokeServer(CFG.Crate, CFG.BoxType, CFG.Pay)
		end)
		if not ok then return "invoke errored: " .. tostring(result) end
		if type(result) == "table" then
			boxes = boxes + 1
			lastRarity = tostring(result.Rarity or "?")
			print("[MM2] rolled:", result.Rarity, result.Name or result.Item or "?")
			return "opened - rarity: " .. lastRarity
		end
		return "returned " .. tostring(result) .. " (nil = open failed, check Candies2026)"
	else
		local b = clickKeyword({ "open", "unbox", "box", "crate", "halloween" })
		if b then boxes = boxes + 1; return "clicked " .. b.Name end
		return "no matching button on screen"
	end
end

--==================== BUTTONS ====================
farmBtn.MouseButton1Click:Connect(function()
	farmOn = not farmOn
	if not farmOn then holdCF = nil end
	farmBtn.Text = "Farm Candy: " .. (farmOn and "ON" or "OFF")
	farmBtn.BackgroundColor3 = farmOn and Color3.fromRGB(26, 120, 60)
		or Color3.fromRGB(46, 34, 62)
	say(farmOn and "farming candies..." or "farm stopped")
end)

boxBtn.MouseButton1Click:Connect(function()
	local msg = openBox()
	say(msg)
	print("[MM2] " .. msg)
end)

modeBtn.MouseButton1Click:Connect(function()
	CFG.Mode = (CFG.Mode == "Remote") and "GUI" or "Remote"
	modeBtn.Text = "Box Mode: " .. CFG.Mode
	say("box mode = " .. CFG.Mode)
end)

scanBtn.MouseButton1Click:Connect(function()
	local cs = scanCandy()
	print(("===== CANDY CANDIDATES: %d ====="):format(#cs))
	for i = 1, math.min(#cs, 20) do
		local c = cs[i]
		print(i, c:GetFullName(), "CoinID=", tostring(c:GetAttribute("CoinID")), "size=", tostring(c.Size))
	end
	print("scope:", candyScope():GetFullName())
	print("===== SHOP REMOTES =====")
	for _, x in ipairs(Shop:GetChildren()) do print(x.ClassName, x:GetFullName()) end
	say(("candies: %d | scope: %s - check console"):format(#cs, candyScope():GetFullName()))
end)

--==================== STATS ====================
task.spawn(function()
	while task.wait(0.4) do
		local run = os.clock() - started
		stats.Text = string.format(
			"picked : %d\nboxes  : %d\nrarity : %s\nuptime : %02d:%02d\nper/hr : %.0f",
			picked, boxes, lastRarity, run // 60, run % 60,
			picked / math.max(run / 3600, 0.0001))
	end
end)

--==================== ANTI AFK ====================
if CFG.AntiAFK then
	pcall(function()
		local cons = getconnections and getconnections(lp.Idled)
		if cons and #cons > 0 then
			for _, c in ipairs(cons) do
				pcall(function()
					if c.Disable then c.Disable(c) elseif c.Disconnect then c.Disconnect(c) end
				end)
			end
		else
			lp.Idled:Connect(function()
				VU:CaptureController()
				VU:ClickButton2(Vector2.new())
			end)
		end
	end)
end

print("[MM2 Halloween] loaded - RightShift UI | F1 farm | F2 box")
