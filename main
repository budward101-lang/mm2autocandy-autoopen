--=============================================================
--  MM2 • HALLOWEEN 2026  —  CANDY AUTOFARM + BACKGROUND BOX OPEN
--  HARDENED BUILD: staged boot, fatal traceback, self-test,
--  ancestor name matching. RightShift = UI | F1 Farm | F2 Open
--=============================================================

local ok, err = xpcall(function()

local STAGE = function(s) print("[MM2] " .. s) end
STAGE("boot")

local CONFIG = {
    HopInterval    = 1.0,
    HoverHeight    = 2.5,
    RescanTime     = 0.8,
    VerifyDelay    = 0.30,
    RetryOnMiss    = true,
    MaxAttempts    = 2,
    ClaimCooldown  = 3.0,
    NearestFirst   = true,

    -- matches the part name AND up to NameDepth ancestors
    NameFilter     = {"candy", "sweet", "coin", "treat", "lolli", "gum", "pumpkin"},
    NameDepth      = 2,
    MaxSize        = 8,
    MaxRange       = 6000,

    AutoFarm       = true,
    AutoOpen       = true,
    BoxCost        = 600,
    StepCooldown   = 1.2,
    RequireBalance = true,
    Verbose        = true,

    OpenMode       = "learn",
    OpenRemote     = "",
    OpenArgs       = {},

    Keybinds = { UI = Enum.KeyCode.RightShift, Farm = Enum.KeyCode.F1,
                 Open = Enum.KeyCode.F2, Mode = Enum.KeyCode.F3 },
}

local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local UIS     = game:GetService("UserInputService")
local LP      = Players.LocalPlayer

local STATE = {
    farm = CONFIG.AutoFarm, open = CONFIG.AutoOpen, force = false,
    mode = CONFIG.OpenMode,
    collected = 0, hops = 0, boxes = 0, missed = 0, fresh = 0, spent = 0,
    moving = false, started = os.clock(),
    candy = nil, candyPath = "?", log = "booting",
}
local claimedUntil, attempts = {}, {}
STAGE("config ok")

--==================== BASICS ====================

local function pgui() return LP:FindFirstChildOfClass("PlayerGui") end

local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return nil end
    return c, h, r
end

local function nameMatches(name, list)
    name = name:lower()
    for _, f in ipairs(list) do
        if name:find(f, 1, true) then return true end
    end
    return false
end

local function underCharacter(p)
    local a = p.Parent
    while a and a ~= workspace do
        if a:IsA("Model") and Players:GetPlayerFromCharacter(a) then return true end
        a = a.Parent
    end
    return false
end

local function isCandy(p)
    if not p:IsA("BasePart") then return false end
    local s = p.Size
    if math.max(s.X, s.Y, s.Z) > CONFIG.MaxSize then return false end

    local hit, n, depth = false, p, 0
    while n and depth <= CONFIG.NameDepth do
        if nameMatches(n.Name, CONFIG.NameFilter) then hit = true break end
        n = n.Parent
        depth += 1
    end
    if not hit then return false end
    if underCharacter(p) then return false end
    return true
end

local function stillThere(p)
    if not p or not p.Parent or not p:IsDescendantOf(workspace) then return false end
    if p.Transparency >= 1 then return false end
    return true
end

local function promptDead(p)
    for _, d in ipairs(p:GetChildren()) do
        if d:IsA("ProximityPrompt") and d.Enabled == false then return true end
    end
    if p.Parent then
        for _, d in ipairs(p.Parent:GetChildren()) do
            if d:IsA("ProximityPrompt") and d.Enabled == false then return true end
        end
    end
    return false
end
STAGE("basics ok")

--==================== SCAN ====================

local SKIPNAMES = {Terrain = true, Camera = true, Debris = true, Lighting = true}

local function scanCandies()
    local out, queue, qi = {}, {workspace}, 1
    while qi <= #queue do
        local node = queue[qi]; qi += 1
        for _, c in ipairs(node:GetChildren()) do
            if c:IsA("BasePart") then
                if isCandy(c) then out[#out + 1] = c end
            elseif c:IsA("Model") or c:IsA("Folder")
                or c:IsA("Accessory") or c:IsA("Tool") then
                if not (c:IsA("Model") and Players:GetPlayerFromCharacter(c))
                    and not SKIPNAMES[c.Name] then
                    queue[#queue + 1] = c
                end
            end
        end
    end
    return out
end
STAGE("scan ok")

local function pruneTables(now)
    for p, t in pairs(claimedUntil) do
        if not p.Parent or t < now then claimedUntil[p] = nil end
    end
    for p in pairs(attempts) do
        if not p.Parent then attempts[p] = nil end
    end
end

local function validTarget(p, now)
    if not stillThere(p) then return false end
    if not isCandy(p) then return false end
    local c = claimedUntil[p]
    if c and now < c then return false end
    return true
end

--==================== CANDY BALANCE ====================

local candyObj, lastCandyScan = nil, 0

local function findCandyObj(force)
    if candyObj and candyObj.Parent then return candyObj end
    if not force and os.clock() - lastCandyScan < 2 then return nil end
    lastCandyScan = os.clock()
    candyObj = nil
    for _, src in ipairs({LP, RS}) do
        for _, v in ipairs(src:GetDescendants()) do
            if (v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue"))
                and v.Name:lower():find("candy", 1, true) then
                if tonumber(v.Value) then candyObj = v; return v end
            end
        end
    end
    return nil
end

local function getCandyCount()
    local o = findCandyObj()
    if o then return tonumber(o.Value), o:GetFullName() end
    local pg = pgui()
    if pg then
        for _, l in ipairs(pg:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible then
                local n = tonumber((l.Text:gsub("[^%d]", "")))
                if n then
                    local a = l
                    while a and a ~= pg do
                        if a.Name:lower():find("candy", 1, true) then
                            return n, "label:" .. l:GetFullName()
                        end
                        a = a.Parent
                    end
                end
            end
        end
    end
    return STATE.candy, "cached"
end

task.spawn(function()
    while task.wait(1) do
        local c, path = getCandyCount()
        if c then STATE.candy, STATE.candyPath = c, path end
    end
end)
STAGE("balance ok")

--==================== MOVEMENT ====================

local function teleport(char, hrp, cf)
    if not pcall(function() char:PivotTo(cf) end) then
        pcall(function() hrp.CFrame = cf end)
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

local function interact(part)
    local hit = false
    local function try(node)
        if node:IsA("ProximityPrompt") and node.Enabled ~= false then
            hit = true
            if fireproximityprompt then
                pcall(fireproximityprompt, node, node.HoldDuration)
            else
                task.spawn(function()
                    pcall(function()
                        node:InputHoldBegin(); task.wait(node.HoldDuration); node:InputHoldEnd()
                    end)
                end)
            end
        elseif node:IsA("ClickDetector") then
            hit = true
            if fireclickdetector then
                pcall(fireclickdetector, node, node.MaxActivationDistance)
            end
        end
    end
    for _, d in ipairs(part:GetChildren()) do try(d) end
    if not hit and part.Parent then
        for _, d in ipairs(part.Parent:GetChildren()) do
            if d ~= part then try(d) end
        end
    end
    return hit
end

local function engage(target, char, hrp)
    teleport(char, hrp, CFrame.new(target.Position + Vector3.new(0, CONFIG.HoverHeight, 0)))
    task.spawn(function()
        task.wait(0.07)
        if target.Parent then teleport(char, hrp, CFrame.new(target.Position)) end
        interact(target)
    end)
end

local function resolved(part, balBefore)
    if not stillThere(part) then return true end
    if promptDead(part) then return true end
    if balBefore then
        local now = getCandyCount()
        if now and now > balBefore then return true end
    end
    return false
end

local function scheduleVerify(part, char, hrp, balBefore)
    task.spawn(function()
        task.wait(CONFIG.VerifyDelay)
        if resolved(part, balBefore) then
            STATE.collected += 1
            claimedUntil[part] = os.clock() + CONFIG.ClaimCooldown
            return
        end
        local tries = attempts[part] or 1
        if CONFIG.RetryOnMiss and stillThere(part) and tries < CONFIG.MaxAttempts then
            attempts[part] = tries + 1
            STATE.moving = true
            teleport(char, hrp, CFrame.new(part.Position))
            task.wait(CONFIG.VerifyDelay)
            interact(part)
            task.wait(CONFIG.VerifyDelay)
            STATE.moving = false
            if resolved(part, balBefore) then
                STATE.collected += 1
                claimedUntil[part] = os.clock() + CONFIG.ClaimCooldown
                return
            end
        end
        claimedUntil[part] = os.clock() + CONFIG.ClaimCooldown
        STATE.missed += 1
        STATE.log = "stuck: " .. part.Name
    end)
end
STAGE("movement ok")

--==================== FARM LOOP ====================

local function pickTarget(list, hrp, now)
    local best, bestD = nil, math.huge
    for i = 1, #list do
        local p = list[i]
        if validTarget(p, now) then
            if not CONFIG.NearestFirst then return p end
            local d = (p.Position - hrp.Position).Magnitude
            if d < bestD and d <= CONFIG.MaxRange then best, bestD = p, d end
        end
    end
    return best
end

task.spawn(function()
    local list, lastScan, nextHop = {}, 0, 0
    while task.wait() do
        if not STATE.farm then task.wait(0.05) continue end
        local char, _, hrp = getChar()
        if not char then task.wait(0.1) continue end

        local now = os.clock()
        if now - lastScan > CONFIG.RescanTime then
            lastScan = now
            list = scanCandies()
        end
        pruneTables(now)

        local valid = {}
        for i = 1, #list do
            if validTarget(list[i], now) then valid[#valid + 1] = list[i] end
        end
        list = valid

        if now >= nextHop and not STATE.moving then
            local target = pickTarget(list, hrp, now)
            if target and validTarget(target, now) then
                local balBefore = STATE.candy
                attempts[target] = 1
                claimedUntil[target] = now + math.max(CONFIG.HopInterval, 1.05)
                nextHop = now + CONFIG.HopInterval
                engage(target, char, hrp)
                scheduleVerify(target, char, hrp, balBefore)
                STATE.hops += 1
                if CONFIG.Verbose then print("[MM2] hop -> " .. target:GetFullName()) end
            else
                nextHop = now + 0.2
            end
        end
    end
end)
STAGE("farm loop ok")

--==================== REMOTE SPY ====================

local SPY = { installed = false, log = {}, rec = false, seq = {}, armedUntil = 0, selfFire = false }

local function fmtArgs(t)
    local o = {}
    for i = 1, t.n do
        local v = t[i]
        local ty = type(v)
        if ty == "string" then o[i] = '"'..v..'"'
        elseif ty == "number" or ty == "boolean" then o[i] = tostring(v)
        elseif ty == "table" then o[i] = "{tbl}"
        elseif ty == "userdata" and typeof(v) == "Instance" then o[i] = v:GetFullName()
        else o[i] = ty end
    end
    return "(" .. table.concat(o, ", ") .. ")"
end

local function recordRemote(self, args)
    SPY.log[#SPY.log + 1] = {path = self:GetFullName(), args = args, t = os.clock()}
    if #SPY.log > 400 then table.remove(SPY.log, 1) end
    if SPY.rec and not SPY.selfFire and os.clock() < SPY.armedUntil then
        SPY.seq[#SPY.seq + 1] = {path = self:GetFullName(), args = args}
    end
end

local function installSpy()
    if SPY.installed then return true end
    if type(hookfunction) ~= "function" then return false end
    SPY.installed = true
    local a = pcall(function()
        local re = Instance.new("RemoteEvent")
        local origFire = re.FireServer
        hookfunction(origFire, function(self, ...)
            if typeof(self) == "Instance" and self:IsA("RemoteEvent") then
                recordRemote(self, table.pack(...))
            end
            return origFire(self, ...)
        end)
    end)
    local b = pcall(function()
        local rf = Instance.new("RemoteFunction")
        local origInv = rf.InvokeServer
        hookfunction(origInv, function(self, ...)
            if typeof(self) == "Instance" and self:IsA("RemoteFunction") then
                recordRemote(self, table.pack(...))
            end
            return origInv(self, ...)
        end)
    end)
    return a or b
end

local function resolveFromRoot(path)
    if not path or path == "" then return nil end
    local node = game
    for part in string.gmatch(path, "[^%.]+") do
        if part ~= "game" then
            if node == Players and part == "LocalPlayer" then
                node = LP
            else
                node = node and node:FindFirstChild(part)
            end
        end
    end
    return node
end

local function fireRemote(r, ...)
    if not r or not r.Parent then return false end
    SPY.selfFire = true
    local ok2 = pcall(function()
        if r:IsA("RemoteEvent") then r:FireServer(...)
        elseif r:IsA("RemoteFunction") then r:InvokeServer(...) end
    end)
    SPY.selfFire = false
    return ok2
end

local function replaySeq()
    for _, s in ipairs(SPY.seq) do
        local r = resolveFromRoot(s.path)
        if r and r.Parent then
            fireRemote(r, table.unpack(s.args, 1, s.args.n))
        end
        task.wait(0.22)
    end
end
STAGE("spy ok")

--==================== UI AUTOMATION ====================

local function chainVisible(o)
    local pg = pgui()
    local p = o
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return true
end

local function visibleButtons()
    local out = {}
    local pg = pgui(); if not pg then return out end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
            and d.Visible and chainVisible(d.Parent) then
            out[#out + 1] = d
        end
    end
    return out
end

local function buttonLabel(b)
    local t = b.Name
    if b:IsA("TextButton") then t = t .. " | " .. b.Text end
    return t
end

local function fireButton(b)
    if not b or not b.Parent then return false end
    pcall(function() b.Active = true end)
    local function via(sig)
        if not getconnections then return false end
        local n = 0
        pcall(function()
            for _, c in ipairs(getconnections(sig)) do
                if c.Enabled ~= false and c.Function then
                    n += 1
                    pcall(function() c.Function(b) end)
                end
            end
        end)
        return n > 0
    end
    if via(b.MouseButton1Click) then return true end
    if via(b.Activated) then return true end
    if firesignal and pcall(firesignal, b.MouseButton1Click) then return true end
    return pcall(function() b:Activate() end)
end

local function resolvePath(path)
    local node = pgui()
    if not node or not path or path == "" then return nil end
    for part in string.gmatch(path, "[^%.]+") do
        node = node and node:FindFirstChild(part)
    end
    return node
end

local function pathFromPg(o)
    local parts, n, pg = {}, o, pgui()
    while n and n ~= pg do
        table.insert(parts, 1, n.Name)
        n = n.Parent
    end
    return table.concat(parts, ".")
end

local NEGATIVE = {"close", "exit", "back", "settings", "shop", "inventory", "leaderboard"}

local function candidatePriority(b)
    local lbl = buttonLabel(b):lower()
    for _, neg in ipairs(NEGATIVE) do
        if lbl:find(neg, 1, true) then return nil end
    end
    if nameMatches(lbl, {"buy", "purchase", "confirm", "yes", "claim"}) then return 1 end
    if nameMatches(lbl, {"unbox", "open", "hatch", "spin", "roll", "use"}) then return 2 end
    if nameMatches(lbl, {"box", "crate", "halloween", "candy", "ember"}) then return 3 end
    return 4
end

local function buttonSet()
    local s = {}
    for _, b in ipairs(visibleButtons()) do s[b] = true end
    return s
end

local function countSet(s)
    local n = 0
    for _ in pairs(s) do n += 1 end
    return n
end

local BASELINE = {}
local function recapture()
    BASELINE = buttonSet()
    STATE.log = "baseline: " .. countSet(BASELINE)
end

local function newButtonsSince(base)
    local out = {}
    for _, b in ipairs(visibleButtons()) do
        if not base[b] then out[#out + 1] = b end
    end
    return out
end

local function afterOpenCheck(before)
    task.spawn(function()
        task.wait(1.4)
        local after = getCandyCount()
        if before and after and after < before then
            STATE.boxes += 1
            STATE.spent += (before - after)
        end
    end)
end
STAGE("ui automation ok")

--==================== OPEN LOOP ====================

task.spawn(function()
    local lastPress = 0
    while task.wait(0.15) do
        if not STATE.open then continue end
        if os.clock() - lastPress < CONFIG.StepCooldown then continue end

        local bal = getCandyCount()
        if CONFIG.RequireBalance and not STATE.force and bal and bal < CONFIG.BoxCost then
            STATE.log = "balance " .. bal .. "/" .. CONFIG.BoxCost
            continue
        end

        if STATE.mode == "remote" then
            local r = resolveFromRoot(CONFIG.OpenRemote)
            if r then
                fireRemote(r, table.unpack(CONFIG.OpenArgs))
                lastPress = os.clock()
                STATE.log = "fired " .. r.Name
                afterOpenCheck(bal)
            else
                STATE.log = "remote not found"
                task.wait(0.5)
            end

        elseif STATE.mode == "learn" then
            if #SPY.seq == 0 then
                STATE.log = "press Learn, open a box once"
                task.wait(0.4)
            else
                replaySeq()
                lastPress = os.clock()
                STATE.log = "replayed " .. #SPY.seq
                afterOpenCheck(bal)
            end

        else
            local target = CONFIG.PickedButton and resolvePath(CONFIG.PickedButton)
            if target then
                fireButton(target)
                lastPress = os.clock()
                STATE.log = "picked button"
                afterOpenCheck(bal)
            else
                local fresh = newButtonsSince(BASELINE)
                STATE.fresh = #fresh
                if #fresh == 0 then
                    local op
                    for _, b in ipairs(visibleButtons()) do
                        if nameMatches(buttonLabel(b), {"halloween", "event", "crate"}) then
                            op = b
                            break
                        end
                    end
                    if op then
                        fireButton(op); lastPress = os.clock()
                        STATE.log = "opener: " .. op.Name
                        task.wait(0.9)
                    else
                        STATE.log = "no opener found"; task.wait(0.4)
                    end
                else
                    local best, bestP = nil, 99
                    for _, b in ipairs(fresh) do
                        local p = candidatePriority(b)
                        if p and p < bestP then best, bestP = b, p end
                    end
                    if best then
                        fireButton(best); lastPress = os.clock()
                        STATE.log = "depth " .. bestP .. ": " .. best.Name
                        afterOpenCheck(bal)
                        task.wait(1.0)
                    else
                        STATE.log = #fresh .. " fresh, none usable"
                        task.wait(0.5)
                    end
                end
            end
        end
    end
end)
STAGE("open loop ok")

--==================== DIAGNOSTICS ====================

local function dumpNearby()
    local _, _, hrp = getChar()
    local names, total = {}, 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") then
            total += 1
            local s = d.Size
            if math.max(s.X, s.Y, s.Z) <= CONFIG.MaxSize then
                if not hrp or (d.Position - hrp.Position).Magnitude < 400 then
                    names[d.Name] = (names[d.Name] or 0) + 1
                end
            end
        end
    end
    local arr = {}
    for k, v in pairs(names) do arr[#arr + 1] = {k, v} end
    table.sort(arr, function(a, b) return a[2] > b[2] end)
    print("===== SMALL PARTS NEAR YOU (name x count) =====")
    for i = 1, math.min(#arr, 30) do
        print(string.format("  %5d x  %s", arr[i][2], arr[i][1]))
    end
    print("total workspace parts: " .. total)
end

local function selfTest()
    print("=========== MM2 SELF TEST ===========")
    print("executor   : " .. tostring(identifyexecutor and identifyexecutor() or "unknown"))
    print("hookfunction: " .. tostring(type(hookfunction)))
    print("fireprompt : " .. tostring(fireproximityprompt ~= nil))
    print("getconnections: " .. tostring(getconnections ~= nil))
    local char = getChar()
    print("character  : " .. (char and char.Name or "NIL"))
    local c, path = getCandyCount()
    print("candy value: " .. tostring(c) .. "  @ " .. tostring(path))
    local list = scanCandies()
    print("matched    : " .. #list)
    for i = 1, math.min(#list, 12) do
        print("   " .. list[i]:GetFullName())
    end
    dumpNearby()
    print("=====================================")
end

