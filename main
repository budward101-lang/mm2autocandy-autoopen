--=============================================================
--  MM2 • HALLOWEEN 2026  —  CANDY AUTOFARM + AUTO OPEN BOX
--  Keyless LocalScript. Delta / Codex / Wave / Solara / AWP / Krnl / Xeno
--  Keys: RightShift = UI | F1 = Farm | F2 = Auto-Open Box
--=============================================================

local CONFIG = {
    FarmSpeed    = 0.05,   -- seconds between candy pickups (0.05 fast, 0.15 safe)
    HoverHeight  = 0.0,    -- studs above the candy to land on
    RescanTime   = 0.35,   -- how often to rescan workspace for candy
    NameFilter   = {"candy", "coin"},  -- candies replaced coins, so both match
    MaxSize      = 8,      -- ignore parts larger than this (map decorations)
    AutoFarm     = true,
    AutoOpen     = true,
    BoxCost      = 600,    -- 2026 Halloween Box price in candies
    StepCooldown = 0.9,    -- min seconds between GUI presses
    BoxSteps = {
        -- checked top to bottom, first match wins
        { name = "Open Box",          kw = {"open", "unbox", "hatch"}, delay = 1.0 },
        { name = "Buy Box",           kw = {"buy", "purchase"},        delay = 0.8 },
        { name = "Event / Box Panel", kw = {"halloween", "event", "box", "crate"}, delay = 0.8 },
    },
    Keybinds = { UI = Enum.KeyCode.RightShift, Farm = Enum.KeyCode.F1, Open = Enum.KeyCode.F2 },
}

local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local UIS     = game:GetService("UserInputService")
local Tween   = game:GetService("TweenService")
local LP      = Players.LocalPlayer

local STATE = {
    farm = CONFIG.AutoFarm,
    open = CONFIG.AutoOpen,
    collected = 0,
    boxes = 0,
    started = os.clock(),
    candy = nil,
}

--==================== HELPERS ====================

local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return nil end
    return c, h, r
end

local function nameMatches(name, list)
    name = name:lower()
    for _, f in ipairs(list) do
        if name:find(f, 1, true) then return true end
    end
    return false
end

local function isCandy(p)
    if not p:IsA("BasePart") then return false end
    local s = p.Size
    if math.max(s.X, s.Y, s.Z) > CONFIG.MaxSize then return false end
    if not nameMatches(p.Name, CONFIG.NameFilter) then return false end
    local m = p:FindFirstAncestorOfClass("Model")
    if m and Players:GetPlayerFromCharacter(m) then return false end
    return true
end

local function scanCandies()
    local out = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if isCandy(d) then out[#out + 1] = d end
    end
    return out
end

local function grab(part, hrp)
    hrp.CFrame = part.CFrame + Vector3.new(0, CONFIG.HoverHeight, 0)
    hrp.AssemblyLinearVelocity = Vector3.zero
    for _, d in ipairs(part:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            if fireproximityprompt then
                pcall(fireproximityprompt, d, 0)
            else
                pcall(function()
                    d:InputHoldBegin(); task.wait(d.HoldDuration); d:InputHoldEnd()
                end)
            end
        elseif d:IsA("ClickDetector") then
            if fireclickdetector then pcall(fireclickdetector, d) end
        end
    end
end

--==================== CANDY FARM LOOP ====================

task.spawn(function()
    local list, lastScan = {}, 0
    while task.wait() do
        if STATE.farm then
            local _, _, hrp = getChar()
            if hrp then
                local now = os.clock()
                if now - lastScan > CONFIG.RescanTime then
                    lastScan = now
                    list = scanCandies()
                end
                for i = #list, 1, -1 do
                    if not list[i] or not list[i].Parent then table.remove(list, i) end
                end

                local target = list[1]
                if target then
                    grab(target, hrp)
                    task.wait(CONFIG.FarmSpeed)
                    if not target.Parent then STATE.collected += 1 end
                    table.remove(list, 1)
                else
                    task.wait(0.1)
                end
            else
                task.wait(0.2)
            end
        else
            task.wait(0.1)
        end
    end
end)

--==================== GUI READING ====================

local function pgui() return LP:FindFirstChildOfClass("PlayerGui") end

local function chainVisible(o)
    local pg = pgui()
    local p = o
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return true
end

local function visibleButtons()
    local out = {}
    local pg = pgui(); if not pg then return out end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
            and d.Visible and chainVisible(d.Parent) then
            out[#out + 1] = d
        end
    end
    return out
end

local function buttonLabel(b)
    local t = b.Name
    if b:IsA("TextButton") then t = t .. " | " .. b.Text end
    return t
end

local function findButton(kw)
    for _, b in ipairs(visibleButtons()) do
        if nameMatches(buttonLabel(b), kw) then return b end
    end
end

local function press(b)
    if not b then return false end
    pcall(function() b.Active = true end)
    local ok = pcall(function()
        if firesignal then firesignal(b.MouseButton1Click) else b:Activate() end
    end)
    if not ok then pcall(function() b:Activate() end) end
    return true
end

-- candy balance: value object first, then the event GUI counter
local function getCandyCount()
    for _, src in ipairs({LP, RS}) do
        for _, v in ipairs(src:GetDescendants()) do
            if (v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue"))
                and v.Name:lower():find("candy", 1, true) then
                local n = tonumber(v.Value)
                if n then return n end
            end
        end
    end
    local pg = pgui()
    if pg then
        for _, l in ipairs(pg:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible then
                local n = tonumber((l.Text:gsub("[^%d]", "")))
                if n then
                    local anc, hit = l, false
                    while anc and anc ~= pg do
                        if anc.Name:lower():find("candy", 1, true) then hit = true break end
                        anc = anc.Parent
                    end
                    if hit then return n end
                end
            end
        end
    end
    return nil
end

task.spawn(function()
    while task.wait(1) do STATE.candy = getCandyCount() end
end)

--==================== AUTO OPEN BOX LOOP ====================

task.spawn(function()
    local lastStep = 0
    while task.wait(0.2) do
        if STATE.open and (os.clock() - lastStep) > CONFIG.StepCooldown then
            local c = STATE.candy
            local afford = (c == nil) or (c >= CONFIG.BoxCost)
            if afford then
                for _, step in ipairs(CONFIG.BoxSteps) do
                    local b = findButton(step.kw)
                    if b then
                        press(b)
                        if step.name == "Open Box" then STATE.boxes += 1 end
                        lastStep = os.clock()
                        task.wait(step.delay)
                        STATE.candy = getCandyCount()
                        break
                    end
                end
            end
        end
    end
end)

--==================== UI ====================

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end

local gui = new("ScreenGui", {
    Name = "MM2CandyFarm", ResetOnSpawn = false,
    IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, LP:WaitForChild("PlayerGui"))

local main = new("Frame", {
    Name = "Main", Size = UDim2.new(0, 300, 0, 350),
    Position = UDim2.new(0, 20, 0, 80),
    BackgroundColor3 = Color3.fromRGB(20, 16, 28),
    BorderSizePixel = 0, Active = true,
}, gui)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, main)
new("UIStroke", { Color = Color3.fromRGB(255, 140, 40), Thickness = 1.5 }, main)

local header = new("TextLabel", {
    Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Color3.fromRGB(32, 22, 42),
    Text = "  MM2 CANDY FARM", TextColor3 = Color3.fromRGB(255, 170, 70),
    Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left,
    BorderSizePixel = 0,
}, main)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, header)

local body = new("Frame", {
    Size = UDim2.new(1, -20, 1, -44), Position = UDim2.new(0, 10, 0, 40),
    BackgroundTransparency = 1,
}, main)
new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)

local function makeToggle(order, text, getter, setter)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 32), LayoutOrder = order,
        BackgroundColor3 = Color3.fromRGB(35, 28, 45),
        TextColor3 = Color3.fromRGB(235, 235, 235),
        Font = Enum.Font.GothamMedium, TextSize = 14,
        BorderSizePixel = 0, AutoButtonColor = true,
    }, body)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
    local function refresh()
        b.Text = text .. ": " .. (getter() and "ON" or "OFF")
        b.TextColor3 = getter() and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(255, 110, 110)
    end
    b.MouseButton1Click:Connect(function() setter(not getter()); refresh() end)
    refresh()
    return refresh
end

local stats = new("TextLabel", {
    Size = UDim2.new(1, 0, 0, 62), LayoutOrder = 1,
    BackgroundColor3 = Color3.fromRGB(28, 22, 36), BorderSizePixel = 0,
    TextColor3 = Color3.fromRGB(200, 200, 210), Font = Enum.Font.Code,
    TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top, Text = "",
}, body)
new("UICorner", { CornerRadius = UDim.new(0, 6) }, stats)
new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8) }, stats)

makeToggle(2, "Candy Autofarm", function() return STATE.farm end,
    function(v) STATE.farm = v end)
makeToggle(3, "Auto Open Halloween Box", function() return STATE.open end,
    function(v) STATE.open = v end)

local dbg = new("TextButton", {
    Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 4,
    BackgroundColor3 = Color3.fromRGB(45, 35, 58), Text = "Debug: print all GUI buttons",
    TextColor3 = Color3.fromRGB(220, 220, 230), Font = Enum.Font.GothamMedium,
    TextSize = 13, BorderSizePixel = 0,
}, body)
new("UICorner", { CornerRadius = UDim.new(0, 6) }, dbg)

local hide = new("TextButton", {
    Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 5,
    BackgroundColor3 = Color3.fromRGB(60, 30, 30), Text = "Hide (RightShift to reopen)",
    TextColor3 = Color3.fromRGB(255, 200, 200), Font = Enum.Font.GothamMedium,
    TextSize = 13, BorderSizePixel = 0,
}, body)
new("UICorner", { CornerRadius = UDim.new(0, 6) }, hide)

dbg.MouseButton1Click:Connect(function()
    print("===== VISIBLE GUI BUTTONS =====")
    for _, b in ipairs(visibleButtons()) do
        print(b:GetFullName(), "=>", buttonLabel(b))
    end
end)

-- drag
do
    local dragging, startPos, startInput
    header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; startInput = i.Position; startPos = main.Position
        end
    end)
    header.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startInput
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

hide.MouseButton1Click:Connect(function() main.Visible = false end)

-- stat ticker
task.spawn(function()
    while task.wait(0.3) do
        local run = os.clock() - STATE.started
        local rate = STATE.collected / math.max(run / 3600, 0.0001)
        stats.Text = string.format(
            "candy picked : %d\nrun time     : %02d:%02d\npickups/hour : %.0f\nboxes opened : %d\nbalance      : %s",
            STATE.collected, math.floor(run / 60), math.floor(run % 60),
            rate, STATE.boxes,
            STATE.candy and tostring(STATE.candy) or "unknown")
    end
end)

-- keybinds
UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == CONFIG.Keybinds.UI then
        main.Visible = not main.Visible
    elseif i.KeyCode == CONFIG.Keybinds.Farm then
        STATE.farm = not STATE.farm
    elseif i.KeyCode == CONFIG.Keybinds.Open then
        STATE.open = not STATE.open
    end
end)

print("[MM2 Candy Farm] loaded — RightShift UI | F1 farm | F2 auto-open")
