-- ============================================================
--  MM2 HALLOWEEN 2026 - CANDY AUTOFARM        (by Venice)
--  Features:
--    * Auto Farm Candy  (tweens to candy at 25 studs/sec)
--    * Noclip           (walk through walls to reach candy)
--    * Auto Open Box    (spams the Halloween Box '26 remote)
--    * Tween speed box  (default 25, editable live)
--  RightShift = hide/show panel
-- ============================================================

print("[MM2] loading...")

local function svc(n)
    local ok, s = pcall(function() return game:GetService(n) end)
    return ok and s or nil
end

local Players   = svc("Players")
local Tween     = svc("TweenService")
local RS        = svc("ReplicatedStorage")
local UIS       = svc("UserInputService")
local VIM       = svc("VirtualInputManager")
local VU        = svc("VirtualUser")

local LP = Players.LocalPlayer
local PG = LP:WaitForChild("PlayerGui")

local sp = (task and task.spawn) or function(fn) coroutine.wrap(fn)() end
local w  = (task and task.wait)  or wait

-- ============================================================
--  CONFIG
-- ============================================================
local CFG = {
    speed    = 25,      -- studs per second
    range    = 6000,
    cooldown = 1.5,
    cost     = 600,     -- candy per box
    farm     = true,
    noclip   = true,
    box      = true,
    antiafk  = true,
}

local STATE = "starting"
local collected = 0
local char, hrp

-- ============================================================
--  GUI SHELL (built first, always visible)
-- ============================================================
local gui = Instance.new("ScreenGui")
gui.Name = "MM2CandyFarm"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
pcall(function() gui.Parent = PG end)
if not gui.Parent then pcall(function() gui.Parent = svc("CoreGui") end) end
print("[MM2] gui parent =", tostring(gui.Parent))

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 230, 0, 300)
frame.Position = UDim2.new(0, 12, 0, 90)
frame.BackgroundColor3 = Color3.fromRGB(22, 20, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local stroke = Instance.new("UIStroke", frame)
stroke.Color = Color3.fromRGB(255, 140, 0)
stroke.Thickness = 1.5

local lay = Instance.new("UIListLayout", frame)
lay.Padding = UDim.new(0, 5)
lay.SortOrder = Enum.SortOrder.LayoutOrder
lay.HorizontalAlignment = Enum.HorizontalAlignment.Center

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 26)
title.BackgroundTransparency = 1
title.Text = "MM2 CANDY AUTOFARM"
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.TextColor3 = Color3.fromRGB(255, 160, 40)
title.LayoutOrder = 0
title.Parent = frame

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -16, 0, 52)
status.BackgroundTransparency = 1
status.Text = "booting..."
status.TextWrapped = true
status.Font = Enum.Font.Gotham
status.TextSize = 11
status.TextColor3 = Color3.fromRGB(165, 165, 180)
status.LayoutOrder = 99
status.Parent = frame

local function setStatus(s) status.Text = tostring(s) end

local banner = Instance.new("TextLabel")
banner.Size = UDim2.new(0, 240, 0, 30)
banner.Position = UDim2.new(0, 12, 0, 52)
banner.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
banner.Text = "LOADED"
banner.Font = Enum.Font.GothamBold
banner.TextSize = 13
banner.TextColor3 = Color3.fromRGB(20, 20, 20)
banner.Parent = gui
Instance.new("UICorner", banner).CornerRadius = UDim.new(0, 8)
task.delay(4, function() pcall(function() banner:Destroy() end) end)

local mini = Instance.new("TextButton")
mini.Size = UDim2.new(0, 56, 0, 26)
mini.Position = UDim2.new(0, 12, 0, 20)
mini.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
mini.Text = "MM2"
mini.Font = Enum.Font.GothamBold
mini.TextSize = 13
mini.TextColor3 = Color3.fromRGB(20, 20, 20)
mini.Visible = false
mini.Parent = gui
Instance.new("UICorner", mini).CornerRadius = UDim.new(0, 6)
mini.MouseButton1Click:Connect(function()
    frame.Visible = true
    mini.Visible = false
end)

if UIS then
    UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.RightShift then
            frame.Visible = not frame.Visible
            mini.Visible = not frame.Visible
        end
    end)
end

print("[MM2] ui built")

-- ============================================================
--  LOGIC
-- ============================================================
local ok, err = xpcall(function()

    -- ---------- character ----------
    local function bind(c)
        char = c
        hrp = c:WaitForChild("HumanoidRootPart", 15)
        print("[MM2] character bound")
    end
    if LP.Character then bind(LP.Character) end
    LP.CharacterAdded:Connect(bind)

    -- ---------- noclip ----------
    local saved, active = {}, false
    sp(function()
        while true do
            if CFG.noclip then
                if char then
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then
                            if saved[p] == nil then saved[p] = p.CanCollide end
                            p.CanCollide = false
                        end
                    end
                end
                active = true
            elseif active then
                if char then
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") and saved[p] ~= nil then
                            p.CanCollide = saved[p]
                        end
                    end
                end
                saved, active = {}, false
            end
            w(0.1)
        end
    end)

    -- ---------- candy ----------
    local function candyList()
        local out = {}
        for _, o in ipairs(workspace:GetChildren()) do
            local c = o:FindFirstChild("CoinContainer") or o:FindFirstChild("CandyContainer")
            if c then
                for _, i in ipairs(c:GetChildren()) do
                    local p = i
                    if i:IsA("Model") then
                        p = i:FindFirstChild("CoinVisual")
                            or i:FindFirstChild("CandyVisual")
                            or i:FindFirstChildWhichIsA("BasePart")
                    end
                    if p and p:IsA("BasePart") and p.Parent then
                        table.insert(out, p)
                    end
                end
            end
        end
        return out
    end

    local function grab(part)
        if not hrp or not part or not part.Parent then return end
        pcall(function() hrp.CFrame = CFrame.new(part.Position) end)
        if typeof(firetouchinterest) == "function" then
            pcall(function()
                firetouchinterest(hrp, part, 0)
                firetouchinterest(hrp, part, 1)
            end)
            if part.Parent then
                pcall(function()
                    firetouchinterest(hrp, part.Parent, 0)
                    firetouchinterest(hrp, part.Parent, 1)
                end)
            end
        end
    end

    local function farm()
        while CFG.farm do
            if hrp and hrp.Parent then
                local best, bd
                for _, p in ipairs(candyList()) do
                    local d = (hrp.Position - p.Position).Magnitude
                    if d <= CFG.range and (not bd or d < bd) then
                        best, bd = p, d
                    end
                end

                if best then
                    STATE = string.format("farming (%.0f studs)", bd)
                    local dur = math.max(bd / math.max(CFG.speed, 1), 0.05)
                    local tw = Tween:Create(
                        hrp,
                        TweenInfo.new(dur, Enum.EasingStyle.Linear),
                        { CFrame = CFrame.new(best.Position) }
                    )
                    tw:Play()

                    local t0 = os.clock()
                    while CFG.farm
                        and best.Parent
                        and tw.PlaybackState == Enum.PlaybackState.Playing
                        and (os.clock() - t0) < dur + 2 do
                        w()
                    end
                    if tw.PlaybackState == Enum.PlaybackState.Playing then tw:Cancel() end

                    grab(best)
                    collected = collected + 1
                    w(0.05)
                else
                    STATE = "no candy (in lobby?)"
                    w(0.25)
                end
            else
                STATE = "waiting for character"
                w(0.3)
            end
        end
        STATE = "farm off"
    end

    -- ---------- box ----------
    local remotes
    local function getRemotes()
        if remotes then return remotes end
        remotes = {}
        if not RS then return remotes end

        local folder = RS:FindFirstChild("Remotes")
        if folder then
            local r = folder:FindFirstChild("BoxOpened")
            if r and r:IsA("RemoteEvent") then table.insert(remotes, r) end
        end

        for _, v in ipairs(RS:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = string.lower(v.Name)
                if (string.find(n, "box") or string.find(n, "crate") or string.find(n, "unbox"))
                    and not table.find(remotes, v) then
                    table.insert(remotes, v)
                end
            end
        end
        return remotes
    end

    local function clickOpen()
        if not VIM then return end
        for _, d in ipairs(PG:GetDescendants()) do
            if d:IsA("TextButton") and d.Visible and d.AbsoluteSize.Magnitude > 0 then
                local t = string.lower(d.Text)
                if string.find(t, "open") or string.find(t, "unbox") then
                    local c = d.AbsolutePosition + d.AbsoluteSize / 2
                    pcall(function()
                        VIM:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0)
                        w(0.03)
                        VIM:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
                    end)
                end
            end
        end
    end

    local function prompts()
        for _, d in ipairs(workspace:GetDescendants()) do
            local n = string.lower(d.Name)
            if string.find(n, "box") or string.find(n, "crate") then
                if d:IsA("ProximityPrompt") then
                    pcall(function() fireproximityprompt(d) end)
                elseif d:IsA("ClickDetector") then
                    pcall(function() fireclickdetector(d) end)
                end
            end
        end
    end

    local function candyCount()
        for k, v in pairs(LP:GetAttributes()) do
            if type(v) == "number" and string.find(string.lower(k), "candy") then return v end
        end
        for _, d in ipairs(LP:GetDescendants()) do
            if (d:IsA("IntValue") or d:IsA("NumberValue"))
                and string.find(string.lower(d.Name), "candy") then return d.Value end
        end
        return nil
    end

    local function openBox()
        local r = getRemotes()
        if #r > 0 then
            for _, ev in ipairs(r) do pcall(function() ev:FireServer() end) end
        else
            clickOpen()
            prompts()
        end
    end

    local function boxLoop()
        local last = 0
        while CFG.box do
            if os.clock() - last >= CFG.cooldown then
                local n = candyCount()
                if n == nil or n >= CFG.cost then
                    openBox()
                    last = os.clock()
                end
            end
            w(0.1)
        end
    end

    -- ---------- anti afk ----------
    if CFG.antiafk then
        LP.Idled:Connect(function()
            if VU then
                pcall(function()
                    VU:CaptureController()
                    VU:ClickButton2(Vector2.new())
                end)
            elseif VIM then
                pcall(function()
                    VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end)
            end
        end)
    end

    -- ---------- controls ----------
    local function toggle(name, order, get, set)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -16, 0, 30)
        b.LayoutOrder = order
        b.BackgroundColor3 = get() and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(40, 38, 50)
        b.Text = name .. (get() and ": ON" or ": OFF")
        b.TextColor3 = Color3.fromRGB(210, 210, 220)
        b.Font = Enum.Font.GothamMedium
        b.TextSize = 12
        b.Parent = frame
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
        b.MouseButton1Click:Connect(function()
            set(not get())
            local on = get()
            b.Text = name .. (on and ": ON" or ": OFF")
            b.BackgroundColor3 = on and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(40, 38, 50)
        end)
    end

    toggle("Auto Farm Candy", 1, function() return CFG.farm end,
        function(v) CFG.farm = v; if v then sp(farm) end end)
    toggle("Noclip", 2, function() return CFG.noclip end, function(v) CFG.noclip = v end)
    toggle("Auto Open Box", 3, function() return CFG.box end, function(v) CFG.box = v end)

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -16, 0, 30)
    row.BackgroundColor3 = Color3.fromRGB(40, 38, 50)
    row.LayoutOrder = 4
    row.Parent = frame
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)

    local rl = Instance.new("TextLabel")
    rl.Size = UDim2.new(0.6, 0, 1, 0)
    rl.Position = UDim2.new(0, 10, 0, 0)
    rl.BackgroundTransparency = 1
    rl.Text = "Tween speed"
    rl.TextXAlignment = Enum.TextXAlignment.Left
    rl.TextColor3 = Color3.fromRGB(210, 210, 220)
    rl.Font = Enum.Font.GothamMedium
    rl.TextSize = 12
    rl.Parent = row

    local sb = Instance.new("TextBox")
    sb.Size = UDim2.new(0.3, 0, 0.7, 0)
    sb.Position = UDim2.new(0.66, 0, 0.15, 0)
    sb.BackgroundColor3 = Color3.fromRGB(25, 24, 32)
    sb.Text = tostring(CFG.speed)
    sb.TextColor3 = Color3.fromRGB(255, 160, 40)
    sb.Font = Enum.Font.GothamBold
    sb.TextSize = 12
    sb.Parent = row
    Instance.new("UICorner", sb).CornerRadius = UDim.new(0, 6)
    sb.FocusLost:Connect(function()
        local n = tonumber(sb.Text)
        if n and n > 0 then CFG.speed = n end
        sb.Text = tostring(CFG.speed)
    end)

    -- ---------- status ----------
    sp(function()
        while true do
            local n = candyCount()
            setStatus(string.format(
                "state: %s\ncollected: %d  |  candy: %s  |  speed: %d",
                STATE, collected, n and tostring(n) or "?", CFG.speed))
            w(0.4)
        end
    end)

    sp(farm)
    sp(boxLoop)
    print("[MM2] started")

end, function(e)
    return tostring(e) .. "\n" .. debug.traceback()
end)

if not ok then
    setStatus("ERROR:\n" .. err)
    print("[MM2] ERROR:", err)
else
    setStatus("running")
end
