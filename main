--==================== CANDY ====================
-- Candies spawn in place of Coins during rounds; collected by touch.
-- Detection is attribute-first so decorations named "candy"/"coin" don't get targeted.

local function candyAttr(d)
	local id = d:GetAttribute("CoinID")
	if id ~= nil then
		return tostring(id):lower():find("candy", 1, true) ~= nil
	end
	return nil
end

local function tagHasCandy(d)
	for _, t in ipairs(CS:GetTags(d)) do
		local tl = t:lower()
		if tl:find("candy", 1, true) or tl:find("coin", 1, true) then return true end
	end
	return false
end

local function isCandy(d)
if not d:IsA("BasePart") then return false end
	local m = d:FindFirstAncestorOfClass("Model")
	if m and P:GetPlayerFromCharacter(m) then return false end
	local id = d:GetAttribute("CoinID")
	if id then return id == "Candy" end
	local n = d.Name:lower()
	if not (n:find("candy", 1, true) or n:find("coin", 1, true)) then return false end
local s = d.Size
if math.max(s.X, s.Y, s.Z) > CFG.MaxSize then return false end

	local attr = candyAttr(d)
	if attr ~= nil then return attr end       -- authoritative when the game sets it
	if tagHasCandy(d) then return true end
	local n = d.Name:lower()
	return n:find("candy", 1, true) ~= nil or n:find("coin", 1, true) ~= nil
end

-- find the folder/model that actually holds the candies (don't scan all of workspace)
local scopeCache, scopeAt
local function candyScope()
	if scopeCache and scopeCache.Parent and os.clock() - scopeAt < 5 then
		return scopeCache
	end
	local best, bestN
	for _, d in ipairs(workspace:GetChildren()) do
		if d:IsA("Folder") or d:IsA("Model") then
			local n = 0
			for _, x in ipairs(d:GetDescendants()) do
				if x:IsA("BasePart") and x:GetAttribute("CoinID") ~= nil then n = n + 1 end
			end
			if n > 0 and (not bestN or n > bestN) then best, bestN = d, n end
		end
	end
	scopeCache, scopeAt = best or workspace, os.clock()
	return scopeCache
	local m = d:FindFirstAncestorOfClass("Model")
	if m and P:GetPlayerFromCharacter(m) then return false end
	return true
end

local function scanCandy()
	local scope = candyScope()
local function findCandy()
	local scope = workspace:FindFirstChild("CoinContainer", true) or workspace
local out = {}
for _, d in ipairs(scope:GetDescendants()) do
if isCandy(d) then out[#out + 1] = d end
end
	if #out < 3 then return out end

	-- reject vertical outliers (skybox / props floating way above the pickups)
	local ys = {}
	for i, c in ipairs(out) do ys[i] = c.Position.Y end
	table.sort(ys)
	local medY = ys[math.max(1, math.ceil(#ys / 2))]
	local keep = {}
	for _, c in ipairs(out) do
		local dy = c.Position.Y - medY
		if dy <= CFG.MaxRise and dy >= -CFG.MaxRise then keep[#keep + 1] = c end
	end
	return keep
end

-- throttled scan + drop dead refs
local list, listAt = {}, 0
local function candies()
	if os.clock() - listAt > CFG.ScanRate then
		list, listAt = scanCandy(), os.clock()
	end
	local live = {}
	for _, c in ipairs(list) do if c.Parent then live[#live + 1] = c end end
	list = live
	return live
	return out
end

--==================== MOVEMENT ====================
-- noclip means nothing supports the character, so we pin it while parked.

RUN.RenderStepped:Connect(function()
	if not farmOn or moving or not holdCF then return end
	local hrp = getHRP()
	if not hrp then return end
	hrp.CFrame = holdCF
	hrp.AssemblyLinearVelocity  = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
end)

-- tween onto the candy, park, then nudge so the touch always lands
local function grab(part, hrp)
	moving = true

local dist = (part.Position - hrp.Position).Magnitude
	local dest = CFrame.new(part.Position)

	if dist > CFG.SnapBeyond then
		hrp.CFrame = dest                                  -- too far to tween slowly
	else
		local dur = math.clamp(dist / CFG.Tween, 0.05, CFG.MaxTween)
		local tw = TS:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = dest })
		tw:Play()
		local t0 = os.clock()
		repeat RUN.RenderStepped:Wait() until os.clock() - t0 >= dur
	end
	local tw = TS:Create(hrp,
		TweenInfo.new(math.max(dist / CFG.Tween, 0.04), Enum.EasingStyle.Linear),
		{ CFrame = CFrame.new(part.Position) })
	tw:Play()
	tw.Completed:Wait()

	if not part.Parent then                                -- candy got taken mid-flight
		holdCF = hrp.CFrame
		moving = false
		return false
	end

	-- nudge to force the Touched, then settle
	hrp.CFrame = part.CFrame * CFrame.new(0, 0.8, 0)
	task.wait(0.03)
	hrp.CFrame = part.CFrame
	hrp.AssemblyLinearVelocity  = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	holdCF = hrp.CFrame
	if not part.Parent then return end
task.wait(CFG.Hold)
	if part.Parent then
		hrp.CFrame = part.CFrame * CFrame.new(0, 0.8, 0)
		task.wait(0.03)
		hrp.CFrame = part.CFrame
	end

for _, x in ipairs(part:GetDescendants()) do
if x:IsA("ProximityPrompt") then
