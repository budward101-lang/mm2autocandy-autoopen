local CFG = {
	Tween         = 25,                 -- studs per second
	Hold          = 0.10,               -- seconds parked on a candy
	MaxSize       = 8,                  -- ignore map parts bigger than this
	AntiAFK       = true,
	Mode          = "Remote",           -- Remote | GUI
	Crate         = "Halloween2026Box", -- arg 1 (captured from OpenCrate)
	BoxType       = "MysteryBox",       -- arg 2
	Pay           = "Candies2026",      -- arg 3 (currency)
	-- collection tuning
	MaxTween      = 1.2,                -- seconds, hard cap on one tween
	SnapBeyond    = 250,                -- studs; farther than this = teleport instead of tween
	MaxRise       = 80,                 -- reject parts this far above the candy median (skybox)
	VoidDrop      = 120,                -- if we fall this far below the candies, snap back
	ScanRate      = 0.20,               -- seconds between full scans
	Tween     = 25,                 -- studs per second
	Hold      = 0.10,               -- seconds parked on a candy
	MaxSize   = 8,                  -- ignore map parts bigger than this
	AntiAFK   = true,
	Mode      = "Remote",           -- Remote | GUI
	Crate     = "Halloween2026Box", -- arg 1 (captured from OpenCrate)
	BoxType   = "MysteryBox",       -- arg 2
	Pay       = "Candies2026",      -- arg 3 (currency)
}

