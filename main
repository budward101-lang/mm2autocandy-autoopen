-- find the horizontal row of event-preview tiles (5+ equal tiles in a row, lower half of screen)
local function findPreviewTiles()
    local byParent = {}
    for _, b in ipairs(visibleButtons()) do
        local p = b.Parent
        if p then
            local g = byParent[p]
            if not g then g = {}; byParent[p] = g end
            g[#g + 1] = b
        end
    end

    local vh = viewportY()
    local best, bestN = nil, 0
    for _, list in pairs(byParent) do
        if #list >= 5 then
            local row = {}
            local refY, refH, refW = list[1].AbsolutePosition.Y,
                list[1].AbsoluteSize.Y, list[1].AbsoluteSize.X
            for _, b in ipairs(list) do
                if math.abs(b.AbsolutePosition.Y - refY) < 24
                    and math.abs(b.AbsoluteSize.Y - refH) < 24
                    and math.abs(b.AbsoluteSize.X - refW) < 24 then
                    row[#row + 1] = b
                end
            end
            if #row >= 5 then
                local avgY = 0
                for _, b in ipairs(row) do avgY += b.AbsolutePosition.Y end
                avgY /= #row
                if avgY > vh * 0.5 and #row > bestN then
                    best, bestN = row, #row
                end
            end
        end
    end
    if not best then return {} end
    table.sort(best, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
    return best
end

-- open the EVENT tab -> click the Nth preview tile -> return the unbox button if one appears
local function reachBoxPage()
    -- 1) open the event preview
    local tiles = findPreviewTiles()
    if #tiles < CONFIG.EventPreviewIndex then
        local ev = findIn(visibleButtons(), CONFIG.EventTabKeywords)
        if not ev then return nil, "no EVENT tab" end
        fireButton(ev)
        STATE.log = "event tab: " .. ev.Name
        local t0 = os.clock()
        repeat
            task.wait(0.15)
            tiles = findPreviewTiles()
        until #tiles >= CONFIG.EventPreviewIndex or os.clock() - t0 > 3
    end
-- the whole balance/unbox path: EVENT tab -> 4th event icon (chest)
local function openEventChest()
    local ev = findEventTab()
    if not ev then return nil, "no EVENT button" end
    fireButton(ev)
    STATE.log = "event tab: " .. ev.Name
    task.wait(jit(1.0))

    if #tiles < CONFIG.EventPreviewIndex then
        return nil, "event preview not found (" .. #tiles .. " tiles)"
    local icons = eventIcons()
    if #icons < CONFIG.EventPreviewIndex then
        return nil, "event icons not found (" .. #icons .. ")"
end

    -- 2) click the configured tile (the box)
    local tile = tiles[CONFIG.EventPreviewIndex]
    fireButton(tile)
    STATE.log = "preview tile #" .. CONFIG.EventPreviewIndex .. ": " .. tile.Name

    return waitForUnbox(2.0) or true
    local icon = icons[CONFIG.EventPreviewIndex]
    fireButton(icon)
    STATE.log = "chest icon #" .. CONFIG.EventPreviewIndex .. ": " .. icon.Name
    task.wait(jit(1.0))
    return icon
end

