--============================================================
-- MM2 HALLOWEEN - Candy Autofarm + Halloween Box Opener
-- Noclip | TweenSpeed 25 | core APIs only
-- RightShift = hide UI | F1 = farm | F2 = box | F3 = reset
--============================================================

local CFG = {
    Tween = 25, -- studs per second
    Hold = 0.05, -- settle on a candy
    Revisit = 2.5, -- secs before a candy can be picked again
    Radius = 120, -- outer pick range
    BandMin = 20, -- preferred pick band: min studs
    BandMax = 40, -- preferred pick band: max studs
    MaxSize = 8, -- ignore map parts bigger than this
    AntiAFK = true,
    Mode = "Remote", -- Remote | GUI
    Crate = "Halloween2026Box", -- arg 1 (captured from OpenCrate)
    BoxType = "MysteryBox", -- arg 2
    Pay = "Candies2026", -- arg 3 (currency)

    -- full bag handling
    AutoReset = true, -- reset character when the bag is full
    BagSize = 0, -- 0 = auto detect. Set to your bag cap (e.g. 50) to force it
    UseBagGui = true, -- read the counter off attributes / values / GUI
    MinCap = 5, -- ignore x/y labels whose capacity is smaller than this
    FailLimit = 10, -- last-resort: consecutive dead picks = bag full
    MinPicks = 3, -- must bank this many since last reset before fails count
    Settle = 0.8, -- grace after respawn before farming again
    RoundGrace = 3, -- secs of no candies before a round counts as over
    Stall = 10, -- secs of no grabs = clear targets and retarget
    TweenSlack = 1.5, -- extra secs before a glide is declared stuck
}

local P = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TS = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local RUN = game:GetService("RunService")
local VU = game:GetService("VirtualUser")
local lp = P.LocalPlayer

local farmOn, picked, boxes = true, 0, 0
local lastRarity = "-"
local started = os.clock()
local status

-- resolved once, hardcoded path (findRemotes() order is not stable)
local Shop = RS:WaitForChild("Remotes"):WaitForChild("Shop")
local OpenCrate = Shop:WaitForChild("OpenCrate")

--==================== SAFE LOOP ====================
-- a bare while-loop dies silently on any error. this restarts it.
local function safeLoop(name, step)
    task.spawn(function()
        while true do
            local ok, err = pcall(step)
            if not ok then
                print(("[MM2] %s loop error: %s"):format(name, tostring(err)))
                task.wait(0.25)
            end
        end
    end)
end

--==================== BUILD UI ====================
local function new(c, props, parent)
    local o = Instance.new(c)
    for k, v in pairs(props) do pcall(function() o[k] = v end) end
    o.Parent = parent
    return o
end

