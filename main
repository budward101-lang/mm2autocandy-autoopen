local function say(s) status.Text = tostring(s) end

--==================== DRAG + KEYS ====================
do
	local drag, from, origin
	head.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then
			drag, from, origin = true, i.Position, win.Position
		end
	end)
	head.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then drag = false end
	end)
	UIS.InputChanged:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - from
			win.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X,
			                         origin.Y.Scale, origin.Y.Offset + d.Y)
		end
	end)
	UIS.InputBegan:Connect(function(i, gp)
		if gp then return end
		if i.KeyCode == Enum.KeyCode.RightShift then
			win.Visible = not win.Visible
		elseif i.KeyCode == Enum.KeyCode.F1 then
			farmBtn.MouseButton1Click:Fire()
		elseif i.KeyCode == Enum.KeyCode.F2 then
			boxBtn.MouseButton1Click:Fire()
		end
	end)
end

hideBtn.MouseButton1Click:Connect(function() win.Visible = false end)

--==================== NOCLIP + HOVER ====================
local function noclipChar(ch)
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.CanCollide then d.CanCollide = false end
			d.Massless = true
		end
	end
end

local function hookChar(ch)
	noclipChar(ch)
	ch.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			task.spawn(function()
				task.wait(0.05)
				if d.Parent then d.CanCollide = false; d.Massless = true end
			end)
		end
	end)
end

if lp.Character then hookChar(lp.Character) end
lp.CharacterAdded:Connect(function(ch)
	task.wait(0.2)
	hookChar(ch)
end)

task.spawn(function()
	while task.wait(0.2) do
		local ch = lp.Character
		if ch then noclipChar(ch) end
	end
end)

RUN.Stepped:Connect(function()
	if not farmOn then return end
	local ch = lp.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
end)

--==================== CANDY ====================
local function isCandy(d)
	if not d:IsA("BasePart") then return false end
	local id = d:GetAttribute("CoinID")
	if id then return id == "Candy" end
	local n = d.Name:lower()
	if not (n:find("candy", 1, true) or n:find("coin", 1, true)) then return false end
	local s = d.Size
	if math.max(s.X, s.Y, s.Z) > CFG.MaxSize then return false end
	local m = d:FindFirstAncestorOfClass("Model")
	if m and P:GetPlayerFromCharacter(m) then return false end
	return true
end

local scopeCache
local function candyScope()
	if scopeCache and scopeCache.Parent then return scopeCache end
	scopeCache = workspace:FindFirstChild("CoinContainer", true) or workspace
	return scopeCache
end

local function findCandy()
	local out = {}
	for _, d in ipairs(candyScope():GetDescendants()) do
		if isCandy(d) then out[#out + 1] = d end
	end
	return out
end

local failed = {}

local function glideTo(part, hrp)
	local dist = (part.Position - hrp.Position).Magnitude
	local dur = dist / CFG.Tween
	if dur < 0.02 then dur = 0.02 end

	local tw = TS:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = CFrame.new(part.Position) })
	tw:Play()
	tw.Completed:Wait()

	if CFG.Hold > 0 then task.wait(CFG.Hold) end
	if not part.Parent then return end

	for _, x in ipairs(part:GetDescendants()) do
		if x:IsA("ProximityPrompt") then
			pcall(function()
				if fireproximityprompt then fireproximityprompt(x)
				else x:InputHoldBegin(); task.wait(x.HoldDuration); x:InputHoldEnd() end
			end)
		elseif x:IsA("ClickDetector") and fireclickdetector then
			pcall(fireclickdetector, x)
		end
	end
end

local function farmStep()
	local ch = lp.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local now = os.clock()
	local best, bd
	for _, c in ipairs(findCandy()) do
		local f = failed[c]
		if not (f and f.until > now) then
			local d = (c.Position - hrp.Position).Magnitude
			if not bd or d < bd then best, bd = c, d end
		end
	end

	if not best then
		say("no candies - hovering")
		return
	end

	local ok, err = pcall(glideTo, best, hrp)
	if not ok then
		say("glide error: " .. tostring(err))
	elseif best.Parent == nil then
		picked = picked + 1
		failed[best] = nil
	else
		local f = failed[best] or { count = 0, until = 0 }
		f.count = f.count + 1
		if f.count >= 3 then f.until = os.clock() + 8; f.count = 0 end
		failed[best] = f
	end
end

task.spawn(function()
	while task.wait() do
		if farmOn then farmStep() end
	end
end)

--==================== BOX ====================
local openCrateRemote
local function getOpenCrate()
	if openCrateRemote and openCrateRemote.Parent then return openCrateRemote end
	local remotes = RS:FindFirstChild("Remotes")
	local shop = remotes and remotes:FindFirstChild("Shop")
	openCrateRemote = shop and shop:FindFirstChild("OpenCrate")
	return openCrateRemote
end

local function visibleButtons()
	local out = {}
	local p = lp:FindFirstChildOfClass("PlayerGui")
	if not p then return out end
	for _, d in ipairs(p:GetDescendants()) do
		if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then out[#out + 1] = d end
	end
	return out
end

local function clickKeyword(kws)
	for _, b in ipairs(visibleButtons()) do
		local label = b.Name .. " "
		if b:IsA("TextButton") then label = label .. b.Text end
		label = label:lower()
		for _, k in ipairs(kws) do
			if label:find(k, 1, true) then
				pcall(function()
					if firesignal then firesignal(b.MouseButton1Click) else b:Activate() end
				end)
				return b
			end
		end
	end
	return nil
end

local function openBox()
	if CFG.Mode == "Remote" then
		local remote = getOpenCrate()
		if not remote then return "no Remotes.Shop.OpenCrate found" end
		local ok, result = pcall(function()
			return remote:InvokeServer(CFG.Crate, CFG.BoxType, CFG.Pay)
		end)
		if not ok then return "invoke errored: " .. tostring(result) end
		if type(result) == "table" then
			boxes = boxes + 1
			lastRarity = tostring(result.Rarity or "?")
			return "opened - rarity: " .. lastRarity
		end
		return "returned " .. tostring(result) .. " (nil = check " .. CFG.Pay .. ")"
	else
		local b = clickKeyword({ "open", "unbox", "box", "crate", "halloween" })
		if b then boxes = boxes + 1; return "clicked " .. b.Name end
		return "no matching button on screen"
	end
end

--==================== BUTTONS ====================
farmBtn.MouseButton1Click:Connect(function()
	farmOn = not farmOn
	setState(farmBtn, farmOn, farmOn and "Farm Candy: ON" or "Farm Candy", C.green)
	dot.BackgroundColor3 = farmOn and C.green or C.dim
	say(farmOn and ("gliding at " .. CFG.Tween .. " studs/s") or "farm stopped")
end)

boxBtn.MouseButton1Click:Connect(function()
	local msg = openBox()
	say(msg)
	print("[MM2] " .. msg)
end)

autoBtn.MouseButton1Click:Connect(function()
	autoBox = not autoBox
	setState(autoBtn, autoBox, autoBox and "Auto: ON" or "Auto Box", C.accent2)
	say(autoBox and ("auto-opening every " .. CFG.AutoBoxEvery .. "s") or "auto box off")
end)

modeBtn.MouseButton1Click:Connect(function()
	CFG.Mode = (CFG.Mode == "Remote") and "GUI" or "Remote"
	state[modeBtn].label.Text = "Mode: " .. CFG.Mode
	say("box mode = " .. CFG.Mode)
end)

scanBtn.MouseButton1Click:Connect(function()
	local remotes = RS:FindFirstChild("Remotes")
	local shop = remotes and remotes:FindFirstChild("Shop")
	print("===== SHOP REMOTES =====")
	if shop then
		for _, x in ipairs(shop:GetChildren()) do print(x.ClassName, x:GetFullName()) end
	else
		print("no Remotes.Shop")
	end
	print("===== VISIBLE GUI BUTTONS =====")
	local b = visibleButtons()
	for i, x in ipairs(b) do print(i, x:GetFullName(), x:IsA("TextButton") and x.Text or "") end
	if #b == 0 then print("none") end
	say("scan done - check console")
end)

resetBtn.MouseButton1Click:Connect(function()
	picked, boxes, lastRarity, started = 0, 0, "-", os.clock()
	say("stats reset")
end)

speedDown.MouseButton1Click:Connect(function()
	CFG.Tween = math.max(CFG.Tween - 5, 10)
	speedLbl.Text = "Tween: " .. CFG.Tween
	say("tween = " .. CFG.Tween .. " studs/s")
end)
speedUp.MouseButton1Click:Connect(function()
	CFG.Tween = math.min(CFG.Tween + 5, 60)
	speedLbl.Text = "Tween: " .. CFG.Tween
	say("tween = " .. CFG.Tween .. " studs/s")
end)

--==================== AUTO BOX LOOP ====================
task.spawn(function()
	local t = 0
	while task.wait(0.25) do
		if autoBox then
			t = t + 0.25
			if t >= CFG.AutoBoxEvery then t = 0; say(openBox()) end
		else
			t = 0
		end
	end
end)

--==================== STATS ====================
task.spawn(function()
	while task.wait(0.35) do
		local run = os.clock() - started
		vPicked.Text = tostring(picked)
		vBoxes.Text  = tostring(boxes)
		vRate.Text   = string.format("%.0f", picked / math.max(run / 3600, 0.0001))
		vUp.Text     = string.format("%02d:%02d", math.floor(run / 60), math.floor(run % 60))
	end
end)

--==================== ANTI AFK ====================
if CFG.AntiAFK then
	pcall(function()
		local cons = getconnections and getconnections(lp.Idled)
		if cons and #cons > 0 then
			for _, c in ipairs(cons) do
				pcall(function()
					if c.Disable then c.Disable(c) elseif c.Disconnect then c.Disconnect(c) end
				end)
			end
		else
			lp.Idled:Connect(function()
				VU:CaptureController()
				VU:ClickButton2(Vector2.new())
			end)
		end
	end)
end

print("[MM2] loaded - RightShift UI | F1 farm | F2 box")
