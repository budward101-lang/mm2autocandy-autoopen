--==================== SAFE LOOP ====================
local function safeLoop(name, step)
    task.spawn(function()
        while true do
            local ok, err = pcall(step)
            if not ok then
                print(("[MM2] %s loop error: %s"):format(name, tostring(err)))
                task.wait(0.25)
            end
        end
    end)
end

--==================== THEME + UI HELPERS ====================
local function new(c, props, parent)
    local o = Instance.new(c)
    for k, v in pairs(props) do pcall(function() o[k] = v end) end
    o.Parent = parent
    return o
end

local T = {
    bg1    = Color3.fromRGB(14, 10, 22),
    bg2    = Color3.fromRGB(33, 23, 52),
    panel  = Color3.fromRGB(25, 19, 39),
    panelHi= Color3.fromRGB(42, 32, 62),
    stroke = Color3.fromRGB(80, 62, 116),
    orange = Color3.fromRGB(255, 152, 64),
    purple = Color3.fromRGB(160, 98, 238),
    green  = Color3.fromRGB(58, 200, 114),
    greenD = Color3.fromRGB(30, 122, 68),
    red    = Color3.fromRGB(234, 98, 98),
    text   = Color3.fromRGB(238, 238, 250),
    muted  = Color3.fromRGB(152, 150, 176),
}

local function corner(o, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o)
end
local function stroke(o, c, t, trans)
    return new("UIStroke", {
        Color = c or T.stroke, Thickness = t or 1,
        Transparency = trans or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
end
local function grad(o, c1, c2, rot)
    return new("UIGradient", {
        Color = ColorSequence.new(c1, c2), Rotation = rot or 90,
    }, o)
end
local function lighten(c, a)
    a = a or 0.1
    return Color3.new(
        math.clamp(c.R + a, 0, 1),
        math.clamp(c.G + a, 0, 1),
        math.clamp(c.B + a, 0, 1))
end

