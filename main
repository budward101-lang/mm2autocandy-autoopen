--[[================================================================
  MM2 HALLOWEEN 2026 • CANDY AUTOFARM  v2      (by Venice)
  Fixes: auto-starts, visible load banner, safe GUI parenting,
  live status, built-in diagnostics. RightShift = hide/show UI.
=================================================================]]

local Players             = game:GetService("Players")
local TweenService        = game:GetService("TweenService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local VirtualUser         = game:GetService("VirtualUser")
local UserInputService    = game:GetService("UserInputService")

local LP        = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

local VERSION = "v2"

------------------------------------------------------------------
-- CONFIG (auto-start ON)
------------------------------------------------------------------
local CFG = {
    TweenSpeed   = 25,
    CollectRange = 6000,
    BoxCooldown  = 1.5,
    BoxCost      = 600,
    AutoFarm     = true,    -- <-- starts on
    Noclip       = true,    -- <-- starts on
    AutoOpenBox  = true,    -- <-- starts on
    AntiAFK      = true,
}

local STATE = "starting..."

local function log(...)
    print("[MM2 Autofarm " .. VERSION .. "]", ...)
end

------------------------------------------------------------------
-- CHARACTER TRACKING
------------------------------------------------------------------
local char, hrp
local function bindChar(c)
    char = c
    hrp  = c:WaitForChild("HumanoidRootPart", 15)
    log("character bound:", c.Name)
end
if LP.Character then bindChar(LP.Character) end
LP.CharacterAdded:Connect(bindChar)

------------------------------------------------------------------
-- TOUCH SHIM
------------------------------------------------------------------
local hasFTT = (typeof(firetouchinterest) == "function")
log("firetouchinterest available:", hasFTT)

local function fireTouch(a, b)
    if not hasFTT then return end
    pcall(function()
        firetouchinterest(a, b, 0)
        firetouchinterest(a, b, 1)
    end)
end

------------------------------------------------------------------
-- NOCLIP
------------------------------------------------------------------
local savedCollide, noclipActive = {}, false
task.spawn(function()
    while true do
        if CFG.Noclip then
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then
                        if savedCollide[p] == nil then savedCollide[p] = p.CanCollide end
                        p.CanCollide = false
                    end
                end
            end
            noclipActive = true
        elseif noclipActive then
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") and savedCollide[p] ~= nil then
                        p.CanCollide = savedCollide[p]
                    end
                end
            end
            savedCollide, noclipActive = {}, false
        end
        task.wait(0.1)
    end
end)

------------------------------------------------------------------
-- CANDY
------------------------------------------------------------------
local function getCandyList()
    local list = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        local container = obj:FindFirstChild("CoinContainer")
            or obj:FindFirstChild("CandyContainer")
        if container then
            for _, item in ipairs(container:GetChildren()) do
                local part = item
                if item:IsA("Model") then
                    part = item:FindFirstChild("CoinVisual")
                        or item:FindFirstChild("CandyVisual")
                        or item:FindFirstChildWhichIsA("BasePart")
                end
                if part and part:IsA("BasePart") and part.Parent then
                    table.insert(list, part)
                end
            end
        end
    end
    return list
end

local function collect(part)
    if not hrp or not part or not part.Parent then return end
    pcall(function() hrp.CFrame = CFrame.new(part.Position) end)
    fireTouch(hrp, part)
    if part.Parent then fireTouch(hrp, part.Parent) end
end

local function farmLoop()
    while CFG.AutoFarm do
        if hrp and hrp.Parent then
            local best, bestD
            for _, part in ipairs(getCandyList()) do
                local d = (hrp.Position - part.Position).Magnitude
                if d <= CFG.CollectRange and (not bestD or d < bestD) then
                    best, bestD = part, d
                end
            end

            if best then
                STATE = string.format("farming (%.0f studs)", bestD)
                local dur = math.max(bestD / math.max(CFG.TweenSpeed, 1), 0.05)
                local tween = TweenService:Create(
                    hrp,
                    TweenInfo.new(dur, Enum.EasingStyle.Linear),
                    { CFrame = CFrame.new(best.Position) }
                )
                tween:Play()
                local t0 = os.clock()
                while CFG.AutoFarm and best.Parent
                    and tween.PlaybackState == Enum.PlaybackState.Playing
                    and (os.clock() - t0) < dur + 2 do
                    task.wait()
                end
                if tween.PlaybackState == Enum.PlaybackState.Playing then tween:Cancel() end
                collect(best)
                task.wait(0.05)
            else
                STATE = "no candy here (in lobby?)"
                task.wait(0.25)
            end
        else
            STATE = "waiting for character"
            task.wait(0.3)
        end
    end
    STATE = "farm off"
end

------------------------------------------------------------------
-- BOX
------------------------------------------------------------------
local boxRemotes
local function findBoxRemotes()
    if boxRemotes then return boxRemotes end
    boxRemotes = {}
    local folder = ReplicatedStorage:FindFirstChild("Remotes")
    if folder then
        local r = folder:FindFirstChild("BoxOpened")
        if r and r:IsA("RemoteEvent") then table.insert(boxRemotes, r) end
    end
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local n = string.lower(v.Name)
            if (string.find(n, "box") or string.find(n, "crate") or string.find(n, "unbox"))
                and not table.find(boxRemotes, v) then
                table.insert(boxRemotes, v)
            end
        end
    end
    return boxRemotes
end

local function clickOpenButtons()
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d:IsA("TextButton") and d.Visible and d.AbsoluteSize.Magnitude > 0 then
            local t = string.lower(d.Text)
            if string.find(t, "open") or string.find(t, "unbox") then
                local c = d.AbsolutePosition + d.AbsoluteSize / 2
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0)
                    task.wait(0.03)
                    VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
                end)
            end
        end
    end
end

local function fireWorldPrompts()
    for _, d in ipairs(workspace:GetDescendants()) do
        local n = string.lower(d.Name)
        if string.find(n, "box") or string.find(n, "crate") then
            if d:IsA("ProximityPrompt") then
                pcall(function() fireproximityprompt(d) end)
            elseif d:IsA("ClickDetector") then
                pcall(function() fireclickdetector(d) end)
            end
        end
    end
end

local function getCandyCount()
    for k, v in pairs(LP:GetAttributes()) do
        if type(v) == "number" and string.find(string.lower(k), "candy") then return v end
    end
    for _, d in ipairs(LP:GetDescendants()) do
        if (d:IsA("IntValue") or d:IsA("NumberValue"))
            and string.find(string.lower(d.Name), "candy") then
            return d.Value
        end
    end
    return nil
end

local function openBox()
    local remotes = findBoxRemotes()
    if #remotes > 0 then
        for _, r in ipairs(remotes) do pcall(function() r:FireServer() end) end
    else
        clickOpenButtons()
        fireWorldPrompts()
    end
end

local function boxLoop()
    local last = 0
    while CFG.AutoOpenBox do
        if os.clock() - last >= CFG.BoxCooldown then
            local n = getCandyCount()
            if n == nil or n >= CFG.BoxCost then
                openBox()
                last = os.clock()
            end
        end
        task.wait(0.1)
    end
end

------------------------------------------------------------------
-- ANTI-AFK
------------------------------------------------------------------
if CFG.AntiAFK then
    LP.Idled:Connect(function()
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end)
end

------------------------------------------------------------------
-- DIAGNOSTICS
------------------------------------------------------------------
local function diagnose()
    log("========== DIAGNOSTICS ==========")
    log("PlaceId:", game.PlaceId, game.PlaceId == 142823291 and "(MM2 ✓)" or "(NOT MM2 ✗)")
    log("Character:", tostring(LP.Character))
    log("HumanoidRootPart:", tostring(hrp))
    log("firetouchinterest:", hasFTT)
    local maps = {}
    for _, o in ipairs(workspace:GetChildren()) do
        if o:FindFirstChild("CoinContainer") or o:FindFirstChild("CandyContainer") then
            table.insert(maps, o.Name)
        end
    end
    log("Maps with container:", #maps > 0 and table.concat(maps, ", ") or "NONE -> you are in the lobby")
    log("Candy parts visible:", #getCandyList())
    log("Candy count readable:", tostring(getCandyCount()))
    log("Box remotes found:", #findBoxRemotes())
    for _, r in ipairs(findBoxRemotes()) do log("   remote:", r:GetFullName()) end
    log("=================================")
    return #maps > 0, #findBoxRemotes()
end

------------------------------------------------------------------
-- GUI
------------------------------------------------------------------
local function pickParent()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then
        local ok2 = pcall(function() local t = Instance.new("Folder"); t.Parent = cg; t:Destroy() end)
        if ok2 then return cg end
    end
    return PlayerGui
end

local gui = Instance.new("ScreenGui")
gui.Name = "MM2_CandyAutofarm_" .. VERSION
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
gui.IgnoreGuiInset = true
gui.Parent = pickParent()
log("GUI parented to:", gui.Parent:GetFullName())

-- load banner
local banner = Instance.new("TextLabel")
banner.Size = UDim2.new(0, 260, 0, 34)
banner.Position = UDim2.new(0.5, -130, 0, 60)
banner.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
banner.Text = "MM2 CANDY AUTOFARM " .. VERSION .. " LOADED"
banner.Font = Enum.Font.GothamBold
banner.TextSize = 13
banner.TextColor3 = Color3.fromRGB(20, 20, 20)
banner.Parent = gui
Instance.new("UICorner", banner).CornerRadius = UDim.new(0, 8)
task.delay(4, function() banner:Destroy() end)

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 244, 0, 300)
frame.Position = UDim2.new(0, 20, 0.5, -150)
frame.BackgroundColor3 = Color3.fromRGB(22, 20, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
local stroke = Instance.new("UIStroke", frame)
stroke.Color = Color3.fromRGB(255, 140, 0)
stroke.Thickness = 1.5

local layout = Instance.new("UIListLayout", frame)
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 28)
title.BackgroundTransparency = 1
title.Text = "MM2 CANDY AUTOFARM"
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.TextColor3 = Color3.fromRGB(255, 160, 40)
title.LayoutOrder = 0
title.Parent = frame

local function addToggle(text, order, get, set)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 34)
    btn.LayoutOrder = order
    btn.BackgroundColor3 = get() and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(40, 38, 50)
    btn.Text = text .. (get() and ": ON" or ": OFF")
    btn.TextColor3 = Color3.fromRGB(205, 205, 215)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
    btn.MouseButton1Click:Connect(function()
        set(not get())
        local on = get()
        btn.Text = text .. (on and ": ON" or ": OFF")
        btn.BackgroundColor3 = on and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(40, 38, 50)
    end)
end

addToggle("Auto Farm Candy", 1,
    function() return CFG.AutoFarm end,
    function(v) CFG.AutoFarm = v; if v then task.spawn(farmLoop) end end)

addToggle("Noclip", 2,
    function() return CFG.Noclip end,
    function(v) CFG.Noclip = v end)

addToggle("Auto Open Box", 3,
    function() return CFG.AutoOpenBox end,
    function(v) CFG.AutoOpenBox = v; if v then task.spawn(boxLoop) end end)

-- speed row
local speedRow = Instance.new("Frame")
speedRow.Size = UDim2.new(1, -20, 0, 34)
speedRow.BackgroundColor3 = Color3.fromRGB(40, 38, 50)
speedRow.LayoutOrder = 4
speedRow.Parent = frame
Instance.new("UICorner", speedRow).CornerRadius = UDim.new(0, 7)

local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(0.6, 0, 1, 0)
speedLabel.Position = UDim2.new(0, 10, 0, 0)
speedLabel.BackgroundTransparency = 1
speedLabel.Text = "Tween speed"
speedLabel.TextXAlignment = Enum.TextXAlignment.Left
speedLabel.TextColor3 = Color3.fromRGB(205, 205, 215)
speedLabel.Font = Enum.Font.GothamMedium
speedLabel.TextSize = 13
speedLabel.Parent = speedRow

local speedBox = Instance.new("TextBox")
speedBox.Size = UDim2.new(0.3, 0, 0.7, 0)
speedBox.Position = UDim2.new(0.66, 0, 0.15, 0)
speedBox.BackgroundColor3 = Color3.fromRGB(25, 24, 32)
speedBox.Text = tostring(CFG.TweenSpeed)
speedBox.TextColor3 = Color3.fromRGB(255, 160, 40)
speedBox.Font = Enum.Font.GothamBold
speedBox.TextSize = 13
speedBox.Parent = speedRow
Instance.new("UICorner", speedBox).CornerRadius = UDim.new(0, 6)
speedBox.FocusLost:Connect(function()
    local n = tonumber(speedBox.Text)
    if n and n > 0 then CFG.TweenSpeed = n end
    speedBox.Text = tostring(CFG.TweenSpeed)
end)

-- diagnose button
local diagBtn = Instance.new("TextButton")
diagBtn.Size = UDim2.new(1, -20, 0, 30)
diagBtn.LayoutOrder = 5
diagBtn.BackgroundColor3 = Color3.fromRGB(50, 60, 90)
diagBtn.Text = "Diagnose (prints to console)"
diagBtn.TextColor3 = Color3.fromRGB(210, 220, 240)
diagBtn.Font = Enum.Font.GothamMedium
diagBtn.TextSize = 12
diagBtn.Parent = frame
Instance.new("UICorner", diagBtn).CornerRadius = UDim.new(0, 7)
diagBtn.MouseButton1Click:Connect(function()
    local inRound, remotes = diagnose()
    diagBtn.Text = inRound and ("OK: in round, " .. remotes .. " remote(s)")
        or "No map found - join a round"
    task.delay(3, function()
        diagBtn.Text = "Diagnose (prints to console)"
    end)
end)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 40)
status.BackgroundTransparency = 1
status.Text = "state: " .. STATE
status.TextWrapped = true
status.Font = Enum.Font.Gotham
status.TextSize = 11
status.TextColor3 = Color3.fromRGB(150, 150, 165)
status.LayoutOrder = 6
status.Parent = frame

-- mini reopen button
local mini = Instance.new("TextButton")
mini.Size = UDim2.new(0, 60, 0, 26)
mini.Position = UDim2.new(0, 20, 0, 20)
mini.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
mini.Text = "MM2"
mini.Font = Enum.Font.GothamBold
mini.TextSize = 13
mini.TextColor3 = Color3.fromRGB(20, 20, 20)
mini.Visible = false
mini.Parent = gui
Instance.new("UICorner", mini).CornerRadius = UDim.new(0, 6)

local function setVisible(v)
    frame.Visible = v
    mini.Visible = not v
end
mini.MouseButton1Click:Connect(function() setVisible(true) end)
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        setVisible(not frame.Visible)
    end
end)

-- live status
task.spawn(function()
    while true do
        local n = getCandyCount()
        status.Text = string.format("state: %s\ncandy: %s  |  speed: %d",
            STATE, n and tostring(n) or "?", CFG.TweenSpeed)
        task.wait(0.4)
    end
end)

------------------------------------------------------------------
-- AUTO START
------------------------------------------------------------------
task.spawn(farmLoop)
task.spawn(boxLoop)
log("AUTO-STARTED: farm + noclip + box. RightShift hides UI.")
