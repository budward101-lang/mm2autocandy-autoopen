-- buttons
local state = {}
local function makeButton(text, order, accent, width)
	local b = new("TextButton", {
		Size = width or UDim2.new(1, 0, 0, 38), BackgroundColor3 = C.row,
		BorderSizePixel = 0, AutoButtonColor = false, LayoutOrder = order, Text = "",
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0, 9) }, b)
	local stroke = new("UIStroke", { Color = accent, Thickness = 1, Transparency = 0.6 }, b)
	sheen(b)

	local bar = new("Frame", { Size = UDim2.fromOffset(3, 18), Position = UDim2.new(0, 9, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = accent, BorderSizePixel = 0 }, b)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)

	local lbl = new("TextLabel", { Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 20, 0, 0),
		BackgroundTransparency = 1, Text = text, TextColor3 = C.text,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left }, b)

	state[b] = { base = C.row, bar = bar, stroke = stroke, label = lbl, accent = accent }

	b.MouseEnter:Connect(function()
		TS:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = lighten(state[b].base, 0.07) }):Play()
		TS:Create(stroke, TweenInfo.new(0.12), { Transparency = 0.15 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TS:Create(b, TweenInfo.new(0.18), { BackgroundColor3 = state[b].base }):Play()
		TS:Create(stroke, TweenInfo.new(0.18), { Transparency = 0.6 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TS:Create(b, TweenInfo.new(0.06), { BackgroundColor3 = lighten(state[b].base, 0.14) }):Play()
	end)
	return b
end

local function setState(b, on, text, onColor)
	local s = state[b]
	s.base = on and onColor or C.row
	b.BackgroundColor3 = s.base
	s.bar.BackgroundColor3 = on and onColor or s.accent
	if text then s.label.Text = text end
end

