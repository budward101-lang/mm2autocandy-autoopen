local order = 1
local function mk(text, color, h)
    order = order + 1
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, h or 26)
    b.LayoutOrder = order
    b.BackgroundColor3 = color
    b.Text = text
    b.TextColor3 = Color3.fromRGB(235, 235, 240)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 12
    b.BorderSizePixel = 0
    b.Parent = body
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = b
    return b
end

local function toggle(text, get, set)
    local txt = type(text) == "function" and text or function() return text end
    local b = mk("", Color3.fromRGB(35, 28, 45))
    local function refresh()
        b.Text = txt() .. ": " .. (get() and "ON" or "OFF")
        if get() then
            b.TextColor3 = Color3.fromRGB(120, 255, 140)
        else
            b.TextColor3 = Color3.fromRGB(255, 110, 110)
        end
    end
    b.MouseButton1Click:Connect(function() set(not get()); refresh() end)
    b.__refresh = refresh
    refresh()
    return b
end

toggle("Candy farm", function() return S.farm end, function(v) S.farm = v end)
toggle("Auto buy box", function() return S.open end, function(v) S.open = v end)
local gateToggle = toggle(function() return "Buy only if >= " .. CFG.Cost end,
    function() return CFG.Gate end,
    function(v) CFG.Gate = v end)
toggle("Ignore event buttons", function() return CFG.IgnoreEvent end, function(v) CFG.IgnoreEvent = v end)

local function pickAt(mx, my)
    local pg = pgui()
    if not pg then return nil end
    for _, y in ipairs({my, my - 36}) do
        local objs = pg:GetGuiObjectsAtPosition(mx, y)
        for i = 1, #objs do
            local o = objs[i]
            if o:IsA("GuiButton") and o.Visible and chainVis(o.Parent) and not own(o) then
                return o
            end
        end
    end
    return nil
end

local function pin(what, assign)
    S.log = "click the " .. what .. " now"
    local conn
    conn = UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.UserInputType ~= Enum.UserInputType.MouseButton1
            and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local m = UIS:GetMouseLocation()
        local b = pickAt(m.X, m.Y)
        conn:Disconnect()
        if b then
            assign(b)
            S.log = "pinned " .. what .. ": " .. b.Name
            print("[MM2] pinned " .. what .. ": " .. b:GetFullName())
        else
            S.log = "nothing there"
        end
    end)
end

mk("PIN SHOP (click the SHOP button)", Color3.fromRGB(35, 60, 80), 30)
    .MouseButton1Click:Connect(function()
        pin("SHOP button", function(b) shopPin = b end)
    end)

mk("PIN BOX (click the Halloween Box)", Color3.fromRGB(35, 60, 80), 30)
    .MouseButton1Click:Connect(function() pin("box tile", function(b) tilePin = b end) end)

mk("PIN WALLET (click candy total)", Color3.fromRGB(35, 55, 70), 30)
    .MouseButton1Click:Connect(function()
        pin("wallet total", function(b) walletEl = b; S.candy = readCandy() end)
    end)

mk("BUY 1 NOW", Color3.fromRGB(60, 50, 30), 30)
    .MouseButton1Click:Connect(function()
        if S.busy then return end
        task.spawn(function()
            S.busy = true
            local was, saved = S.boxes, CFG.Gate
            CFG.Gate = false
            local t0 = os.clock()
            while os.clock() - t0 < 10 and S.boxes == was do
                step()
                task.wait(0.3)
            end
            CFG.Gate = saved
            S.log = "manual done"
            S.busy = false
        end)
    end)

mk("Dump buttons", Color3.fromRGB(45, 40, 55))
    .MouseButton1Click:Connect(function()
        local vis = buttons()
        for i = 1, #vis do
            print(string.format("   %-26s pos=(%d,%d) size=(%d,%d) label=%s",
                vis[i].Name, math.floor(vis[i].AbsolutePosition.X),
                math.floor(vis[i].AbsolutePosition.Y),
                math.floor(vis[i].AbsoluteSize.X), math.floor(vis[i].AbsoluteSize.Y),
                labelDeep(vis[i]):sub(1, 30)))
        end
    end)

mk("Dump picks", Color3.fromRGB(45, 40, 55))
    .MouseButton1Click:Connect(function()
        local s = findShopBtn()
        local x = findBoxBtn()
        local b = findBuyBtn(nil)
        print("[MM2] shop=" .. (s and s:GetFullName() or "nil"))
        print("[MM2] box =" .. (x and x:GetFullName() or "nil"))
        print("[MM2] buy =" .. (b and b:GetFullName() or "nil"))
    end)

mk("Clear pins", Color3.fromRGB(50, 42, 30))
    .MouseButton1Click:Connect(function()
        shopPin, tilePin, walletEl = nil, nil, nil
        S.shopName, S.tileName = "NONE", "NONE"
        S.log = "pins cleared"
    end)

do
    local dragging, startPos, startInput
    head.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = i.Position
            startPos = frame.Position
        end
    end)
    head.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startInput
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

task.spawn(function()
    local last = ""
    while task.wait(0.5) do
        if gateToggle and gateToggle.__refresh then gateToggle.__refresh() end
        local gate
        if S.force then gate = "FORCED"
        elseif not CFG.Gate then gate = "off"
        elseif S.waiting then gate = "HOLDING"
        else gate = "armed" end
        local txt = string.format(
            "boxes  : %d   picked: %d\ngate   : %s\nbalance: %s / %d\nshop   : %s\nbox    : %s\nclick  : %s\nlog    : %s",
            S.boxes, S.picked, gate,
            S.candy and tostring(S.candy) or "?", CFG.Cost,
            (S.shopName or "NONE"):sub(1, 20),
            (S.tileName or "-"):sub(1, 20),
            (S.lastClick or "-"):sub(1, 22),
            (S.log or ""):sub(1, 30))
        if txt ~= last then last = txt; status.Text = txt end
    end
end)

UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift then
        frame.Visible = not frame.Visible
    elseif i.KeyCode == Enum.KeyCode.F1 then
        S.farm = not S.farm
    elseif i.KeyCode == Enum.KeyCode.F2 then
        S.open = not S.open
    elseif i.KeyCode == Enum.KeyCode.F3 then
        S.force = not S.force
    end
end)

print("[MM2] === v16 LOAD COMPLETE ===")
