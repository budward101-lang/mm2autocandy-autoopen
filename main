--[[================================================================
  MM2 HALLOWEEN 2026  •  CANDY AUTOFARM          (by Venice)
  ------------------------------------------------------------------
  • Auto-collect candy on the map (noclip through walls)
  • Auto-open the Halloween Box '26 (600 candy per open)
  • Tween speed 25 studs/sec (editable in the GUI)
  • Anti-AFK + auto-respawn
  PlaceId: 142823291   |   PC + mobile executors
=================================================================]]

local Players           = game:GetService("Players")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LP        = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

------------------------------------------------------------------
-- CONFIG
------------------------------------------------------------------
local CFG = {
    TweenSpeed   = 25,     -- studs per second (what you asked for)
    CollectRange = 6000,
    BoxCooldown  = 1.5,
    BoxCost      = 600,
    AutoFarm     = false,
    Noclip       = false,
    AutoOpenBox  = false,
    AntiAFK      = true,
}

------------------------------------------------------------------
-- CHARACTER TRACKING
------------------------------------------------------------------
local char, hrp
local function bindChar(c)
    char = c
    hrp  = c:WaitForChild("HumanoidRootPart", 15)
end
if LP.Character then bindChar(LP.Character) end
LP.CharacterAdded:Connect(bindChar)

------------------------------------------------------------------
-- NOCLIP (remembers + restores CanCollide)
------------------------------------------------------------------
local savedCollide, noclipActive = {}, false

task.spawn(function()
    while true do
        if CFG.Noclip then
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then
                        if savedCollide[p] == nil then savedCollide[p] = p.CanCollide end
                        p.CanCollide = false
                    end
                end
            end
            noclipActive = true
        elseif noclipActive then
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") and savedCollide[p] ~= nil then
                        p.CanCollide = savedCollide[p]
                    end
                end
            end
            savedCollide, noclipActive = {}, false
        end
        task.wait(0.1)
    end
end)

------------------------------------------------------------------
-- CANDY FINDER  (candy replaces coins -> lives in CoinContainer)
------------------------------------------------------------------
local function getCandyList()
    local list = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        local container = obj:FindFirstChild("CoinContainer")
            or obj:FindFirstChild("CandyContainer")
        if container then
            for _, item in ipairs(container:GetChildren()) do
                local part = item
                if item:IsA("Model") then
                    part = item:FindFirstChild("CoinVisual")
                        or item:FindFirstChild("CandyVisual")
                        or item:FindFirstChildWhichIsA("BasePart")
                end
                if part and part:IsA("BasePart") and part.Parent then
                    table.insert(list, part)
                end
            end
        end
    end
    return list
end

local function collect(part)
    if not hrp or not part or not part.Parent then return end
    pcall(function() hrp.CFrame = CFrame.new(part.Position) end)
    pcall(function()
        firetouchinterest(hrp, part, 0)
        firetouchinterest(hrp, part, 1)
    end)
    if part.Parent then
        pcall(function()
            firetouchinterest(hrp, part.Parent, 0)
            firetouchinterest(hrp, part.Parent, 1)
        end)
    end
end

local function farmLoop()
    while CFG.AutoFarm do
        if hrp and hrp.Parent then
            local best, bestD
            for _, part in ipairs(getCandyList()) do
                local d = (hrp.Position - part.Position).Magnitude
                if d <= CFG.CollectRange and (not bestD or d < bestD) then
                    best, bestD = part, d
                end
            end

            if best then
                local dur = math.max(bestD / math.max(CFG.TweenSpeed, 1), 0.05)
                local tween = TweenService:Create(
                    hrp,
                    TweenInfo.new(dur, Enum.EasingStyle.Linear),
                    { CFrame = CFrame.new(best.Position) }
                )
                tween:Play()

                local t0 = os.clock()
                while CFG.AutoFarm
                    and best.Parent
                    and tween.PlaybackState == Enum.PlaybackState.Playing
                    and (os.clock() - t0) < dur + 2 do
                    task.wait()
                end
                if tween.PlaybackState == Enum.PlaybackState.Playing then
                    tween:Cancel()
                end

                collect(best)
                task.wait(0.05)
            else
                task.wait(0.2)
            end
        else
            task.wait(0.3)
        end
    end
end

------------------------------------------------------------------
-- AUTO OPEN HALLOWEEN BOX
------------------------------------------------------------------
local boxRemotes
local function findBoxRemotes()
    if boxRemotes then return boxRemotes end
    boxRemotes = {}

    local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
    if remotesFolder then
        local r = remotesFolder:FindFirstChild("BoxOpened")
        if r and r:IsA("RemoteEvent") then table.insert(boxRemotes, r) end
    end

    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local n = string.lower(v.Name)
            if (string.find(n, "box") or string.find(n, "crate") or string.find(n, "unbox"))
                and not table.find(boxRemotes, v) then
                table.insert(boxRemotes, v)
            end
        end
    end
    return boxRemotes
end

local function clickOpenButtons()
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if d:IsA("TextButton") and d.Visible and d.AbsoluteSize.Magnitude > 0 then
            local t = string.lower(d.Text)
            if string.find(t, "open") or string.find(t, "unbox") then
                local c = d.AbsolutePosition + d.AbsoluteSize / 2
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0)
                    task.wait(0.03)
                    VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
                end)
            end
        end
    end
end

local function fireWorldPrompts()
    for _, d in ipairs(workspace:GetDescendants()) do
        local n = string.lower(d.Name)
        if string.find(n, "box") or string.find(n, "crate") then
            if d:IsA("ProximityPrompt") then
                pcall(function() fireproximityprompt(d) end)
            elseif d:IsA("ClickDetector") then
                pcall(function() fireclickdetector(d) end)
            end
        end
    end
end

local function getCandyCount()
    for k, v in pairs(LP:GetAttributes()) do
        if type(v) == "number" and string.find(string.lower(k), "candy") then
            return v
        end
    end
    for _, d in ipairs(LP:GetDescendants()) do
        if (d:IsA("IntValue") or d:IsA("NumberValue"))
            and string.find(string.lower(d.Name), "candy") then
            return d.Value
        end
    end
    return nil
end

local function openBox()
    local remotes = findBoxRemotes()
    if #remotes > 0 then
        for _, r in ipairs(remotes) do
            pcall(function() r:FireServer() end)
        end
    else
        clickOpenButtons()
        fireWorldPrompts()
    end
end

local function boxLoop()
    local last = 0
    while CFG.AutoOpenBox do
        if os.clock() - last >= CFG.BoxCooldown then
            local n = getCandyCount()
            if n == nil or n >= CFG.BoxCost then
                openBox()
                last = os.clock()
            end
        end
        task.wait(0.1)
    end
end

------------------------------------------------------------------
-- ANTI-AFK
------------------------------------------------------------------
if CFG.AntiAFK then
    LP.Idled:Connect(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

------------------------------------------------------------------
-- GUI
------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "MM2_CandyAutofarm"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 240, 0, 258)
frame.Position = UDim2.new(0, 20, 0.5, -129)
frame.BackgroundColor3 = Color3.fromRGB(22, 20, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local corner = Instance.new("UICorner", frame)
corner.CornerRadius = UDim.new(0, 10)
local stroke = Instance.new("UIStroke", frame)
stroke.Color = Color3.fromRGB(255, 140, 0)
stroke.Thickness = 1.5

local layout = Instance.new("UIListLayout", frame)
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 28)
title.BackgroundTransparency = 1
title.Text = "MM2 CANDY AUTOFARM"
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.TextColor3 = Color3.fromRGB(255, 160, 40)
title.LayoutOrder = 0
title.Parent = frame

local function addToggle(text, order, get, set)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 34)
    btn.LayoutOrder = order
    btn.BackgroundColor3 = Color3.fromRGB(40, 38, 50)
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(205, 205, 215)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.Parent = frame
    local c = Instance.new("UICorner", btn)
    c.CornerRadius = UDim.new(0, 7)

    btn.MouseButton1Click:Connect(function()
        set(not get())
        local on = get()
        btn.Text = text .. (on and ": ON" or ": OFF")
        btn.BackgroundColor3 = on and Color3.fromRGB(40, 120, 60)
            or Color3.fromRGB(40, 38, 50)
    end)
    return btn
end

addToggle("Auto Farm Candy", 1,
    function() return CFG.AutoFarm end,
    function(v)
        CFG.AutoFarm = v
        if v then task.spawn(farmLoop) end
    end)

addToggle("Noclip", 2,
    function() return CFG.Noclip end,
    function(v) CFG.Noclip = v end)

addToggle("Auto Open Box", 3,
    function() return CFG.AutoOpenBox end,
    function(v)
        CFG.AutoOpenBox = v
        if v then task.spawn(boxLoop) end
    end)

-- tween speed input
local speedRow = Instance.new("Frame")
speedRow.Size = UDim2.new(1, -20, 0, 34)
speedRow.BackgroundColor3 = Color3.fromRGB(40, 38, 50)
speedRow.LayoutOrder = 4
speedRow.Parent = frame
local sc = Instance.new("UICorner", speedRow)
sc.CornerRadius = UDim.new(0, 7)

local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(0.6, 0, 1, 0)
speedLabel.Position = UDim2.new(0, 10, 0, 0)
speedLabel.BackgroundTransparency = 1
speedLabel.Text = "Tween speed"
speedLabel.TextXAlignment = Enum.TextXAlignment.Left
speedLabel.TextColor3 = Color3.fromRGB(205, 205, 215)
speedLabel.Font = Enum.Font.GothamMedium
speedLabel.TextSize = 13
speedLabel.Parent = speedRow

local speedBox = Instance.new("TextBox")
speedBox.Size = UDim2.new(0.3, 0, 0.7, 0)
speedBox.Position = UDim2.new(0.66, 0, 0.15, 0)
speedBox.BackgroundColor3 = Color3.fromRGB(25, 24, 32)
speedBox.Text = tostring(CFG.TweenSpeed)
speedBox.TextColor3 = Color3.fromRGB(255, 160, 40)
speedBox.Font = Enum.Font.GothamBold
speedBox.TextSize = 13
speedBox.Parent = speedRow
local bc = Instance.new("UICorner", speedBox)
bc.CornerRadius = UDim.new(0, 6)
speedBox.FocusLost:Connect(function()
    local n = tonumber(speedBox.Text)
    if n and n > 0 then CFG.TweenSpeed = n end
    speedBox.Text = tostring(CFG.TweenSpeed)
end)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 22)
status.BackgroundTransparency = 1
status.Text = "Candy: ?"
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.TextColor3 = Color3.fromRGB(150, 150, 165)
status.LayoutOrder = 5
status.Parent = frame

task.spawn(function()
    while true do
        local n = getCandyCount()
        status.Text = string.format("Candy: %s   |   Speed: %d",
            n and tostring(n) or "?", CFG.TweenSpeed)
        task.wait(0.5)
    end
end)

print("[MM2 Candy Autofarm] Loaded. Tween speed:", CFG.TweenSpeed)
