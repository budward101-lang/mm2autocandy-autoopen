mk("BUY 1 NOW (force one purchase)", Color3.fromRGB(60, 50, 30), 30)
    .MouseButton1Click:Connect(function()
        if S.busy then return end
        task.spawn(function()
            S.busy = true
            if not S.onBox then navFromWorld() end
            local u = findUnbox() or waitUnbox(2.0) or openTileVerified()
            if not u then
                S.log = "buy now: no unbox button"
                S.busy = false
                return
            end
            local was = currentBalance()
            doBuy(u)
            S.log = "manual buy " .. tostring(was) .. " -> " .. tostring(currentBalance())
            S.busy = false
        end)
    end)

