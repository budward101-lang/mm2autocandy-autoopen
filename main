--=============================================================
--  MM2 • HALLOWEEN 2026 — CANDY FARM + AUTO OPEN BOX
--  v8: left-column shop targeting (Inventory/Shop/Spectate stack),
--  arrow filtered out, learns slot from pin. Centred GUI.
--  RightShift UI | F1 farm | F2 open | F3 force
--=============================================================

print("[MM2] v8 booting")

local Players = game:GetService("Players")
local UIS     = game:GetService("UserInputService")
local LP      = Players.LocalPlayer
local PG      = LP:WaitForChild("PlayerGui")
print("[MM2] services ok")

local CFG = {
    Speed = 20, Dwell = 3.0, Retry = 2.0, MaxTry = 3, Tick = 0.1, Rescan = 3.0,
    Cost = 600, Gate = true, BuyIfUnknown = false, TabFallback = false,
    -- left sidebar: icons sit at ~5% from the left; shop is the 2nd one down
    ShopBand = 0.15, ShopMin = 60, ShopIndex = 2,
    ShopKW  = {"shop", "store"},
    TileKW  = {"halloween box", "halloween", "mystery box", "mystery", "box"},
    UnboxKW = {"unbox", "open box", "hatch", "open"},
    BuyKW   = {"buy", "purchase", "confirm", "600"},
    CloseKW = {"close", "exit", "back", "x"},
    CloseNo = {"backpack", "bag", "shop", "store", "inventory", "spectate"},
    PopupKW = {"ok", "claim", "collect", "continue", "next", "nice", "great"},
    BottomY = 0.70,
}
local S = {
    farm = true, open = true, force = false,
    onBox = false, waiting = false, candy = nil,
    boxes = 0, picked = 0, log = "boot", walletName = "?",
    shopName = "NONE", shopHow = "-", busy = false,
}
print("[MM2] config ok")

local OWN = "MM2FarmV8"

local function pgui()
    local p = LP:FindFirstChildOfClass("PlayerGui")
    if p then return p end
    return PG
end

local function own(o)
    local p = o
    while p do
        if p:IsA("ScreenGui") then return p.Name == OWN end
        p = p.Parent
    end
    return false
end

local function chainVis(o)
    local pg = pgui()
    local p = o
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return true
end

local function buttons()
    local out = {}
    local pg = pgui()
    if not pg then return out end
    local kids = pg:GetDescendants()
    for i = 1, #kids do
        local d = kids[i]
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
            and d.Visible and d.AbsoluteSize.X > 0 and d.AbsoluteSize.Y > 0
            and chainVis(d.Parent) and not own(d) then
            out[#out + 1] = d
        end
    end
    return out
end

local function label(b)
    if b:IsA("TextButton") then return b.Name .. " " .. b.Text end
    return b.Name
end

local function labelDeep(b)
    local s = label(b)
    local n = 0
    local kids = b:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        if c:IsA("TextLabel") or c:IsA("TextButton") then
            s = s .. " " .. c.Text
            n = n + 1
            if n >= 4 then break end
        end
    end
    return s
end

local function vpY()
    local c = workspace.CurrentCamera
    if c then return c.ViewportSize.Y end
    return 1080
end

local function vpX()
    local c = workspace.CurrentCamera
    if c then return c.ViewportSize.X end
    return 1920
end

local function inBottom(b)
    return b.AbsolutePosition.Y >= vpY() * CFG.BottomY
end

local function bodyButtons()
    local out = {}
    local all = buttons()
    for i = 1, #all do
        if not inBottom(all[i]) then out[#out + 1] = all[i] end
    end
    return out
end

local function bottomRow()
    local out = {}
    local all = buttons()
    for i = 1, #all do
        if inBottom(all[i]) then out[#out + 1] = all[i] end
    end
    table.sort(out, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
    return out
end

local function findKW(list, kws, deep)
    for k = 1, #kws do
        for i = 1, #list do
            local s
            if deep then s = labelDeep(list[i]) else s = label(list[i]) end
            if s:lower():find(kws[k], 1, true) then return list[i] end
        end
    end
    return nil
end

local function click(b)
    if not b or not b.Parent then return false end
    pcall(function() b.Active = true end)
    if getconnections then
        local done = false
        pcall(function()
            local cs = getconnections(b.MouseButton1Click)
            for i = 1, #cs do
                if cs[i].Function then done = true; pcall(cs[i].Function, b) end
            end
        end)
        if done then return true end
        pcall(function()
            local cs = getconnections(b.Activated)
            for i = 1, #cs do
                if cs[i].Function then done = true; pcall(cs[i].Function, b) end
            end
        end)
        if done then return true end
    end
    if firesignal and pcall(firesignal, b.MouseButton1Click) then return true end
    return pcall(function() b:Activate() end)
end
print("[MM2] helpers ok")

--==================== LEFT SIDEBAR ====================

-- the INVENTORY / SHOP / SPECTATE stack down the left edge.
-- the little "<" collapse arrow is excluded by the size floor.
local function sidebar()
    local out = {}
    local all = buttons()
    local vx = vpX()
    for i = 1, #all do
        local b = all[i]
        local pos, sz = b.AbsolutePosition, b.AbsoluteSize
        local cx = (pos.X + sz.X * 0.5) / vx
        if cx < CFG.ShopBand and not inBottom(b)
            and sz.X >= CFG.ShopMin and sz.Y >= CFG.ShopMin then
            out[#out + 1] = b
        end
    end
    table.sort(out, function(a, b) return a.AbsolutePosition.Y < b.AbsolutePosition.Y end)
    return out
end

--==================== WALLET ====================

local walletEl = nil

local function readCandy()
    local e = walletEl
    if not e or not e.Parent then return nil end
    local d = e.Text:gsub("[^%d]", "")
    if #d == 0 then return nil end
    return tonumber(d)
end

local function findWallet()
    local pg = pgui()
    if not pg then return nil end
    local best, bestScore = nil, 0
    local kids = pg:GetDescendants()
    for i = 1, #kids do
        local o = kids[i]
        if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Visible
            and chainVis(o.Parent) and not own(o) then
            local d = o.Text:gsub("[^%d]", "")
            if #d > 0 then
                local path = ""
                local n = o
                local depth = 0
                while n and n ~= pg and depth < 4 do
                    path = path .. " " .. n.Name
                    n = n.Parent
                    depth = depth + 1
                end
                path = path:lower()
                local sc = 0
                if path:find("wallet", 1, true) then sc = sc + 100 end
                if path:find("balance", 1, true) then sc = sc + 60 end
                if path:find("total", 1, true) then sc = sc + 60 end
                if path:find("candy", 1, true) then sc = sc + 40 end
                if path:find("owned", 1, true) then sc = sc + 40 end
                if path:find("amount", 1, true) then sc = sc + 20 end
                if path:find("cost", 1, true) then sc = sc - 40 end
                if path:find("price", 1, true) then sc = sc - 40 end
                if sc > bestScore then bestScore = sc; best = o end
            end
        end
    end
    if best and bestScore > 0 then
        S.walletName = best.Name
        return best
    end
    return nil
end

local function canBuy()
    if S.force then return true end
    if not CFG.Gate then return true end
    if not walletEl or not walletEl.Parent then walletEl = findWallet() end
    local bal = readCandy()
    if bal then S.candy = bal end
    if not bal then bal = S.candy end
    if bal == nil then return CFG.BuyIfUnknown end
    return bal >= CFG.Cost
end
print("[MM2] wallet ok")

--==================== NAV ====================

local shopPin, tilePin = nil, nil

local function textOf(o)
    local t = o.Name
    if o:IsA("TextLabel") or o:IsA("TextButton") then t = t .. " " .. o.Text end
    return t
end

local function buttonAncestor(o)
    local p = o
    local d = 0
    while p and d < 6 do
        if p:IsA("GuiButton") then return p end
        p = p.Parent
        d = d + 1
    end
    return nil
end

local function validBtn(b)
    return b and b.Parent and b.Visible and chainVis(b.Parent) and not own(b)
end

local function findShop()
    if validBtn(shopPin) then return shopPin, "pin" end

    local pg = pgui()
    if pg then
        local kids = pg:GetDescendants()
        local best, bestScore = nil, 0
        for i = 1, #kids do
            local o = kids[i]
            if (o:IsA("TextLabel") or o:IsA("TextButton")
                or o:IsA("ImageButton") or o:IsA("ImageLabel"))
                and o.Visible and chainVis(o.Parent) and not own(o) then
                local t = textOf(o):lower()
                local sc = 0
                if t:find("shop", 1, true) then sc = sc + 100 end
                if t:find("store", 1, true) then sc = sc + 60 end
                if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text:find("%$") then
                    sc = sc + 45
                end
                if sc > 0 then
                    local b = buttonAncestor(o)
                    if validBtn(b) and not inBottom(b) then
                        if sc > bestScore then bestScore = sc; best = b end
                    end
                end
            end
        end
        if best then return best, "text" end
    end

    -- the left sidebar: slot #2 is SHOP (INVENTORY is #1, SPECTATE is #3)
    local col = sidebar()
    local cand = col[CFG.ShopIndex]
    if validBtn(cand) then return cand, "column#" .. CFG.ShopIndex end

    -- last resort: whitish button on the left half, above the tab row
    local vx, vy = vpX(), vpY()
    local all = buttons()
    for i = 1, #all do
        local b = all[i]
        if not inBottom(b) then
            local pos, sz = b.AbsolutePosition, b.AbsoluteSize
            local cx = (pos.X + sz.X * 0.5) / vx
            local cy = (pos.Y + sz.Y * 0.5) / vy
            local c = b.BackgroundColor3
            local whitish = c.R > 0.65 and c.G > 0.65 and c.B > 0.65
            if cx > 0.02 and cx < 0.4 and cy > 0.12 and cy < 0.85
                and sz.X > 60 and sz.X < 200 and whitish then
                return b, "geometry"
            end
        end
    end
    return nil, "none"
end

local function findTile()
    if tilePin and tilePin.Parent and tilePin.Visible and chainVis(tilePin.Parent) then return tilePin end
    return findKW(bodyButtons(), CFG.TileKW, true)
end

local function findUnbox()
    return findKW(bodyButtons(), CFG.UnboxKW, false)
end

local function waitUnbox(t)
    local t0 = os.clock()
    while os.clock() - t0 < t do
        local b = findUnbox()
        if b then return b end
        task.wait(0.15)
    end
    return nil
end

local function isClose(b)
    local l = label(b):lower()
    for i = 1, #CFG.CloseNo do
        if l:find(CFG.CloseNo[i], 1, true) then return false end
    end
    for i = 1, #CFG.CloseKW do
        local k = CFG.CloseKW[i]
        if l == k then return true end
        if #k > 2 and l:find(k, 1, true) then return true end
    end
    return false
end

local function closeAll()
    S.onBox = false
    for _ = 1, 3 do
        local vis = buttons()
        local target = nil
        for i = 1, #vis do
            if isClose(vis[i]) then target = vis[i]; break end
        end
        if not target then return end
        click(target)
        task.wait(0.5)
    end
end

local function dismissPopup()
    if findUnbox() then return false end
    local body = bodyButtons()
    for k = 1, #CFG.PopupKW do
        for i = 1, #body do
            if label(body[i]):lower() == CFG.PopupKW[k] then
                click(body[i])
                task.wait(0.4)
                return true
            end
        end
    end
    return false
end

local function reachBox()
    local u = findUnbox()
    if u then return u end
    u = waitUnbox(1.2)
    if u then return u end

    local tile = findTile()
    if tile then
        click(tile)
        S.log = "tile: " .. tile.Name
        task.wait(0.8)
        u = waitUnbox(2.5)
        if u then return u end
    end

    if CFG.TabFallback then
        local row = bottomRow()
        for i = 1, #row do
            click(row[i])
            u = waitUnbox(1.2)
            if u then
                S.log = "tab fallback: " .. row[i].Name
                return u
            end
        end
    end
    return nil
end

local function doBuy(u)
    click(u)
    task.wait(1.2)
    local b = findKW(bodyButtons(), CFG.BuyKW, false)
    if not b then b = findKW(buttons(), CFG.BuyKW, false) end
    if b then
        click(b)
        S.log = "buy: " .. b.Name
        task.wait(1.0)
    end
    local after = readCandy()
    if after then
        S.candy = after
    elseif S.candy then
        S.candy = math.max(0, S.candy - CFG.Cost)
    end
    S.boxes = S.boxes + 1
end

local function cycle()
    S.busy = true

    if S.onBox then
        if not canBuy() then
            S.waiting = true
            S.log = "waiting " .. tostring(S.candy) .. "/" .. CFG.Cost
            S.busy = false
            return
        end
        local u = findUnbox()
        if not u and dismissPopup() then u = waitUnbox(1.0) end
        if u then
            doBuy(u)
            S.waiting = false
            S.busy = false
            return
        end
        S.onBox = false
        S.log = "page gone - full cycle"
    end

    closeAll()
    task.wait(0.3)

    local shop, how = findShop()
    S.shopName = shop and shop.Name or "NONE"
    S.shopHow = how
    if not shop then
        S.log = "NO SHOP - use PIN SHOP"
        S.busy = false
        return
    end
    click(shop)
    S.log = "shop (" .. how .. "): " .. shop.Name
    task.wait(1.1)

    local u = reachBox()
    if not u then
        S.log = "shop open, no unbox button"
        S.busy = false
        return
    end

    walletEl = findWallet()
    local bal = readCandy()
    if bal then S.candy = bal end

    if not canBuy() then
        S.log = "page open - need " .. CFG.Cost
        S.waiting = true
        S.onBox = true
        S.busy = false
        return
    end

    doBuy(u)
    S.waiting = false
    S.onBox = true
    S.busy = false
end
print("[MM2] nav ok")

task.spawn(function()
    while task.wait(0.5) do
        if S.open and not S.busy then cycle() end
    end
end)
print("[MM2] open loop ok")

--==================== FARM ====================

local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return nil end
    return c, r
end

local function isCandy(p)
    if not p:IsA("BasePart") then return false end
    local n = p.Name:lower()
    if not (n:find("candy", 1, true) or n:find("coin", 1, true)) then return false end
    local sz = p.Size
    if math.max(sz.X, sz.Y, sz.Z) > 8 then return false end
    local m = p:FindFirstAncestorOfClass("Model")
    if m and Players:GetPlayerFromCharacter(m) then return false end
    return true
end

local function alive(p)
    if not p or not p.Parent then return false end
    if p.Transparency >= 1 then return false end
    return p:IsDescendantOf(workspace)
end

local function firePrompt(part)
    local kids = part:GetDescendants()
    for i = 1, #kids do
        local d = kids[i]
        if d:IsA("ProximityPrompt") and d.Enabled ~= false then
            if fireproximityprompt then pcall(fireproximityprompt, d, d.HoldDuration) end
        elseif d:IsA("ClickDetector") then
            if fireclickdetector then pcall(fireclickdetector, d) end
        end
    end
end

local function touchFire(part, char)
    if not getconnections or not part.Parent then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        local cs = getconnections(part.Touched)
        for i = 1, #cs do
            if cs[i].Function then pcall(cs[i].Function, hrp) end
        end
    end)
end

local function glide(pos, char, hrp)
    if not char.Parent or not hrp.Parent then return end
    local startP = hrp.Position
    local delta = pos - startP
    local dist = delta.Magnitude
    if dist < 0.1 then return end
    local flat = Vector3.new(delta.X, 0, delta.Z)
    local rot = hrp.CFrame - hrp.CFrame.Position
    if flat.Magnitude > 1 then rot = CFrame.lookAt(Vector3.zero, flat.Unit) end
    local dur = dist / math.max(CFG.Speed, 1)
    local t0 = os.clock()
    while true do
        if not char.Parent or not hrp.Parent then return end
        local a = (os.clock() - t0) / dur
        if a > 1 then a = 1 end
        hrp.CFrame = CFrame.new(startP:Lerp(pos, a)) * rot
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if a >= 1 then break end
        task.wait()
    end
end

local function goGrab(target, char, hrp, hold)
    glide(target.Position, char, hrp)
    local rot = hrp.CFrame - hrp.CFrame.Position
    local base = target.Position
    local t0 = os.clock()
    while os.clock() - t0 < hold do
        if not alive(target) then break end
        local bob = math.sin((os.clock() - t0) * 6) * 0.4
        hrp.CFrame = CFrame.new(base + Vector3.new(0, bob, 0)) * rot
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        firePrompt(target)
        touchFire(target, char)
        task.wait(0.05)
    end
    if alive(target) then firePrompt(target); touchFire(target, char) end
end

task.spawn(function()
    local claimed, tries = {}, {}
    local lastScan = 0
    local noclipChar = nil

    while task.wait(CFG.Tick) do
        local char, hrp = getChar()
        if S.farm and char then
            if char ~= noclipChar then
                local kids = char:GetDescendants()
                for i = 1, #kids do
                    if kids[i]:IsA("BasePart") then kids[i].CanCollide = false end
                end
                noclipChar = char
            end

            if os.clock() - lastScan > CFG.Rescan then
                lastScan = os.clock()
                local best, bestD = nil, nil
                local kids = workspace:GetDescendants()
                for i = 1, #kids do
                    local p = kids[i]
                    if isCandy(p) then
                        local now = os.clock()
                        local t = claimed[p]
                        if (not t or t <= now) and (tries[p] or 0) < CFG.MaxTry then
                            local d = (p.Position - hrp.Position).Magnitude
                            if not bestD or d < bestD then best = p; bestD = d end
                        end
                    end
                end

                if best then
                    tries[best] = (tries[best] or 0) + 1
                    claimed[best] = os.clock() + CFG.Dwell + 2
                    goGrab(best, char, hrp, CFG.Dwell)
                    if alive(best) then goGrab(best, char, hrp, CFG.Retry) end
                    if not alive(best) then S.picked = S.picked + 1 end
                    tries[best] = CFG.MaxTry
                end
            end
        end
    end
end)
print("[MM2] farm loop ok")

--==================== UI (centred) ====================

local gui = Instance.new("ScreenGui")
gui.Name = OWN
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = pgui()

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 310, 0, 500)
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.Position = UDim2.new(0.5, 0, 0.5, 0)
frame.BackgroundColor3 = Color3.fromRGB(18, 15, 26)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui
local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 10); fc.Parent = frame
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 140, 40)
stroke.Thickness = 1.5
stroke.Parent = frame

local head = Instance.new("TextLabel")
head.Size = UDim2.new(1, 0, 0, 30)
head.BackgroundColor3 = Color3.fromRGB(30, 22, 40)
head.BorderSizePixel = 0
head.Text = "  MM2 FARM v8  -  LOADED"
head.TextColor3 = Color3.fromRGB(255, 175,
