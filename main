local pinningShop = false
local function pickShop()
    if pinningShop then return end
    pinningShop = true
    local conn
    local function cleanup() pinningShop = false; if conn then conn:Disconnect() end end
    task.delay(8, function() if pinningShop then cleanup(); STATE.log = "shop pick timed out" end end)
    conn = UIS.InputBegan:Connect(function(i, gp)
        if not pinningShop or gp then return end
        if i.UserInputType ~= Enum.UserInputType.MouseButton1
            and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local m = UIS:GetMouseLocation()
        local b = pickTopButtonAt(m.X, m.Y)
        cleanup()
        if not b then STATE.log = "no button there"; return end
        shopSrc = b
        STATE.log = "shop pinned: " .. b.Name
        print("[MM2] shop pinned: " .. b:GetFullName())
    end)
end

mkBtn(7, "PIN SHOP BUTTON  (click the SHOP bag)", Color3.fromRGB(35, 60, 80), 30)
    .MouseButton1Click:Connect(pickShop)

