--==================== BOTTOM TAB ROW ====================
--==================== WALLET READER ====================

local candySrc = nil

local function walletPath(o)
    local parts, n, pg, depth = {}, o, pgui(), 0
    while n and n ~= pg and depth < 4 do
        parts[#parts + 1] = n.Name
        n = n.Parent
        depth += 1
    end
    return table.concat(parts, " "):lower()
end

local function matchesWallet(o)
    local n = walletPath(o)
    for _, kw in ipairs(CONFIG.WalletKeywords) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

local function scoreWallet(o)
    local n = walletPath(o)
    local s = 0
    if n:find("wallet",  1, true) then s += 120 end
    if n:find("balance", 1, true) then s += 60  end
    if n:find("total",   1, true) then s += 60  end
    if n:find("owned",   1, true) then s += 50  end
    if n:find("candy",   1, true) then s += 40  end
    if n:find("sweet",   1, true) then s += 25  end
    if n:find("collect", 1, true) then s -= 30  end
    if n:find("cost", 1, true) or n:find("price", 1, true) then s -= 40 end
    if o:IsA("TextLabel") then s += 20 end
    return s
end

local function readCandy()
    local s = candySrc
    if not s or not s.Parent then return nil end
    if s:IsA("TextLabel") or s:IsA("TextButton") then
        local t = s.Text:gsub("[^%d]", "")
        return #t > 0 and tonumber(t) or nil
    end
    return tonumber(s.Value)
end

local function findCandySource()
    local best, bestScore = nil, -math.huge
    local function consider(o, numeric)
        if not numeric or not matchesWallet(o) then return end
        if o:FindFirstAncestor(OWN_GUI_NAME) then return end
        local s = scoreWallet(o)
        if s > bestScore then best, bestScore = o, s end
    end

    local pg = pgui()
    if pg then
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("TextLabel") and o.Visible and chainVisible(o.Parent) then
                consider(o, #(o.Text:gsub("[^%d]", "")) > 0)
            end
        end
    end

    for _, root in ipairs({LP:FindFirstChild("leaderstats"), LP, RS}) do
        if root then
            for _, o in ipairs(root:GetDescendants()) do
                if o:IsA("IntValue") or o:IsA("NumberValue") or o:IsA("StringValue") then
                    consider(o, tonumber(o.Value) ~= nil)
                end
            end
        end
    end
    return best
end

--==================== TAB / ICON FINDING ====================

local function viewportY()
local cam = workspace.CurrentCamera
return cam and cam.ViewportSize.Y or 1080
end

local function inBottomRow(b)
    return b.AbsolutePosition.Y >= viewportY() * 0.70
end

local function bottomRow(list)
    local out = {}
    for _, b in ipairs(list) do
        if inBottomRow(b) then out[#out + 1] = b end
    end
    table.sort(out, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
    return out
    return b.AbsolutePosition.Y >= viewportY() * 0.80
end

