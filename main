--=============================================================
--  MM2 • HALLOWEEN 2026 — CANDY FARM + AUTO OPEN BOX
--  v16: only clicks SHOP, the BOX tile, and BUY. Nothing else.
--  RightShift UI | F1 farm | F2 open | F3 force
--=============================================================

print("[MM2] v16 booting")

local Players = game:GetService("Players")
local UIS     = game:GetService("UserInputService")
local LP      = Players.LocalPlayer
local PG      = LP:WaitForChild("PlayerGui")
print("[MM2] services ok")

local CFG = {
    Speed = 20, Dwell = 3.0, Retry = 2.0, MaxTry = 3, Tick = 0.1, Rescan = 3.0,
    Cost = 600, Gate = true, BuyIfUnknown = true,
    IgnoreEvent = true,
    ShopBand = 0.15, ShopMin = 60,
    TileKW  = {"halloween", "mystery", "box", "26"},
    TileNo  = {"event", "radio", "modes", "settings", "backpack", "trade", "index", "codes"},
    EventKW = {"event"},
    BuyKW   = {"buy", "unbox", "open", "hatch", "purchase", "confirm"},
    BottomY = 0.70,
}
local S = {
    farm = true, open = true, force = false,
    waiting = false, candy = nil, boxes = 0, picked = 0,
    log = "boot", lastClick = "-", tileName = "-", shopName = "NONE", busy = false,
}
print("[MM2] config ok")

local OWN = "MM2FarmV16"

local function pgui()
    local p = LP:FindFirstChildOfClass("PlayerGui")
    if p then return p end
    return PG
end

local function own(o)
    local p = o
    while p do
        if p:IsA("ScreenGui") then return p.Name == OWN end
        p = p.Parent
    end
    return false
end

local function chainVis(o)
    local pg = pgui()
    local p = o
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return true
end

local function buttons()
    local out = {}
    local pg = pgui()
    if not pg then return out end
    local kids = pg:GetDescendants()
    for i = 1, #kids do
        local d = kids[i]
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
            and d.Visible and d.AbsoluteSize.X > 0 and d.AbsoluteSize.Y > 0
            and chainVis(d.Parent) and not own(d) then
            out[#out + 1] = d
        end
    end
    return out
end

local function label(b)
    if b:IsA("TextButton") then return b.Name .. " " .. b.Text end
    return b.Name
end

local function textOnly(b)
    local t = b:IsA("TextButton") and b.Text or ""
    if t == "" then t = b.Name end
    return (t:lower():gsub("^%s+", ""):gsub("%s+$", ""))
end

local function labelDeep(b)
    local s = label(b)
    local n = 0
    local kids = b:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        if c:IsA("TextLabel") or c:IsA("TextButton") then
            s = s .. " " .. c.Text
            n = n + 1
            if n >= 4 then break end
        end
    end
    return s
end

local function vpY()
    local c = workspace.CurrentCamera
    if c then return c.ViewportSize.Y end
    return 1080
end

local function vpX()
    local c = workspace.CurrentCamera
    if c then return c.ViewportSize.X end
    return 1920
end

local function inBottom(b)
    return b.AbsolutePosition.Y >= vpY() * CFG.BottomY
end

local function inSidebar(b)
    return (b.AbsolutePosition.X + b.AbsoluteSize.X * 0.5) / vpX() < CFG.ShopBand
end

-- content area, minus the very bottom quick-bar
local function actionButtons()
    local out = {}
    local all = buttons()
    local lim = vpY() * 0.90
    for i = 1, #all do
        local b = all[i]
        if not inSidebar(b) and b.AbsolutePosition.Y < lim then
            out[#out + 1] = b
        end
    end
    return out
end

local function buttonAncestor(o)
    local p = o
    local d = 0
    while p and d < 6 do
        if p:IsA("GuiButton") then return p end
        p = p.Parent
        d = d + 1
    end
    return nil
end

local function validBtn(b)
    return b and b.Parent and b.Visible and chainVis(b.Parent) and not own(b)
end

local lastClickBtn, lastClickAt = nil, 0
local function click(b)
    if not b or not b.Parent then return false end
    if b == lastClickBtn and os.clock() - lastClickAt < 0.35 then return true end
    lastClickBtn, lastClickAt = b, os.clock()
    pcall(function() b.Active = true end)
    if getconnections then
        local done = false
        pcall(function()
            local cs = getconnections(b.MouseButton1Click)
            for i = 1, #cs do
                if cs[i].Function then done = true; pcall(cs[i].Function, b) end
            end
        end)
        if done then return true end
        pcall(function()
            local cs = getconnections(b.Activated)
            for i = 1, #cs do
                if cs[i].Function then done = true; pcall(cs[i].Function, b) end
            end
        end)
        if done then return true end
    end
    if firesignal and pcall(firesignal, b.MouseButton1Click) then return true end
    return pcall(function() b:Activate() end)
end
print("[MM2] helpers ok")

--==================== WALLET ====================

local walletEl = nil

local function readCandy()
    local e = walletEl
    if not e or not e.Parent then return nil end
    local d = e.Text:gsub("[^%d]", "")
    if #d == 0 then return nil end
    return tonumber(d)
end

local function findWallet()
    local pg = pgui()
    if not pg then return nil end
    local best, bestScore = nil, 0
    local kids = pg:GetDescendants()
    for i = 1, #kids do
        local o = kids[i]
        if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Visible
            and chainVis(o.Parent) and not own(o) then
            local d = o.Text:gsub("[^%d]", "")
            if #d > 0 and #d <= 9 then
                local path = ""
                local n = o
                local depth = 0
                while n and n ~= pg and depth < 5 do
                    path = path .. " " .. n.Name
                    n = n.Parent
                    depth = depth + 1
                end
                path = path:lower()
                local sc = 0
                if path:find("wallet", 1, true)    then sc = sc + 120 end
                if path:find("balance", 1, true)   then sc = sc + 80 end
                if path:find("total", 1, true)     then sc = sc + 80 end
                if path:find("candy", 1, true)     then sc = sc + 60 end
                if path:find("owned", 1, true)     then sc = sc + 50 end
                if path:find("currency", 1, true)  then sc = sc + 50 end
                if path:find("amount", 1, true)    then sc = sc + 25 end
                if path:find("cost", 1, true)      then sc = sc - 45 end
                if path:find("price", 1, true)     then sc = sc - 45 end
                if o.Text:match("^[%d,]+$") then sc = sc + 35 end
                if sc > bestScore then bestScore = sc; best = o end
            end
        end
    end
    if best and bestScore > 40 then return best end
    return nil
end

local function currentBalance()
    if not walletEl or not walletEl.Parent then walletEl = findWallet() end
    local bal = readCandy()
    if bal then S.candy = bal end
    return bal or S.candy
end
print("[MM2] wallet ok")

--==================== THE ONLY THREE LOOKUPS ====================

local shopPin, tilePin = nil, nil
local baseBtns = {}

local function snapshotBase()
    baseBtns = {}
    local all = buttons()
    for i = 1, #all do
        baseBtns[all[i]:GetFullName()] = true
    end
end

-- 1) SHOP button: sidebar button whose text says shop
local function findShopBtn()
    if validBtn(shopPin) then return shopPin end
    local all = buttons()
    local best, bs = nil, 0
    for i = 1, #all do
        local b = all[i]
        if inSidebar(b) then
            local t = textOnly(b)
            local l = (b.Name .. " " .. t):lower()
            local sc = 0
            if t == "shop" then sc = sc + 200
            elseif l:find("shop", 1, true) then sc = sc + 120 end
            if l:find("store", 1, true) then sc = sc + 60 end
            if sc > bs then bs = sc; best = b end
        end
    end
    return best
end

-- 2) BOX tile: big square in the content area, halloween/mystery/box, no event
local function isEventBtn(b)
    local np = labelDeep(b):lower()
    local p, d = b.Parent, 0
    while p and d < 3 do
        np = np .. " " .. p.Name
        p = p.Parent
        d = d + 1
    end
    for k = 1, #CFG.EventKW do
        if np:find(CFG.EventKW[k], 1, true) then return true end
    end
    return false
end

local function findBoxBtn()
    if validBtn(tilePin) then return tilePin end

    local pg = pgui()
    if not pg then return nil end
    local vx, vy = vpX(), vpY()
    local best, bs = nil, 0
    local kids = pg:GetDescendants()
    for i = 1, #kids do
        local o = kids[i]
        if (o:IsA("TextLabel") or o:IsA("TextButton")
            or o:IsA("ImageButton") or o:IsA("ImageLabel"))
            and o.Visible and chainVis(o.Parent) and not own(o) then
            local b = buttonAncestor(o)
            if validBtn(b) and b ~= shopPin and not inBottom(b) and not inSidebar(b) then
                local sz, pos = b.AbsoluteSize, b.AbsolutePosition
                local cx = (pos.X + sz.X * 0.5) / vx
                local cy = (pos.Y + sz.Y * 0.5) / vy
                if sz.X > 100 and sz.Y > 100
                    and cx > 0.16 and cx < 0.96 and cy > 0.10 and cy < 0.92
                    and not isEventBtn(b) then
                    local t = (o.Name .. " " .. (o:IsA("TextButton") and o.Text or "")):lower()
                    local sc = 0
                    if t:find("halloween", 1, true) then sc = sc + 130 end
                    if t:find("mystery",   1, true) then sc = sc + 95  end
                    if t:find("box",       1, true) then sc = sc + 60  end
                    if t:find("26",        1, true) then sc = sc + 25  end
                    if t:find("candy",     1, true) then sc = sc - 25  end
                    if t:find("shop",      1, true) then sc = sc - 15  end
                    if sc == 0 then sc = 5 end
                    sc = sc + math.min(sz.X * sz.Y / 80000, 8)
                    if sc > bs then bs = sc; best = b end
                end
            end
        end
    end
    return best
end

-- 3) BUY button: short, content-area button that says buy/unbox/open
local function findBuyBtn(exclude)
    local body = actionButtons()
    local best, bs = nil, 0
    for i = 1, #body do
        local b = body[i]
        if b ~= exclude and b.AbsoluteSize.Y < 80 then
            local t = textOnly(b)
            local l = (b.Name .. " " .. t):lower()
            local sc = 0
            if t == "buy" or t == "unbox" or t == "open" or t == "hatch" then
                sc = sc + 200
            end
            if l:find("unbox", 1, true)    then sc = sc + 110 end
            if l:find("buy", 1, true)      then sc = sc + 100 end
            if l:find("purchase", 1, true) then sc = sc + 100 end
            if l:find("hatch", 1, true)    then sc = sc + 100 end
            if l:find("confirm", 1, true)  then sc = sc + 80  end
            if l:find("open", 1, true)     then sc = sc + 50  end
            if l:find("unboxed", 1, true)  then sc = sc - 60  end
            if b.AbsoluteSize.Y < 34 then sc = sc - 40 end
            if sc > bs then bs = sc; best = b end
        end
    end
    if bs >= 90 then return best end
    return nil
end
print("[MM2] lookups ok")

--==================== THE STEP ====================
-- one pass = at most one click, and only on shop / box / buy

local function step()
    -- broke? touch nothing at all
    local bal = currentBalance()
    if CFG.Gate and not S.force and bal ~= nil and bal < CFG.Cost then
        S.waiting = true
        S.log = "bal " .. bal .. " < " .. CFG.Cost .. " - holding"
        return
    end
    S.waiting = false

    -- already on a box menu? just buy
    local buy = findBuyBtn(nil)
    if buy then
        click(buy)
        S.lastClick = "buy " .. buy.Name
        S.boxes = S.boxes + 1
        task.wait(0.9)
        local c = findBuyBtn(buy)
        if c then
            click(c)
            S.lastClick = "confirm " .. c.Name
            task.wait(0.6)
        end
        return
    end

    -- box visible? click it, then buy
    local box = findBoxBtn()
    if box then
        click(box)
        S.lastClick = "box " .. box.Name
        S.tileName = box.Name
        local t0 = os.clock()
        local b2 = nil
        while os.clock() - t0 < 2.0 do
            b2 = findBuyBtn(box)
            if b2 then break end
            task.wait(0.15)
        end
        if b2 then
            local bal2 = currentBalance()
            if (not CFG.Gate) or S.force or bal2 == nil or bal2 >= CFG.Cost then
                click(b2)
                S.lastClick = "buy " .. b2.Name
                S.boxes = S.boxes + 1
                task.wait(0.8)
                local c = findBuyBtn(b2)
                if c then
                    click(c)
                    S.lastClick = "confirm " .. c.Name
                    task.wait(0.6)
                end
            end
        else
            S.log = "no buy button after box"
        end
        return
    end

    -- nothing else -> click shop
    local shop = findShopBtn()
    if shop then
        click(shop)
        S.lastClick = "shop " .. shop.Name
        S.shopName = shop.Name
        S.log = "clicked shop"
        task.wait(1.0)
    else
        S.log = "no shop button"
    end
end

task.spawn(function()
    task.wait(2)
    snapshotBase()
    while true do
        task.wait(0.4)
        if S.open and not S.busy then
            S.busy = true
            step()
            S.busy = false
        end
    end
end)
print("[MM2] open loop ok")

--==================== FARM ====================

local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return nil end
    return c, r
end

local function isCandy(p)
    if not p:IsA("BasePart") then return false end
    local n = p.Name:lower()
    if not (n:find("candy", 1, true) or n:find("coin", 1, true)) then return false end
    local sz = p.Size
    if math.max(sz.X, sz.Y, sz.Z) > 8 then return false end
    local m = p:FindFirstAncestorOfClass("Model")
    if m and Players:GetPlayerFromCharacter(m) then return false end
    return true
end

local function alive(p)
    if not p or not p.Parent then return false end
    if p.Transparency >= 1 then return false end
    return p:IsDescendantOf(workspace)
end

local function firePrompt(part)
    local kids = part:GetDescendants()
    for i = 1, #kids do
        local d = kids[i]
        if d:IsA("ProximityPrompt") and d.Enabled ~= false then
            if fireproximityprompt then pcall(fireproximityprompt, d, d.HoldDuration) end
        elseif d:IsA("ClickDetector") then
            if fireclickdetector then pcall(fireclickdetector, d) end
        end
    end
end

local function touchFire(part, char)
    if not getconnections or not part.Parent then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        local cs = getconnections(part.Touched)
        for i = 1, #cs do
            if cs[i].Function then pcall(cs[i].Function, hrp) end
        end
    end)
end

local function glide(pos, char, hrp)
    if not char.Parent or not hrp.Parent then return end
    local startP = hrp.Position
    local delta = pos - startP
    local dist = delta.Magnitude
    if dist < 0.1 then return end
    local flat = Vector3.new(delta.X, 0, delta.Z)
    local rot = hrp.CFrame - hrp.CFrame.Position
    if flat.Magnitude > 1 then rot = CFrame.lookAt(Vector3.zero, flat.Unit) end
    local dur = dist / math.max(CFG.Speed, 1)
    local t0 = os.clock()
    while true do
        if not char.Parent or not hrp.Parent then return end
        local a = (os.clock() - t0) / dur
        if a > 1 then a = 1 end
        hrp.CFrame = CFrame.new(startP:Lerp(pos, a)) * rot
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if a >= 1 then break end
        task.wait()
    end
end

local function goGrab(target, char, hrp, hold)
    glide(target.Position, char, hrp)
    local rot = hrp.CFrame - hrp.CFrame.Position
    local base = target.Position
    local t0 = os.clock()
    while os.clock() - t0 < hold do
        if not alive(target) then break end
        local bob = math.sin((os.clock() - t0) * 6) * 0.4
        hrp.CFrame = CFrame.new(base + Vector3.new(0, bob, 0)) * rot
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        firePrompt(target)
        touchFire(target, char)
        task.wait(0.05)
    end
    if alive(target) then firePrompt(target); touchFire(target, char) end
end

task.spawn(function()
    local claimed, tries = {}, {}
    local lastScan = 0
    local noclipChar = nil

    while task.wait(CFG.Tick) do
        local char, hrp = getChar()
        if S.farm and char then
            if char ~= noclipChar then
                local kids = char:GetDescendants()
                for i = 1, #kids do
                    if kids[i]:IsA("BasePart") then kids[i].CanCollide = false end
                end
                noclipChar = char
            end

            if os.clock() - lastScan > CFG.Rescan then
                lastScan = os.clock()
                local best, bestD = nil, nil
                local kids = workspace:GetDescendants()
                for i = 1, #kids do
                    local p = kids[i]
                    if isCandy(p) then
                        local now = os.clock()
                        local t = claimed[p]
                        if (not t or t <= now) and (tries[p] or 0) < CFG.MaxTry then
                            local d = (p.Position - hrp.Position).Magnitude
                            if not bestD or d < bestD then best = p; bestD = d end
                        end
                    end
                end

                if best then
                    tries[best] = (tries[best] or 0) + 1
                    claimed[best] = os.clock() + CFG.Dwell + 2
                    goGrab(best, char, hrp, CFG.Dwell)
                    if alive(best) then goGrab(best, char, hrp, CFG.Retry) end
                    if not alive(best) then S.picked = S.picked + 1 end
                    tries[best] = CFG.MaxTry
                end
            end
        end
    end
end)
print("[MM2] farm loop ok")

