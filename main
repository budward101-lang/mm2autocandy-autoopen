--==================== SHOW / HIDE ====================
local function setVisible(v)
    win.Visible = v
    shadow.Visible = v
    reopen.Visible = not v
end

reopen.MouseButton1Click:Connect(function() setVisible(true) end)

--==================== DRAG + KEYS ====================
do
    local drag, from, origin
    head.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag, from, origin = true, i.Position, win.Position
        end
    end)
    head.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - from
            win.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X,
                origin.Y.Scale, origin.Y.Offset + d.Y)
            shadow.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X + 5,
                origin.Y.Scale, origin.Y.Offset + d.Y + 7)
        end
    end)

    hideBtn.MouseButton1Click:Connect(function() setVisible(false) end)

    UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.RightShift then
            setVisible(not win.Visible)
        elseif i.KeyCode == Enum.KeyCode.F1 then
            farmBtn.MouseButton1Click:Fire()
        elseif i.KeyCode == Enum.KeyCode.F2 then
            boxBtn.MouseButton1Click:Fire()
        end
    end)
end

--==================== CORE STATE ====================
local alive = true
local boundHum
local roundActive = false
local lastSeen = 0

local visited = {}
local pending = {}   -- pickups fired, awaiting confirmation
local firstGrab = true
local resetting, resets, failStreak, pickedAtReset = false, 0, 0, 0
local selfAtReset = 0  -- selfCount at the last reset (exact per-life pickups)
local resetStart = 0
local spawnedAt = os.clock() - 10
local lastGrabAt = os.clock()
local ticks, stalls = 0, 0

local selfCount = 0   -- pickups the script itself confirmed (ground truth)
local attempts  = 0   -- pickups we actually fired a prompt for (hard upper bound)
local srcPicked = 0   -- candies per the trusted source, relative to lock time
local balance   = 0   -- raw value of the trusted source
local bagConfirmed = false
local bagSrcLabel = "none"

-- Once a source has passed verification the game's own counter is the honest
-- number, so prefer it. selfCount stays as the floor and as the anti-runaway
-- ceiling (a bad source can never exceed real pickups + Slack).
local function shownCount()
    if bagConfirmed and srcPicked > 0 then
        local cap = math.max(attempts, selfCount) + CFG.Slack
        return math.max(selfCount, math.min(srcPicked, cap))
    end
    return selfCount
end

local function syncPicked()
    picked = shownCount()
end

--==================== NOCLIP ====================
local nocParts = {}
local nocChar

local function rebuildNoc(ch)
    nocChar = ch
    nocParts = {}
    if not ch then return end
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("BasePart") then
            d.CanCollide = false
            nocParts[#nocParts + 1] = d
        end
    end
    ch.DescendantAdded:Connect(function(d)
        if nocChar ~= ch then return end
        if d:IsA("BasePart") then
            d.CanCollide = false
            nocParts[#nocParts + 1] = d
        end
    end)
end

local nocFrame = 0
RUN.Stepped:Connect(function()
    if not alive then return end

    nocFrame = nocFrame + 1
    if nocFrame % 3 == 0 then
        for i = 1, #nocParts do
            local d = nocParts[i]
            if d.Parent and d.CanCollide then d.CanCollide = false end
        end
    end

    local hrp = nocChar and nocChar:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end)

--==================== CANDY ====================
local coinContainer
local containerNextTry = 0

local function getContainer()
    if coinContainer and coinContainer.Parent then return coinContainer end
    local now = os.clock()
    if now >= containerNextTry then
        containerNextTry = now + CFG.ContainerRetry
        coinContainer = workspace:FindFirstChild("CoinContainer", true)
    end
    return coinContainer or workspace
end

local function isCandy(d)
    if not d:IsA("BasePart") then return false end
    if d.Transparency >= 0.99 then return false end
    if d.CanTouch == false then return false end
    local id = d:GetAttribute("CoinID")
    if id then return id == "Candy" end
    local n = d.Name:lower()
    if not (n:find("candy", 1, true) or n:find("coin", 1, true)) then return false end
    local s = d.Size
    if math.max(s.X, s.Y, s.Z) > CFG.MaxSize then return false end
    local m = d:FindFirstAncestorOfClass("Model")
    if m and P:GetPlayerFromCharacter(m) then return false end
    return true
end

local function isDead(part)
    if not part or not part.Parent then return true end
    if part.Transparency >= 0.99 then return true end
    if part.CanTouch == false then return true end
    local id = part:GetAttribute("CoinID")
    if id and id ~= "Candy" then return true end
    return false
end

local candyCache = {}
local candyCacheAt = 0

local function findCandy(force)
    local now = os.clock()
    if not force and (now - candyCacheAt) < CFG.CandyTTL then
        return candyCache
    end
    candyCacheAt = now

    local scope = getContainer()
    local out = {}
    for _, d in ipairs(scope:GetDescendants()) do
        if isCandy(d) then out[#out + 1] = d end
    end
    candyCache = out
    return out
end

-- Fly to the candy, fire the pickup, and get out.
-- Outcomes:
--   "gone"   -> it was already dead before we moved   (nobody's pickup)
--   "stolen" -> it died mid-flight, well outside reach (someone else's)
--   "hit"    -> it died on our toes                    (ours, counted)
--   "fired"  -> we fired an input; confirmed by settlePending
local function grab(part, hrp)
    if not part or not part.Parent or not hrp or not hrp.Parent then return "gone" end

    local dist = (part.Position - hrp.Position).Magnitude
    local dur = math.max(dist / CFG.Tween, 0.02)

    local tw = TS:Create(hrp,
        TweenInfo.new(dur, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(part.Position) })
    tw:Play()

    -- glide, bailing the instant the coin vanishes under us
    local arrive = os.clock() + dur
    local dead = false
    while true do
        if not part.Parent or isDead(part) then dead = true break end
        local left = arrive - os.clock()
        if left <= 0 then break end
        task.wait(left > 0.06 and 0.05 or 0)
    end

    -- not dead yet: make sure we are genuinely on top of it
    if not dead then
        local guard = 0
        while guard < 4 do
            if not part.Parent or isDead(part) then dead = true break end
            if (hrp.Position - part.Position).Magnitude <= 1 then break end
            guard = guard + 1
            task.wait()
        end
    end

    pcall(function() tw:Cancel() end)

    if dead then
        -- how close were we when it went? inside reach = our touch did it
        if (hrp.Position - part.Position).Magnitude <= CFG.TouchRange then
            return "hit"
        end
        return "stolen"
    end

    if CFG.Hold > 0 then
        task.wait(CFG.Hold)
        if not part.Parent or isDead(part) then return "hit" end
    end

    -- prompt / click fallback for coins that need an input
    local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin(); task.wait(prompt.HoldDuration); prompt:InputHoldEnd()
            end
        end)
    else
        local cd = part:FindFirstChildWhichIsA("ClickDetector", true)
        if cd and fireclickdetector then pcall(fireclickdetector, cd) end
    end

    return "fired"
end

--==================== PENDING RESOLVER ====================
-- non-blocking: confirms fired pickups, times out the ones that never landed
local function settlePending()
    local n = #pending
    if n == 0 then return end

    local now = os.clock()
    local i = 1
    while i <= n do
        local p = pending[i]
        if isDead(p.part) then
            selfCount = selfCount + 1
            attempts = attempts + 1
            failStreak = 0
            syncPicked()
            table.remove(pending, i)
            n = n - 1
        elseif (now - p.at) > CFG.PickupWait then
            attempts = attempts + 1
            failStreak = failStreak + 1
            table.remove(pending, i)
            n = n - 1
        else
            i = i + 1
        end
    end

    if failStreak >= CFG.FailLimit
    and (picked - pickedAtReset) >= CFG.MinPicks then
        doReset(failStreak .. " dead picks")
    end
end

--==================== ROUND WATCHER ====================
safeLoop("round", function()
    task.wait(0.6)
    local live = #findCandy() > 0
    local now = os.clock()

    if live then
        lastSeen = now
        if not roundActive then
            roundActive = true
            firstGrab = true
            say("round live")
        end
    elseif roundActive and (now - lastSeen) > CFG.RoundGrace then
        roundActive = false
        say("round over - waiting")
    end
end)

--==================== SOURCE TRACKER (v3 - correlation verified) ====================
local learnedMax
local fullStreak = 0
local lastFullReason = "-"

local cands = {}
local candNextScan = 0

local activeSrc
local lockVal = 0
local lockAnchor = 0
local verify = nil
local verifyFails = 0
local blacklist = {}   -- name -> clock time until which it is ignored
local dbgAt = 0

local function isOurs(d) return d:IsDescendantOf(gui) end
local function keyOf(c) return c.kind .. "|" .. c.name end
local function blocked(n)
    local t = blacklist[n]
    return t ~= nil and os.clock() < t
end

-- broadened: recognises bag / bucket / treat style counters too
local KEY_SCORES = {
    candies2026 = 100, candies = 92, candy = 90,
    halloween = 72, bucket = 64, sack = 62, pumpkin = 60,
    bag = 56, treat = 54, sweet = 52,
    loot = 46, coin = 42, count = 38, amount = 36,
    capacity = 34, cap = 30, total = 28, progress = 26,
}
local function candyScore(s)
    local n = tostring(s):lower()
    local best = 0
    for k, sc in pairs(KEY_SCORES) do
        if sc > best and n:find(k, 1, true) then best = sc end
    end
    return best
end

-- handles "1,234", "12 / 50", "1.2K", "Candy: 12"
local function parseNum(tok)
    local n, suf = tok:match("^(%d+%.?%d*)([KkMmBb]?)")
    if not n then return nil end
    local v = tonumber(n)
    if not v then return nil end
    suf = suf:upper()
    if suf == "K" then v = v * 1e3
    elseif suf == "M" then v = v * 1e6
    elseif suf == "B" then v = v * 1e9 end
    return v
end

local function extractCount(text)
    if type(text) ~= "string" then return nil end
    local t = text:gsub(",", "")
    if #t > 64 then return nil end
    local nums = {}
    for tok in t:gmatch("%d+%.?%d*[KkMmBb]?") do
        local v = parseNum(tok)
        if v then nums[#nums + 1] = v end
    end
    if #nums == 0 then return nil end
    if #nums >= 2 and t:find("/") then
        return math.floor(nums[1]), math.floor(nums[2])
    end
    return math.floor(nums[#nums]), nil
end

local function scanCands()
    local seen, out = {}, {}
    local function push(c)
        local k = keyOf(c)
        local ex = seen[k]
        if ex then
            if c.score > ex.score then
                ex.score, ex.ref, ex.max = c.score, c.ref, c.max
            end
        else
            seen[k] = c
            out[#out + 1] = c
        end
    end

    for _, h in ipairs({ { "me", lp }, { "char", lp.Character } }) do
        local obj = h[2]
        if obj then
            for k, v in pairs(obj:GetAttributes()) do
                if type(v) == "number" and candyScore(k) > 0 then
                    push({ kind = "attr", ref = k, obj = obj,
                           name = ("attr(%s):%s"):format(h[1], k),
                           score = candyScore(k) })
                end
            end
        end
    end

    for _, c in ipairs(lp:GetDescendants()) do
        if c:IsA("ValueBase") and candyScore(c.Name) > 0 then
            push({ kind = "val", ref = c, name = "val:" .. c:GetFullName(),
                   score = candyScore(c.Name) })
        end
    end

    local ls = lp:FindFirstChild("leaderstats")
    if ls then
        for _, c in ipairs(ls:GetChildren()) do
            if c:IsA("ValueBase") and candyScore(c.Name) > 0 then
                push({ kind = "val", ref = c, name = "stats:" .. c.Name,
                       score = candyScore(c.Name) + 5 })
            end
        end
    end

    -- GUI: keyword match OR a bare "12 / 50" style counter with no keywords
    for _, d in ipairs(pg:GetDescendants()) do
        if not isOurs(d) and (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
            local a, b = extractCount(d.Text)
            if a and (not b or b >= CFG.MinCap) then
                local sc = math.max(candyScore(d.Name), candyScore(d.Text))
                if sc == 0 and b and b <= 1000 and a <= b then sc = 25 end
                if sc > 0 then
                    push({ kind = "gui", ref = d, name = "gui:" .. d:GetFullName(),
                           score = sc, max = b })
                end
            end
        end
    end

    return out
end

local function readCand(c)
    if c.kind == "attr" then
        if c.obj and c.obj.Parent then
            local v = c.obj:GetAttribute(c.ref)
            if type(v) == "number" then return v end
        end
        return nil
    elseif c.kind == "val" then
        if c.ref and c.ref.Parent then return tonumber(c.ref.Value) end
        return nil
    elseif c.kind == "gui" then
        if c.ref and c.ref.Parent and c.ref.Visible then
            local a, b = extractCount(c.ref.Text)
            if b then c.max = b end
            return a
        end
        return nil
    end
end

--==================== BAG PROMPT (bottom-right counter) ====================
-- Looks for a GuiObject whose name (or a close ancestor) contains bag/bucket/sack
-- and whose text parses as a counter. This is the authoritative bag reading.
local bagPrompt, bagPromptAt = nil, 0

local function nameHasBag(n)
    local s = tostring(n):lower()
    return s:find("bag", 1, true) ~= nil
        or s:find("bucket", 1, true) ~= nil
        or s:find("sack", 1, true) ~= nil
        or s:find("pumpkin", 1, true) ~= nil
end

local function findBagPrompt()
    local now = os.clock()
    if bagPrompt and bagPrompt.Parent and (now - bagPromptAt) < 0.5 then return bagPrompt end
    bagPromptAt = now

    local best, bestScore
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
            local a, b = extractCount(d.Text)
            if a then
                local nm = 0
                if nameHasBag(d.Name) then
                    nm = 3
                else
                    local anc = d.Parent
                    for _ = 1, 3 do
                        if not anc or anc == pg then break end
                        if nameHasBag(anc.Name) then nm = 2 break end
                        anc = anc.Parent
                    end
                end
                if nm > 0 then
                    local score = nm * 1000 + (b and 100 or 0)
                    if b and b >= CFG.BagMinCap then score = score + 500 end
                    if not bestScore or score > bestScore then
                        best, bestScore = d, score
                    end
                end
            end
        end
    end

    if best and best ~= bagPrompt then
        print("[MM2] bag prompt: " .. best:GetFullName() .. "  text=" .. tostring(best.Text))
    end
    bagPrompt = best
    return best
end

local function readBagPrompt()
    local d = findBagPrompt()
    if not d or not d.Parent or not d.Visible then return nil end
    local a, b = extractCount(d.Text)
    if not a then return nil end
    return a, b, "prompt:" .. d.Name
end

local function readBag()
    local pc, pm, pn = readBagPrompt()
    if pc then return pc, pm, pn end
    if activeSrc and activeSrc.cur ~= nil then
        return activeSrc.cur, activeSrc.max, activeSrc.name
    end
    local best
    for _, c in ipairs(cands) do
        if c.cur ~= nil and (not best or c.score > best.score) then best = c end
    end
    if best then return best.cur, best.max, best.name end
end

--==================== GAME LOG / OUTPUT WATCHER ====================
-- Two signals: a bag reading ("37/50") and a collected total ("collected 128").
local logCur, logMax, logAt = nil, nil, 0
local logTotal, logTotalAt = nil, 0

local function noteLog(text)
    if not CFG.UseLog then return end
    if type(text) ~= "string" then return end
    local t = text:gsub(",", "")
    if #t > 200 then return end
    local low = t:lower()

    -- bag style "37/50"
    local m1, m2 = t:match("(%d+)%s*/%s*(%d+)")
    if m1 and m2 then
        local a, b = tonumber(m1), tonumber(m2)
        if b and b >= CFG.BagMinCap and a <= b then
            logCur, logMax, logAt = a, b, os.clock()
            learnedMax = b
        end
    end

    -- collected style: "collected 128", "candies: 128", "you have 128 candies"
    if low:find("collect", 1, true) or low:find("candies", 1, true)
    or low:find("candy", 1, true) then
        local n = low:match("(%d+)")
        if n then
            local v = tonumber(n)
            if v and v < 1e6 then logTotal, logTotalAt = v, os.clock() end
        end
    end
end

pcall(function() game:GetService("LogService").MessageOut:Connect(noteLog) end)

pcall(function()
    local tcs = game:GetService("TextChatService")
   
