task.spawn(function()
    local lastText = ""
    while task.wait(0.5) do
        local run = os.clock() - STATE.started
        local since = STATE.lastCheck > 0
            and string.format("%dm%02ds", math.floor((os.clock() - STATE.lastCheck) / 60),
                math.floor((os.clock() - STATE.lastCheck) % 60)) or "never"
        local gate = STATE.force and "FORCED"
            or (not CONFIG.RequireBalance and "off")
            or (STATE.waiting and "WAITING") or "armed"
        local txt = string.format(
            "picked  : %d   skipped: %d\nhops    : %d  (%.2f/s)\ntime    : %02d:%02d\nboxes   : %d   steps: %d\ngate    : %s  (%s)\nbalance : %s/%d  (%s ago)\nsource  : %s\nlog     : %s",
            STATE.collected, STATE.skipped, STATE.hops,
            STATE.hops / math.max(run, 0.001),
            math.floor(run / 60), math.floor(run % 60),
            STATE.boxes, #CONFIG.Sequence, gate,
            STATE.candy and (STATE.candy >= CONFIG.BoxCost and "can buy" or "too low") or "unknown",
            STATE.candy and tostring(STATE.candy) or "?", CONFIG.BoxCost, since,
            (STATE.walletName or "?"):sub(1, 28),
            (STATE.log or ""):sub(1, 30))
        if txt ~= lastText then lastText = txt; stats.Text = txt end
    end
end)

UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == CONFIG.Keybinds.UI then main.Visible = not main.Visible
    elseif i.KeyCode == CONFIG.Keybinds.Farm then STATE.farm = not STATE.farm
    elseif i.KeyCode == CONFIG.Keybinds.Open then STATE.open = not STATE.open
    elseif i.KeyCode == CONFIG.Keybinds.Force then STATE.force = not STATE.force end
end)

task.spawn(function()
    task.wait(3)
    local vis = visibleButtons()
    print("[MM2] DUMP visible buttons: " .. #vis)
    for _, b in ipairs(vis) do
        print(string.format("   %-28s pos=(%d,%d) size=(%d,%d) label=%s",
            b.Name, math.floor(b.AbsolutePosition.X), math.floor(b.AbsolutePosition.Y),
            math.floor(b.AbsoluteSize.X), math.floor(b.AbsoluteSize.Y),
            labelDeep(b):sub(1, 40)))
    end
    local row = bottomRow(vis)
    print("[MM2] DUMP bottom row: " .. #row)
    for i, b in ipairs(row) do print(string.format("   %d) %s", i, b.Name)) end
end)
mark("input + dump")

end -- BOOT

local ok, err = xpcall(BOOT, function(e) return tostring(e) .. "\n" .. debug.traceback("", 2) end)

if not ok then
    print("[MM2] FATAL: " .. tostring(err))
    pcall(function()
        local pg = game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        local sg = Instance.new("ScreenGui")
        sg.Name = "MM2CandyFarm_ERR"; sg.ResetOnSpawn = false; sg.Parent = pg
        local f = Instance.new("Frame")
        f.Size = UDim2.new(0, 470, 0, 240)
        f.Position = UDim2.new(0.5, -235, 0, 80)
        f.BackgroundColor3 = Color3.fromRGB(70, 14, 14)
        f.BorderSizePixel = 0; f.Parent = sg
        local t = Instance.new("TextLabel")
        t.Size = UDim2.new(1, -20, 1, -20); t.Position = UDim2.new(0, 10, 0, 10)
        t.BackgroundTransparency = 1; t.TextColor3 = Color3.fromRGB(255, 210, 210)
        t.Font = Enum.Font.Code; t.TextSize = 12; t.TextWrapped = true
        t.TextXAlignment = Enum.TextXAlignment.Left
        t.TextYAlignment = Enum.TextYAlignment.Top
        t.Text = "[MM2] " .. VERSION .. " script error:\n\n" .. tostring(err)
        t.Parent = f
    end)
end

print("[MM2] === LOAD COMPLETE " .. VERSION .. " ===")
