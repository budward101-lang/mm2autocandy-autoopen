--==================== SHOW / HIDE ====================
local function setVisible(v)
    win.Visible = v
    shadow.Visible = v
    reopen.Visible = not v
end

reopen.MouseButton1Click:Connect(function() setVisible(true) end)

--==================== DRAG + KEYS ====================
do
    local drag, from, origin
    head.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag, from, origin = true, i.Position, win.Position
        end
    end)
    head.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - from
            win.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X,
                origin.Y.Scale, origin.Y.Offset + d.Y)
            shadow.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X + 5,
                origin.Y.Scale, origin.Y.Offset + d.Y + 7)
        end
    end)

    hideBtn.MouseButton1Click:Connect(function() setVisible(false) end)

    UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.RightShift then
            setVisible(not win.Visible)
        elseif i.KeyCode == Enum.KeyCode.F1 then
            farmBtn.MouseButton1Click:Fire()
        elseif i.KeyCode == Enum.KeyCode.F2 then
            boxBtn.MouseButton1Click:Fire()
        end
    end)
end

--==================== CORE STATE ====================
local alive = true
local boundHum
local roundActive = false
local lastSeen = 0

local visited = {}
local pending = {}   -- pickups fired, awaiting confirmation
local nearWatch = {} -- part -> time we got close (for pass-through pickups)
local counted = setmetatable({}, { __mode = "k" })
local firstGrab = true
local resetting, resets, failStreak, pickedAtReset = false, 0, 0, 0
local selfAtReset = 0
local resetStart = 0
local spawnedAt = os.clock() - 10
local lastGrabAt = os.clock()
local ticks, stalls = 0, 0

local selfCount = 0
local attempts  = 0
local srcPicked = 0
local balance   = 0
local bagConfirmed = false
local bagSrcLabel = "none"

-- forward declarations (referenced by functions defined earlier)
local doReset
local clearTarget

local function bump(part)
    if not part or counted[part] then return false end
    counted[part] = true
    selfCount = selfCount + 1
    attempts = attempts + 1
    failStreak = 0
    syncPicked()
    return true
end

local function shownCount()
    if bagConfirmed and srcPicked > 0 then
        local cap = math.max(attempts, selfCount) + CFG.Slack
        return math.max(selfCount, math.min(srcPicked, cap))
    end
    return selfCount
end

local function syncPicked()
    picked = shownCount()
end

--==================== NOCLIP ====================
local nocParts = {}
local nocChar

local function rebuildNoc(ch)
    nocChar = ch
    nocParts = {}
    if not ch then return end
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("BasePart") then
            d.CanCollide = false
            nocParts[#nocParts + 1] = d
        end
    end
    ch.DescendantAdded:Connect(function(d)
        if nocChar ~= ch then return end
        if d:IsA("BasePart") then
            d.CanCollide = false
            nocParts[#nocParts + 1] = d
        end
    end)
end

local nocFrame = 0
RUN.Stepped:Connect(function()
    if not alive then return end

    nocFrame = nocFrame + 1
    if nocFrame % 3 == 0 then
        for i = 1, #nocParts do
            local d = nocParts[i]
            if d.Parent and d.CanCollide then d.CanCollide = false end
        end
    end

    local hrp = nocChar and nocChar:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end)

--==================== CANDY ====================
local coinContainer
local containerNextTry = 0

local function getContainer()
    if coinContainer and coinContainer.Parent then return coinContainer end
    local now = os.clock()
    if now >= containerNextTry then
        containerNextTry = now + CFG.ContainerRetry
        coinContainer = workspace:FindFirstChild("CoinContainer", true)
    end
    return coinContainer or workspace
end

local function isCandy(d)
    if not d:IsA("BasePart") then return false end
    if d.Transparency >= 0.99 then return false end
    if d.CanTouch == false then return false end
    local id = d:GetAttribute("CoinID")
    if id then return id == "Candy" end
    local n = d.Name:lower()
    if not (n:find("candy", 1, true) or n:find("coin", 1, true)) then return false end
    local s = d.Size
    if math.max(s.X, s.Y, s.Z) > CFG.MaxSize then return false end
    local m = d:FindFirstAncestorOfClass("Model")
    if m and P:GetPlayerFromCharacter(m) then return false end
    return true
end

local function isDead(part)
    if not part or not part.Parent then return true end
    if part.Transparency >= 0.99 then return true end
    if part.CanTouch == false then return true end
    local id = part:GetAttribute("CoinID")
    if id and id ~= "Candy" then return true end
    return false
end

local candyCache = {}
local candyCacheAt = 0

local function findCandy(force)
    local now = os.clock()
    if not force and (now - candyCacheAt) < CFG.CandyTTL then
        return candyCache
    end
    candyCacheAt = now

    local scope = getContainer()
    local out = {}
    for _, d in ipairs(scope:GetDescendants()) do
        if isCandy(d) then out[#out + 1] = d end
    end
    candyCache = out
    return out
end

--==================== MOVEMENT (non-blocking chase) ====================
-- One tween runs in the background. farmStep ticks per frame, so the instant a
-- candy pops the next target launches on the SAME frame - no dead stop.
local curTarget, curTween, curArriveAt = nil, nil, nil

local function stopTween()
    if curTween then pcall(function() curTween:Cancel() end) end
    curTween = nil
end

clearTarget = function()
    stopTween()
    curTarget, curArriveAt = nil, nil
end

local function firePrompt(part)
    local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(prompt.HoldDuration)
                prompt:InputHoldEnd()
            end
        end)
        return true
    end
    local cd = part:FindFirstChildWhichIsA("ClickDetector", true)
    if cd and fireclickdetector then
        pcall(fireclickdetector, cd)
        return true
    end
    return false
end

-- band-preferred / nearest pick
local function chooseTarget(hrp, now)
    local list = findCandy()
    if #list == 0 then return nil end

    local near, band = {}, {}
    for _, c in ipairs(list) do
        local v = visited[c]
        if not (v and (now - v) < CFG.Revisit) then
            local d = (c.Position - hrp.Position).Magnitude
            if d <= CFG.Radius then
                near[#near + 1] = c
                if d >= CFG.BandMin and d <= CFG.BandMax then
                    band[#band + 1] = c
                end
            end
        end
    end

    if firstGrab and #near > 0 then
        firstGrab = false
        return near[math.random(1, #near)]
    end
    if #band > 0 then
        return band[math.random(1, #band)]
    end

    local pool = (#near > 0) and near or list
    local best, bd
    for _, c in ipairs(pool) do
        local v = visited[c]
        if not (v and (now - v) < CFG.Revisit) then
            local d = (c.Position - hrp.Position).Magnitude
            if not bd or d < bd then best, bd = c, d end
        end
    end
    return best
end

--==================== PENDING RESOLVER ====================
local function settlePending()
    local n = #pending
    if n == 0 then return end

    local now = os.clock()
    local i = 1
    while i <= n do
        local p = pending[i]
        if isDead(p.part) then
            bump(p.part)
            table.remove(pending, i)
            n = n - 1
        elseif (now - p.at) > CFG.PickupWait then
            attempts = attempts + 1
            failStreak = failStreak + 1
            table.remove(pending, i)
            n = n - 1
        else
            i = i + 1
        end
    end

    if failStreak >= CFG.FailLimit
    and (picked - pickedAtReset) >= CFG.MinPicks then
        doReset(failStreak .. " dead picks")
    end
end

--==================== ROUND WATCHER ====================
safeLoop("round", function()
    task.wait(0.6)
    local live = #findCandy() > 0
    local now = os.clock()

    if live then
        lastSeen = now
        if not roundActive then
            roundActive = true
            firstGrab = true
            say("round live")
        end
    elseif roundActive and (now - lastSeen) > CFG.RoundGrace then
        roundActive = false
        say("round over - waiting")

        -- NEW: bag is full / round ended -> reset ONCE, then idle for the next round
        if CFG.ResetOnRoundOver and not resetting and doReset
        and (selfCount - selfAtReset) >= CFG.MinPicks then
            doReset("round over")
        end
    end
end)

--==================== SOURCE TRACKER (v3 - correlation verified) ====================
local learnedMax
local fullStreak = 0
local lastFullReason = "-"

local cands = {}
local candNextScan = 0

local activeSrc
local lockVal = 0
local verify = nil
local verifyFails = 0
local blacklist = {}
local dbgAt = 0

local function isOurs(d) return d:IsDescendantOf(gui) end
local function keyOf(c) return c.kind .. "|" .. c.name end
local function blocked(n)
    local t = blacklist[n]
    return t ~= nil and os.clock() < t
end

local KEY_SCORES = {
    candies2026 = 100, candies = 92, candy = 90,
    halloween = 72, bucket = 64, sack = 62, pumpkin = 60,
    bag = 56, treat = 54, sweet = 52,
    loot = 46, coin = 42, count = 38, amount = 36,
    capacity = 34, cap = 30, total = 28, progress = 26,
}
local function candyScore(s)
    local n = tostring(s):lower()
    local best = 0
    for k, sc in pairs(KEY_SCORES) do
        if sc > best and n:find(k, 1, true) then best = sc end
    end
    return best
end

local function parseNum(tok)
    local n, suf = tok:match("^(%d+%.?%d*)([KkMmBb]?)")
    if not n then return nil end
    local v = tonumber(n)
    if not v then return nil end
    suf = suf:upper()
    if suf == "K" then v = v * 1e3
    elseif suf == "M" then v = v * 1e6
    elseif suf == "B" then v = v * 1e9 end
    return v
end

local function extractCount(text)
    if type(text) ~= "string" then return nil end
    local t = text:gsub(",", "")
    if #t > 64 then return nil end
    local nums = {}
    for tok in t:gmatch("%d+%.?%d*[KkMmBb]?") do
        local v = parseNum(tok)
        if v then nums[#nums + 1] = v end
    end
    if #nums == 0 then return nil end
    if #nums >= 2 and t:find("/") then
        return math.floor(nums[1]), math.floor(nums[2])
    end
    return math.floor(nums[#nums]), nil
end

local function scanCands()
    local seen, out = {}, {}
    local function push(c)
        local k = keyOf(c)
        local ex = seen[k]
        if ex then
            if c.score > ex.score then
                ex.score, ex.ref, ex.max = c.score, c.ref, c.max
            end
        else
            seen[k] = c
            out[#out + 1] = c
        end
    end

    for _, h in ipairs({ { "me", lp }, { "char", lp.Character } }) do
        local obj = h[2]
        if obj then
            for k, v in pairs(obj:GetAttributes()) do
                if type(v) == "number" and candyScore(k) > 0 then
                    push({ kind = "attr", ref = k, obj = obj,
                           name = ("attr(%s):%s"):format(h[1], k),
                           score = candyScore(k) })
                end
            end
        end
    end

    for _, c in ipairs(lp:GetDescendants()) do
        if c:IsA("ValueBase") and candyScore(c.Name) > 0 then
            push({ kind = "val", ref = c, name = "val:" .. c:GetFullName(),
                   score = candyScore(c.Name) })
        end
    end

    local ls = lp:FindFirstChild("leaderstats")
    if ls then
        for _, c in ipairs(ls:GetChildren()) do
            if c:IsA("ValueBase") and candyScore(c.Name) > 0 then
                push({ kind = "val", ref = c, name = "stats:" .. c.Name,
                       score = candyScore(c.Name) + 5 })
            end
        end
    end

    for _, d in ipairs(pg:GetDescendants()) do
        if not isOurs(d) and (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
            local a, b = extractCount(d.Text)
            if a and (not b or b >= CFG.MinCap) then
                local sc = math.max(candyScore(d.Name), candyScore(d.Text))
                if sc == 0 and b and b <= 1000 and a <= b then sc = 25 end
                if sc > 0 then
                    push({ kind = "gui", ref = d, name = "gui:" .. d:GetFullName(),
                           score = sc, max = b })
                end
            end
        end
    end

    return out
end

local function readCand(c)
    if c.kind == "attr" then
        if c.obj and c.obj.Parent then
            local v = c.obj:GetAttribute(c.ref)
            if type(v) == "number" then return v end
        end
        return nil
    elseif c.kind == "val" then
        if c.ref and c.ref.Parent then return tonumber(c.ref.Value) end
        return nil
    elseif c.kind == "gui" then
        if c.ref and c.ref.Parent and c.ref.Visible then
            local a, b = extractCount(c.ref.Text)
            if b then c.max = b end
            return a
        end
        return nil
    end
end

--==================== BAG PROMPT (bottom-right counter) ====================
local bagPrompt, bagPromptAt = nil, 0
local lastPromptVal, promptMoved = nil, false
local promptTrack = setmetatable({}, { __mode = "k" })
local promptDumpAt = 0

local function nameHasBag(n)
    local s = tostring(n):lower()
    if s:find(CFG.BagName:lower(), 1, true) then return true end
    if s:find("bucket", 1, true) then return true end
    if s:find("sack", 1, true) then return true end
    if s:find("pumpkin", 1, true) then return true end
    return false
end

local function findBagPrompt()
    local now = os.clock()
    if bagPrompt and bagPrompt.Parent and (now - bagPromptAt) < 0.2 then return bagPrompt end
    bagPromptAt = now

    local selfHeld = selfCount - selfAtReset
    local best, bestScore
    local dump

    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
            local a, b = extractCount(d.Text)
            if a then
                local nm = 0
                if nameHasBag(d.Name) then
                    nm = 3
                else
                    local anc = d.Parent
                    for _i = 1, 3 do
                        if not anc or anc == pg then break end
                        if nameHasBag(anc.Name) then
                            nm = 2
                            break
                        end
                        anc = anc.Parent
                    end
                end
                if nm > 0 then
                    local tr = promptTrack[d]
                    if not tr then
                        tr = { last = a, moved = false }
                        promptTrack[d] = tr
                    elseif tr.last ~= a then
                        tr.moved = true
                        tr.last = a
                    end

                    local score = nm * 10000
                    if tr.moved then score = score + 5000 end
                    if b and CFG.BagSize > 0 and b == CFG.BagSize then score = score + 2000 end
                    if b then score = score + 100 end
                    score = score - math.min(math.abs(a - selfHeld), 400) * 4

                    if CFG.Debug then
                        dump = dump or {}
                        dump[#dump + 1] = ("[%s] txt=[%s] moved=%s score=%d")
                            :format(d:GetFullName(), tostring(d.Text), tostring(tr.moved), score)
                    end

                    if not bestScore or score > bestScore then
                        best, bestScore = d, score
                    end
                end
            end
        end
    end

    if CFG.Debug and dump and now >= promptDumpAt then
        promptDumpAt = now + 10
        print("[MM2] bag candidates:\n  " .. table.concat(dump, "\n  "))
    end

    if best and best ~= bagPrompt then
        print("[MM2] bag prompt: " .. best:GetFullName() .. "  text=" .. tostring(best.Text))
    end
    bagPrompt = best
    return best
end

local function readBagPrompt()
    local d = findBagPrompt()
    if not d or not d.Parent or not d.Visible then return nil end
    local a, b = extractCount(d.Text)
    if not a then return nil end
    if lastPromptVal ~= nil and a ~= lastPromptVal then promptMoved = true end
    lastPromptVal = a
    return a, b, "prompt:" .. d.Name
end

local function readBag()
    local pc, pm, pn = readBagPrompt()
    if pc then return pc, pm, pn end
    if activeSrc and activeSrc.cur ~= nil then
        return activeSrc.cur, activeSrc.max, activeSrc.name
    end
    local best
    for _, c in ipairs(cands) do
        if c.cur ~= nil and (not best or c.score > best.score) then best = c end
    end
    if best then return best.cur, best.max, best.name end
end

--==================== GAME LOG / OUTPUT WATCHER ====================
local logCur, logMax, logAt = nil, nil, 0
local logTotal, logTotalAt = nil, 0
local logMoved = false
local lastLogVal = nil

local function noteLog(text)
    if not CFG.UseLog then return end
    if type(text) ~= "string" then return end
    local t = text:gsub(",", "")
    if #t > 200 then return end
    local low = t:lower()

    local m1, m2 = t:match("(%d+)%s*/%s*(%d+)")
    if m1 and m2 then
        local a, b = tonumber(m1), tonumber(m2)
        if b and b >= CFG.BagMinCap and a <= b then
            if lastLogVal ~= nil and a ~= lastLogVal then logMoved = true end
            lastLogVal = a
            logCur, logMax, logAt = a, b, os.clock()
            learnedMax = b
        end
    end

    if low:find("collect", 1, true) or low:find("candies", 1, true)
    or low:find("candy", 1, true) then
        local n = low:match("(%d+)")
        if n then
            local v = tonumber(n)
            if v and v < 1e6 then logTotal, logTotalAt = v, os.clock() end
        end
    end
end

pcall(function() game:GetService("LogService").MessageOut:Connect(noteLog) end)

pcall(function()
    local tcs = game:GetService("TextChatService")
    if tcs then
        tcs.MessageReceived:Connect(function(m)
            if m and m.Text then noteLog(m.Text) end
        end)
    end
end)

pcall(function()
    for _, m in ipairs(game:GetService("LogService").History) do noteLog(m) end
end)

--==================== BAG FULL DETECTION (fallback only) ====================
local function bagIsFull()
    if not CFG.AutoReset then fullStreak = 0 return false end
    if (os.clock() - spawnedAt) < CFG.BagGrace then fullStreak = 0 return false end

    local held = picked - pickedAtReset
    local selfHeld = selfCount - selfAtReset
    if math.max(held, selfHeld) < CFG.MinPicks then fullStreak = 0 return false end

    local reason

    if CFG.UseBagGui then
        local cur, max, src = readBag()
        if cur and max and max == CFG.BagSize and promptMoved and cur >= max then
            reason = ("prompt %d/%d"):format(cur, max)
        end
    end

    if not reason and CFG.BagSize > 0 and selfHeld >= CFG.BagSize then
        reason = ("picks %d/%d"):format(selfHeld, CFG.BagSize)
    end

    if not reason and logCur and logMax and logMax == CFG.BagSize and logMoved
    and (os.clock() - logAt) < 3 and logCur >= logMax then
        reason = ("log %d/%d"):format(logCur, logMax)
    end

    if reason then
        lastFullReason = reason
        fullStreak = fullStreak + 1
        if fullStreak >= CFG.FullConfirm then
            fullStreak = 0
            return true, ("%s [self %d]"):format(reason, selfHeld)
        end
    else
        fullStreak = 0
        lastFullReason = "-"
    end

    return false
end

safeLoop("candywatch", function()
    task.wait(0.2)
    local now = os.clock()

    if now >= candNextScan then
        candNextScan = now + CFG.SourceScan
        local prev = {}
        for _, c in ipairs(cands) do prev[keyOf(c)] = c end
        local fresh = scanCands()
        for _, c in ipairs(fresh) do
            local p = prev[keyOf(c)]
            if p then
                c.prev  = p.cur or p.prev
                c.cur   = p.cur
                c.probe = p.probe
            end
        end
        cands = fresh
    end

    for _, c in ipairs(cands) do
        local v = readCand(c)
        c.cur = v
        if v ~= nil then
            if c.prev == nil then c.prev = v end
            local p = c.probe
            if not p or (now - p.t0) >= CFG.Observe then
                p = { t0 = now, s0 = selfCount, delta = 0, hits = 0, maxJump = 0, done = false }
                c.probe = p
            end
            if not p.done then
                local d = v - c.prev
                if d > 0 then
                    p.delta = p.delta + d
                    p.hits = p.hits + 1
                    if d > p.maxJump then p.maxJump = d end
                end
                if (now - p.t0) >= CFG.Observe then p.done = true end
            end
            c.prev = v
        end
    end

    local function verdict(c)
        local p = c.probe
        if not p then return false, "no probe" end
        if not p.done then return false, "observing" end
        local ds = selfCount - p.s0
        local rate = p.delta / math.max(now - p.t0, 0.5)
        if p.hits < CFG.MinHits then return false, "quiet" end
        if ds < 1 then return false, "no picks" end
        if rate > CFG.MaxRate then return false, ("rate %.1f/s"):format(rate) end
        if p.maxJump > CFG.JumpMax then return false, ("jump %d"):format(p.maxJump) end
        if p.delta < ds * CFG.CorrelLow then return false, ("low %d vs %d picks"):format(p.delta, ds) end
        if p.delta > ds * CFG.CorrelHigh + CFG.Slack then return false, ("high %d vs %d picks"):format(p.delta, ds) end
        return true, ("tracks %d picks"):format(ds)
    end

    if CFG.Debug and now >= dbgAt then
        dbgAt = now + 10
        local lines = {}
        for _, c in ipairs(cands) do
            local p = c.probe
            local rate = p and p.delta / math.max(now - p.t0, 0.5) or 0
            local ok, why = verdict(c)
            lines[#lines + 1] = ("%s v=%s rate=%.1f jump=%s delta=%s -> %s%s")
                :format(c.name, tostring(c.cur), rate,
                        p and tostring(p.maxJump) or "-",
                        p and tostring(p.delta) or "-",
                        ok and "PASS " or "fail ", why)
        end
        if #lines > 0 then
            print(("[MM2] sources (selfCount=%d):\n  "):format(selfCount)
                .. table.concat(lines, "\n  "))
        end
    end

    if not activeSrc then
        if CFG.ForceSource ~= "" then
            for _, c in ipairs(cands) do
                if c.cur ~= nil and c.name:find(CFG.ForceSource, 1, true) then
                    activeSrc, lockVal = c, c.cur
                    bagConfirmed, bagSrcLabel = true, c.name
                    verify, verifyFails = nil, 0
                    print("[MM2] forced source: " .. c.name)
                    break
                end
            end
        end
        if not activeSrc then
            local best, bs, br
            for _, c in ipairs(cands) do
                if c.cur ~= nil and not blocked(c.name) then
                    local ok, why = verdict(c)
                    if ok and c.score > (bs or -1) then best, bs, br = c, c.score, why end
                end
            end
            if best then
                activeSrc, lockVal = best, best.cur
                bagConfirmed, bagSrcLabel = true, best.name
                verify, verifyFails = nil, 0
                print(("[MM2] locked source: %s  v=%s  (%s)")
                    :format(best.name, tostring(best.cur), br))
            end
        end
    end

    if activeSrc then
        local v = activeSrc.cur
        local gone = v == nil
            or (activeSrc.kind == "val" and not (activeSrc.ref and activeSrc.ref.Parent))
            or (activeSrc.kind == "attr" and not (activeSrc.obj and activeSrc.obj.Parent))
            or (activeSrc.kind == "gui" and not (activeSrc.ref and activeSrc.ref.Parent))

        if gone then
            verifyFails = verifyFails + 1
        else
            srcPicked = math.max(0, v - lockVal)
            balance = v

            local vp = verify
            if not vp or (now - vp.t0) >= CFG.VerifyWin then
                vp = { t0 = now, last = v, s0 = selfCount, delta = 0, maxJump = 0, checked = false }
                verify = vp
            else
                local d = v - vp.last
                vp.last = v
                if d > 0 then
                    vp.delta = vp.delta + d
                    if d > vp.maxJump then vp.maxJump = d end
                end
                local ds = selfCount - vp.s0
                local elapsed = now - vp.t0
                if not vp.checked and elapsed >= 3 and ds >= 1 then
                    vp.checked = true
                    local rate = vp.delta / elapsed
                    local bad = rate > CFG.MaxRate
                        or vp.maxJump > CFG.JumpMax
                        or vp.delta > ds * CFG.CorrelHigh + CFG.Slack
                    if bad then
                        verifyFails = verifyFails + 1
                        print(("[MM2] source %s misbehaving (rate %.1f jump %d delta %d vs %d picks)")
                            :format(activeSrc.name, rate, vp.maxJump, vp.delta, ds))
                    else
                        verifyFails = math.max(0, verifyFails - 1)
                    end
                end
            end
        end

        if verifyFails >= 8 then
            print(("[MM2] dropping source %s - ignored for %ds")
                :format(activeSrc.name, CFG.Blacklist))
            blacklist[activeSrc.name] = os.clock() + CFG.Blacklist
            activeSrc, bagConfirmed = nil, false
            bagSrcLabel = "none"
            srcPicked = 0
            verify, verifyFails = nil, 0
        end
    end

    picked = shownCount()
end)

--==================== DEATH / SPAWN ====================
local function onDied()
    alive = false
    visited = {}
    pending = {}
    nearWatch = {}
    failStreak = 0
    fullStreak = 0
    clearTarget()
    say(roundActive and "dead in round - idling" or "dead - idling")
end

local function onSpawned(ch)
    spawnedAt = os.clock()
    fullStreak = 0
    pending = {}
    nearWatch = {}
    clearTarget()
    rebuildNoc(ch)
    task.spawn(function()
        local hum = ch:FindFirstChildOfClass("Humanoid") or ch:WaitForChild("Humanoid", 6)
        if not hum then return end
        if boundHum ~= hum then
            boundHum = hum
            pcall(function() hum.Died:Connect(onDied) end)
        end
    end)
end

if lp.Character then onSpawned(lp.Character) end
lp.CharacterAdded:Connect(onSpawned)

--==================== RESET ====================
doReset = function(reason)
    if resetting or not alive then return end
    resetting = true
    resetStart = os.clock()
    alive = false
    failStreak = 0
    fullStreak = 0
    resets = resets + 1
    clearTarget()
    say("bag full (" .. reason .. ") - resetting")
    print("[MM2] auto reset:", reason)

    local old = lp.Character
    pcall(function()
        local hum = old and old:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0
        elseif old then old:BreakJoints() end
    end)

    task.spawn(function()
        task.wait(4)
        if resetting and lp.Character == old then
            pcall(function() lp:LoadCharacter() end)
        end
    end)
end

--==================== FARM STEP ====================
local function farmStep()
    if not farmOn then clearTarget() task.wait(0.1) return end
    if resetting or not alive then task.wait(0.1) return end

    settlePending()
    if resetting or not alive then task.wait(0.1) return end

    local now = os.clock()

    -- pass-through pickups: a candy that died right after we brushed it counts
    for part, t in pairs(nearWatch) do
        if isDead(part) then
            if (now - t) <= 0.5 then bump(part) end
            nearWatch[part] = nil
        elseif (now - t) > 1.0 then
            nearWatch[part] = nil
        end
    end

    for k, v in pairs(visited) do
        if not k.Parent or (now - v) > 10 then visited[k] = nil end
    end

    if not roundActive then
        clearTarget()
        task.wait(0.1)
        return
    end

    local ch = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then clearTarget() task.wait(0.1) return end

    -- optional legacy bag check (off unless you flip AutoReset back on)
    local full, why = bagIsFull()
    if full then clearTarget() doReset(why) return end

    -- already chasing something?
    if curTarget then
        if not curTarget.Parent or isDead(curTarget) then
            -- it popped: count it if it died on our toes, then keep rolling
            if (hrp.Position - curTarget.Position).Magnitude <= CFG.TouchRange then
                bump(curTarget)
            end
            visited[curTarget] = now
            clearTarget()
            -- no yield here: next target launches on THIS frame
        else
            local d = (hrp.Position - curTarget.Position).Magnitude
            if d <= CFG.PickRadius and nearWatch[curTarget] == nil then
                nearWatch[curTarget] = now
            end
            if d <= 1.4 then
                if not curArriveAt then
                    curArriveAt = now
                    firePrompt(curTarget)
                elseif (now - curArriveAt) > CFG.ArriveGrace then
                    -- sitting on an unresponsive candy: log a miss and move on
                    visited[curTarget] = now
                    pending[#pending + 1] = { part = curTarget, at = now }
                    clearTarget()
                end
            end
            if curTarget then
                task.wait()  -- let the tween play, come back next frame
                return
            end
        end
    end

    -- pick + launch toward the next candy (same frame = no dead stop)
    local target = chooseTarget(hrp, now)
    if not target then
        lastGrabAt = now
        task.wait(0.1)
        return
    end

    curTarget = target
    curArriveAt = nil
    ticks = ticks + 1
    lastGrabAt = now

    local dist = (target.Position - hrp.Position).Magnitude
    if dist <= CFG.PickRadius then nearWatch[target] = now end
    local dur = math.max(dist / CFG.Tween, 0.02)
    curTween = TS:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(target.Position) })
    curTween:Play()

    task.wait()
end

safeLoop("farm", farmStep)

--==================== WATCHDOG ====================
safeLoop("watch", function()
    task.wait(0.25)

    local ch = lp.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")

    if hum then
        if boundHum ~= hum then
            boundHum = hum
            pcall(function() hum.Died:Connect(onDied) end)
        end

        local h = hum.Health > 0
        if h and not alive and (os.clock() - spawnedAt) >= CFG.Settle then
            alive = true
            resetting = false
            visited = {}
            pending = {}
            nearWatch = {}
            failStreak = 0
            fullStreak = 0
            firstGrab = true
            pickedAtReset = picked
            selfAtReset = selfCount
            promptMoved = false
            lastPromptVal = nil
            lastGrabAt = os.clock()
            clearTarget()
            say(roundActive and "alive in round - farming" or "alive - waiting for round")
        elseif not h and alive then
            alive = false
            say(roundActive and "dead in round - idling" or "dead - idling")
        end
    elseif alive then
        alive = false
    end

    if resetting and (os.clock() - resetStart) > 20 then
        resetting = false
        print("[MM2] resetting watchdog released")
    end

    if farmOn and alive and roundActive and not resetting
    and (os.clock() - lastGrabAt) > CFG.Stall then
        visited = {}
        firstGrab = true
        lastGrabAt = os.clock()
        stalls = stalls + 1
        clearTarget()
        print("[MM2] stall watchdog - cleared targets")
    end
end)

--==================== BOX ====================
local function visibleButtons()
    local out = {}
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
            out[#out + 1] = d
        end
    end
    return out
end

local function clickKeyword(kws)
    for _, b in ipairs(visibleButtons()) do
        local label = b.Name .. " "
        if b:IsA("TextButton") then label = label .. b.Text end
        label = label:lower()
        for _, k in ipairs(kws) do
            if label:find(k, 1, true) then
                pcall(function()
                    if firesignal then
                        firesignal(b.MouseButton1Click)
                    else
                        b:Activate()
                    end
                end)
                return b
            end
        end
    end
end

local RARITY_WORDS = {
    "common", "uncommon", "rare", "legendary", "godly", "chroma",
    "vintage", "unique", "ancient", "exclusive", "spooky", "cursed",
    "halloween", "epic", "mythic", "super", "limited",
}

local FAIL_WORDS = {
    "fail", "error", "cooldown", "not enough", "insufficient",
    "no candy", "no money", "locked", "wait",
}

local function looksLikeRarity(v)
    if type(v) ~= "string" then return false end
    local lv = v:lower()
    for _, w in ipairs(RARITY_WORDS) do
        if lv:find(w, 1, true) then return true end
    end
    return false
end

local function looksLikeFail(v)
    if v == false then return true end
    if type(v) == "string" then
        local lv = v:lower()
        for _, w in ipairs(FAIL_WORDS) do
            if lv:find(w, 1, true) then return true end
        end
    end
    return false
end

local function parseOpenReturn(r1, r2, r3)
    local item, rarity

    if type(r1) == "table" then
        item   = r1.Name or r1.Item or r1[1]
        rarity = r1.Rarity or r1.rarity or r1[2]
    elseif type(r1) == "string" then
        item = r1
    elseif type(r1) == "number" then
        item = r1
    end

    if not rarity then
        for _, v in ipairs({ r2, r3 }) do
            if type(v) == "table" then
                rarity = v.Rarity or v.rarity
            elseif type(v) == "string" then
                if looksLikeRarity(v) then rarity = v end
            elseif type(v) == "number" then
                rarity = v
            end
            if rarity then break end
        end
    end

    if not rarity and looksLikeRarity(r1) then
        rarity = r1
        if item == r1 then item = nil end
    end

    return item, rarity
end

local function openBox()
    if CFG.Mode == "Remote" then
        local ok, r1, r2, r3 = pcall(function()
            return OpenCrate:InvokeServer(CFG.Crate, CFG.BoxType, CFG.Pay)
        end)

        if not ok then
            return "invoke errored: " .. tostring(r1)
        end

        if r1 == nil and r2 == nil and r3 == nil then
            return "no return - open failed (check Candies2026 / crate args)"
        end

        if looksLikeFail(r1) then
            lastRarity = "-"
            print("[MM2] open failed:", tostring(r1))
            return "open failed: " .. tostring(r1)
        end

        local item, rarity = parseOpenReturn(r1, r2, r3)

        boxes = boxes + 1
        lastRarity = rarity and tostring(rarity) or "?"

        print("[MM2] rolled:", tostring(item or r1), rarity or "?")

        if item then
            return ("opened: %s%s"):format(
                tostring(item),
                rarity and (" [" .. tostring(rarity) .. "]") or "")
        end
        return "opened - rarity: " .. lastRarity
    else
        local b = clickKeyword({ "open", "unbox", "box", "crate", "halloween" })
        if b then
            boxes = boxes + 1
            return "clicked " .. b.Name
        end
        return "no matching button on screen"
    end
end

--==================== BUTTONS ====================
farmBtn.MouseButton1Click:Connect(function()
    farmOn = not farmOn
    farmBtn.Text = "Farm Candy: " .. (farmOn and "ON" or "OFF")
    local c = farmOn and T.greenD or T.panelHi
    farmBtn:SetAttribute("base", c)
    farmBtn.BackgroundColor3 = c
    farmBtn.TextColor3 = farmOn and Color3.new(1, 1, 1) or T.text
    lastGrabAt = os.clock()
    fullStreak = 0
    if not farmOn then clearTarget() end
    say(farmOn and "farming candies..." or "farm stopped")
end)

boxBtn.MouseButton1Click:Connect(function()
    local msg = openBox()
    say(msg)
    print("[MM2] " .. msg)
end)

--==================== STATS ====================
local function stateLine()
    if resetting then return "RESETTING" end
    if not roundActive then
        return alive and "no round - idle" or "no round - dead"
    end
    return alive and "IN ROUND - alive" or "IN ROUND - dead"
end

task.spawn(function()
    while task.wait(0.4) do
        local ok, err = pcall(function()
            local run = os.clock() - started
            local bagLine, frac = "reading game...", 0

            local cur, max, src = readBagPrompt()
            local tr = bagPrompt and promptTrack[bagPrompt]
            local live = (tr ~= nil and tr.moved == true)
            local selfHeld = selfCount - selfAtReset

            if cur and live then
                bagLine = (max and ("%d/%d"):format(cur, max) or tostring(cur)) .. "  " .. tostring(src or "")
                if max and max > 0 then
                    frac = math.clamp(cur / max, 0, 1)
                else
                    frac = math.clamp(cur / CFG.BagSize, 0, 1)
                end
                heroNum.Text = tostring(cur)
            else
                bagLine = (cur and ("static %d"):format(cur) or "no live bag label")
                    .. ("  self %d"):format(selfHeld)
                heroNum.Text = "~" .. tostring(selfHeld)
                frac = math.clamp(selfHeld / CFG.BagSize, 0, 1)
            end

            local age = os.clock() - lastGrabAt
            local tickAge = age < 60 and ("%.1fs ago"):format(age) or ("%.0fm ago"):format(age / 60)

            stats.Text = string.format(
                "state  : %s\nround  : %s\ntick   : %s  stalls:%d\nbag    : %s\nresets : %d  uptime:%02d:%02d  /hr:%.0f",
                stateLine(), roundActive and "active" or "none",
                tickAge, stalls,
                bagLine,
                resets, run // 60, run % 60,
                selfCount / math.max(run / 3600, 0.0001))

            heroBoxes.Text = tostring(boxes)
            heroSub.Text = ("self %d  attempts %d  this life %d")
                :format(selfCount, attempts, selfHeld)

            TS:Create(barFill, TweenInfo.new(0.3), { Size = UDim2.new(frac, 0, 1, 0) }):Play()

            dot.BackgroundColor3 = resetting and T.orange
                or (alive and roundActive and T.green or (alive and T.purple or T.red))
        end)
        if not ok then print("[MM2] stats error: " .. tostring(err)) end
    end
end)

--==================== ANTI AFK ====================
if CFG.AntiAFK then
    pcall(function()
        local cons = getconnections and getconnections(lp.Idled)
        if cons and #cons > 0 then
            for _, c in ipairs(cons) do
                pcall(function()
                    if c.Disable then c.Disable(c) elseif c.Disconnect then c.Disconnect(c) end
                end)
            end
        else
            lp.Idled:Connect(function()
                VU:CaptureController()
                VU:ClickButton2(Vector2.new())
            end)
        end
    end)
end

