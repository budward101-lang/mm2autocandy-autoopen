--============================================================
--  MM2 HALLOWEEN  ·  v4
--  Noclip float farm (constant tween 25) + Box Opener
--  RightShift = hide UI | F1 = farm | F2 = open box
--============================================================

local CFG = {
	Tween    = 25,     -- constant glide speed, no hopping
	Hold     = 0.03,
	MaxSize  = 8,
	AntiAFK  = true,

	Mode     = "Remote",          -- Remote | GUI
	Crate    = "Halloween2026Box",
	BoxType  = "MysteryBox",
	Pay      = "Candies2026",
	AutoBoxEvery = 2.5,
}

local P   = game:GetService("Players")
local RS  = game:GetService("ReplicatedStorage")
local TS  = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local RUN = game:GetService("RunService")
local VU  = game:GetService("VirtualUser")
local lp  = P.LocalPlayer

local farmOn, autoBox, picked, boxes = false, false, 0, 0
local lastRarity = "-"
local started = os.clock()
local status

print("[MM2] boot")

--==================== HELPERS ====================
local C = {
	bg      = Color3.fromRGB(15, 11, 23),
	panel   = Color3.fromRGB(25, 18, 37),
	panelHi = Color3.fromRGB(35, 25, 51),
	row     = Color3.fromRGB(33, 24, 48),
	stroke  = Color3.fromRGB(120, 82, 205),
	accent  = Color3.fromRGB(255, 150, 60),
	accent2 = Color3.fromRGB(172, 96, 255),
	green   = Color3.fromRGB(42, 172, 96),
	text    = Color3.fromRGB(236, 233, 248),
	dim     = Color3.fromRGB(158, 150, 184),
}

local function new(class, props, parent)
	local o = Instance.new(class)
	if props then
		for k, v in pairs(props) do pcall(function() o[k] = v end) end
	end
	if parent then o.Parent = parent end
	return o
end

local function grad(parent, c1, c2)
	return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = 90 }, parent)
end

local function sheen(parent)
	return new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(198, 198, 198)),
		Rotation = 90,
	}, parent)
end

local function lighten(c, amt)
	return Color3.new(math.min(c.R + amt, 1), math.min(c.G + amt, 1), math.min(c.B + amt, 1))
end

