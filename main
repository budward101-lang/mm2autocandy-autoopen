local function btn(text, order, color)
    local base = color or T.panelHi
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 42), LayoutOrder = order,
        BackgroundColor3 = base, TextColor3 = T.text,
        Font = Enum.Font.GothamBold, TextSize = 14, BorderSizePixel = 0,
        Text = text, AutoButtonColor = false, ZIndex = 4,
    }, body)
    corner(b, 10)
    local st = stroke(b, T.stroke, 1, 0.3)
    b:SetAttribute("base", base)
    local function tint(c)
        TS:Create(b, TweenInfo.new(0.14, Enum.EasingStyle.Quad), { BackgroundColor3 = c }):Play()
    end
    b.MouseEnter:Connect(function() tint(lighten(base, 0.09)) st.Transparency = 0 end)
    b.MouseLeave:Connect(function() tint(b:GetAttribute("base")) st.Transparency = 0.3 end)
    b.MouseButton1Down:Connect(function() tint(lighten(base, -0.06)) end)
    b.MouseButton1Up:Connect(function() tint(lighten(base, 0.09)) end)
    return b
end

