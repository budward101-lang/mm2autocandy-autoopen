--=============================================================
--  MM2 • HALLOWEEN 2026  —  CANDY AUTOFARM + AUTO OPEN BOX
--  Keyless LocalScript. Delta / Codex / Wave / Solara / AWP / Krnl / Xeno
--  Keys: RightShift = UI | F1 = Farm | F2 = Auto-Open | F3 = Force Open
--=============================================================

local CONFIG = {
    --========== MOVEMENT: 1 hop per second ==========
    HopInterval   = 1.0,    -- seconds between teleports. 1.0 = one hop per second
    HoverHeight   = 2.5,    -- drop onto the candy instead of inside it
    RescanTime    = 0.8,    -- rescan workspace for candy
    VerifyDelay   = 0.3,    -- wait after landing, then check if it vanished
    RetryOnMiss   = true,   -- one exact re-drop before giving up on a candy
    ClaimCooldown = 4.0,    -- seconds to ignore a candy that didn't disappear
    NearestFirst  = true,   -- target the closest candy instead of list order

    --========== CANDY DETECTION ==========
    NameFilter    = {"candy", "coin"},
    MaxSize       = 8,

    --========== AUTO OPEN ==========
    AutoFarm      = true,
    AutoOpen      = true,
    BoxCost       = 600,
    StepCooldown  = 1.5,
    RequireBalance = true,

    PinnedButtons = {
        -- "HalloweenIcon",
        -- "EventFrame.BoxBuyButton",
    },

    Keybinds = { UI = Enum.KeyCode.RightShift, Farm = Enum.KeyCode.F1,
                 Open = Enum.KeyCode.F2, Force = Enum.KeyCode.F3 },
}

local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local UIS     = game:GetService("UserInputService")
local LP      = Players.LocalPlayer

local STATE = {
    farm = CONFIG.AutoFarm, open = CONFIG.AutoOpen, force = false,
    collected = 0, hops = 0, boxes = 0, missed = 0, fresh = 0,
    moving = false,
    started = os.clock(), candy = nil, candyPath = "?", log = "starting...",
}

local claimed = {}   -- [part] = os.clock() when we gave up on it

--==================== HELPERS ====================

local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return nil end
    return c, h, r
end

local function nameMatches(name, list)
    name = name:lower()
    for _, f in ipairs(list) do
        if name:find(f, 1, true) then return true end
    end
    return false
end

local function isCandy(p)
    if not p:IsA("BasePart") then return false end
    local s = p.Size
    if math.max(s.X, s.Y, s.Z) > CONFIG.MaxSize then return false end
    if not nameMatches(p.Name, CONFIG.NameFilter) then return false end
    local m = p:FindFirstAncestorOfClass("Model")
    if m and Players:GetPlayerFromCharacter(m) then return false end
    return true
end

-- is the part still a live, visible pickup?
local function stillThere(p)
    if not p or not p.Parent then return false end
    if not p:IsDescendantOf(workspace) then return false end
    if p.Transparency >= 1 then return false end
    return true
end

local function pruneClaimed(now)
    for p, t in pairs(claimed) do
        if not p.Parent or (now - t) > CONFIG.ClaimCooldown then
            claimed[p] = nil
        end
    end
end

-- full validity gate, run immediately before every hop
local function validTarget(p, now)
    if not stillThere(p) then return false end
    if not isCandy(p) then return false end
    local c = claimed[p]
    if c and (now - c) < CONFIG.ClaimCooldown then return false end
    return true
end

local function scanCandies()
    local out = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if isCandy(d) then out[#out + 1] = d end
    end
    return out
end

--==================== MOVEMENT ====================

local function interact(part)
    for _, d in ipairs(part:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled ~= false then
            if fireproximityprompt then
                pcall(fireproximityprompt, d, 0)
            else
                pcall(function()
                    d:InputHoldBegin(); task.wait(d.HoldDuration); d:InputHoldEnd()
                end)
            end
        elseif d:IsA("ClickDetector") then
            if fireclickdetector then pcall(fireclickdetector, d) end
        end
    end
end

local function hopOnce(target, char, hrp)
    char:PivotTo(CFrame.new(target.Position + Vector3.new(0, CONFIG.HoverHeight, 0)))
    hrp.AssemblyLinearVelocity = Vector3.zero
end

-- after landing, confirm the candy actually disappeared
local function scheduleVerify(part, char, hrp)
    task.spawn(function()
        task.wait(CONFIG.VerifyDelay)

        if not stillThere(part) then
            STATE.collected += 1
            return
        end

        -- still standing: one exact re-drop before writing it off
        if CONFIG.RetryOnMiss and part.Parent then
            STATE.moving = true
            char:PivotTo(CFrame.new(part.Position))
            hrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(CONFIG.VerifyDelay)
            STATE.moving = false
        end

        if stillThere(part) then
            claimed[part] = os.clock()
            STATE.missed += 1
            STATE.log = "skip (taken): " .. part.Name
        else
            STATE.collected += 1
        end
    end)
end

--==================== FARM LOOP ====================

local function pickTarget(list, hrp, now)
    local best, bestD = nil, math.huge
    for i = 1, #list do
        local p = list[i]
        if validTarget(p, now) then
            if not CONFIG.NearestFirst then return p end
            local d = (p.Position - hrp.Position).Magnitude
            if d < bestD then best, bestD = p, d end
        end
    end
    return best
end

task.spawn(function()
    local list, lastScan, nextHop = {}, 0, 0
    while task.wait() do
        if not STATE.farm then task.wait(0.05) continue end

        local char, _, hrp = getChar()
        if not char then task.wait(0.1) continue end

        local now = os.clock()
        if now - lastScan > CONFIG.RescanTime then
            lastScan = now
            list = scanCandies()
        end
        pruneClaimed(now)

        -- drop dead and claimed entries
        local valid = {}
        for i = 1, #list do
            if validTarget(list[i], now) then valid[#valid + 1] = list[i] end
        end
        list = valid

        if now >= nextHop and not STATE.moving then
            local target = pickTarget(list, hrp, now)

            -- re-check right before committing
            if target and validTarget(target, now) then
                nextHop = now + CONFIG.HopInterval
                hopOnce(target, char, hrp)
                interact(target)
                scheduleVerify(target, char, hrp)
                STATE.hops += 1
            else
                nextHop = now + 0.25
            end
        end
    end
end)

--==================== GUI READING ====================

local function pgui() return LP:FindFirstChildOfClass("PlayerGui") end

local function chainVisible(o)
    local pg = pgui()
    local p = o
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return true
end

local function visibleButtons()
    local out = {}
    local pg = pgui(); if not pg then return out end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
            and d.Visible and chainVisible(d.Parent) then
            out[#out + 1] = d
        end
    end
    return out
end

local function buttonLabel(b)
    local t = b.Name
    if b:IsA("TextButton") then t = t .. " | " .. b.Text end
    return t
end

local function nameMatchAny(lbl, kw)
    return nameMatches(lbl, kw)
end

local function fireButton(b)
    if not b or not b.Parent then return false end
    pcall(function() b.Active = true end)

    local function viaConnections(signal)
        if not getconnections then return false end
        local n = 0
        pcall(function()
            for _, c in ipairs(getconnections(signal)) do
                if c.Enabled ~= false and c.Function then
                    n = n + 1
                    pcall(function() c.Function(b) end)
                end
            end
        end)
        return n > 0
    end

    if viaConnections(b.MouseButton1Click) then return true end
    if viaConnections(b.Activated) then return true end
    if firesignal and pcall(firesignal, b.MouseButton1Click) then return true end
    return pcall(function() b:Activate() end)
end

local function resolvePath(path)
    local node = pgui()
    for part in string.gmatch(path, "[^%.]+") do
        node = node and node:FindFirstChild(part)
    end
    return node
end

local function getCandyCount()
    for _, src in ipairs({LP, RS}) do
        for _, v in ipairs(src:GetDescendants()) do
            if (v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue"))
                and v.Name:lower():find("candy", 1, true) then
                local n = tonumber(v.Value)
                if n then return n, v:GetFullName() end
            end
        end
    end
    local pg = pgui()
    if pg then
        for _, l in ipairs(pg:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible then
                local n = tonumber((l.Text:gsub("[^%d]", "")))
                if n then
                    local anc, hit = l, false
                    while anc and anc ~= pg do
                        if anc.Name:lower():find("candy", 1, true) then hit = true break end
                        anc = anc.Parent
                    end
                    if hit then return n, l:GetFullName() end
                end
            end
        end
    end
    return nil, "not found"
end

task.spawn(function()
    while task.wait(1) do
        STATE.candy, STATE.candyPath = getCandyCount()
    end
end)

--==================== AUTO OPEN BOX ====================

local function buttonSet()
    local s = {}
    for _, b in ipairs(visibleButtons()) do s[b] = true end
    return s
end

local function countSet(s)
    local n = 0
    for _ in pairs(s) do n += 1 end
    return n
end

local function newButtonsSince(baseline)
    local out = {}
    for _, b in ipairs(visibleButtons()) do
        if not baseline[b] then out[#out + 1] = b end
    end
    return out
end

local NEGATIVE = {"close", "exit", "back", "settings", "shop", "inventory", "leaderboard"}

local function candidatePriority(b)
    local lbl = buttonLabel(b):lower()
    for _, neg in ipairs(NEGATIVE) do
        if lbl:find(neg, 1, true) then return nil end
    end
    if nameMatchAny(lbl, {"buy", "purchase", "confirm", "yes", "claim"}) then return 1 end
    if nameMatchAny(lbl, {"unbox", "open", "hatch", "spin", "roll", "use"}) then return 2 end
    if nameMatchAny(lbl, {"box", "crate", "halloween", "candy", "ember"}) then return 3 end
    return 4
end

local BASELINE = buttonSet()

local function recapture()
    BASELINE = buttonSet()
    STATE.log = "baseline: " .. countSet(BASELINE) .. " buttons"
end

local function pickOpener()
    for _, b in ipairs(visibleButtons()) do
        if BASELINE[b] and nameMatchAny(buttonLabel(b), {"halloween", "event"}) then
            return b
        end
    end
    for _, b in ipairs(visibleButtons()) do
        if nameMatchAny(buttonLabel(b), {"halloween", "event", "crate"}) then return b end
    end
end

task.spawn(function()
    local lastPress = 0
    while task.wait(0.2) do
        if not STATE.open then continue end
        if os.clock() - lastPress < CONFIG.StepCooldown then continue end

        if CONFIG.RequireBalance and not STATE.force then
            local c = STATE.candy
            if c and c < CONFIG.BoxCost then
                STATE.log = "waiting " .. c .. "/" .. CONFIG.BoxCost
                continue
            end
        end

        local fresh = newButtonsSince(BASELINE)
        STATE.fresh = #fresh

        if #fresh == 0 then
            local op = pickOpener()
            if op then
                fireButton(op)
                lastPress = os.clock()
                STATE.log = "opener: " .. op.Name
                task.wait(0.9)
                STATE.candy = getCandyCount()
            else
                STATE.log = "no opener found"
                task.wait(0.4)
            end
            continue
        end

        local best, bestP = nil, 99
        for _, b in ipairs(fresh) do
            local p = candidatePriority(b)
            if p and p < bestP then best, bestP = b, p end
        end

        if best then
            fireButton(best)
            lastPress = os.clock()
            STATE.log = "depth " .. bestP .. ": " .. best.Name
            task.wait(1.0)
            STATE.candy = getCandyCount()
        else
            STATE.log = "menu open, " .. #fresh .. " fresh, none usable"
            task.wait(0.5)
        end
    end
end)

--==================== UI ====================

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end

local gui = new("ScreenGui", {
    Name = "MM2CandyFarm", ResetOnSpawn = false,
    IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, LP:WaitForChild("PlayerGui"))

local main = new("Frame", {
    Name = "Main", Size = UDim2.new(0, 315, 0, 440),
    Position = UDim2.new(0, 20, 0, 70),
    BackgroundColor3 = Color3.fromRGB(20, 16, 28),
    BorderSizePixel = 0, Active = true,
}, gui)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, main)
new("UIStroke", { Color = Color3.fromRGB(255, 140, 40), Thickness = 1.5 }, main)

local header = new("TextLabel", {
    Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Color3.fromRGB(32, 22, 42),
    Text = "  MM2 CANDY FARM", TextColor3 = Color3.fromRGB(255, 170, 70),
    Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left,
    BorderSizePixel = 0,
}, main)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, header)

