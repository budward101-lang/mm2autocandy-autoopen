--=============================================================
--  MM2 • HALLOWEEN 2026 — CANDY AUTOFARM + AUTO OPEN BOX
--  v5.2: buy gate - only Unbox/Confirm when live balance >= BoxCost
--  Nav = SHOP (image 2) -> Halloween Box tile (image 3) -> Unbox
--  Bottom tab row (image 1) = fallback only
--=============================================================

local VERSION = "v5.2"
print("[MM2] " .. VERSION .. " starting")
print(string.format("[MM2] executor: getconnections=%s firesignal=%s fireproximityprompt=%s fireclickdetector=%s",
    tostring(getconnections ~= nil), tostring(firesignal ~= nil),
    tostring(fireproximityprompt ~= nil), tostring(fireclickdetector ~= nil)))

local function BOOT()

local stage = 0
local function mark(n) stage += 1; print(string.format("[MM2] step %02d ok - %s", stage, n)) end

local CONFIG = {
    TweenSpeed    = 20,
    SettleDelay   = 0.15,
    DwellTime     = 3.0,
    ReInteractAt  = 0.5,
    RetryDwell    = 2.0,
    RetryOnMiss   = true,
    MaxAttempts   = 3,
    ClaimCooldown = 5.0,
    HopInterval   = 0.25,
    RescanTime    = 3.0,
    ValidateTime  = 0.25,
    PruneTime     = 0.5,
    TickRate      = 0.1,
    NearestFirst  = true,

    Humanize      = true,
    JitterPct     = 0.3,
    RestAfterMin  = 15,
    RestAfterMax  = 28,
    RestMin       = 1.5,
    RestMax       = 4.5,

    NameFilter    = {"candy", "coin"},
    MaxSize       = 8,

    AutoFarm      = true,
    AutoOpen      = true,
    BoxCost       = 600,
    RequireBalance = true,         -- v5.2: the buy gate (needs balance >= BoxCost)
    CycleCooldown = 3.0,

    WalletKeywords  = {"wallet", "candy", "sweet", "balance", "currency",
                       "total", "amount", "owned", "count"},
    BalanceCheckMin = 6,
    BalanceCheckMax = 12,

    OpenMode      = "builtin",
    UseShopButton = true,
    TabFallback   = true,
    ShopKeywords  = {"shop", "store", "buy"},
    BoxTileKeywords = {"halloween box", "halloween", "mystery box", "mystery", "box"},
    EventKeywords = {"halloween", "event"},
    BoxTabIndex   = 4,
    RowYThreshold = 0.70,
    UnboxKeywords = {"unbox", "open box", "hatch", "open"},
    BuyKeywords   = {"buy", "purchase", "confirm", "600"},
    RewardKeywords = {"ok", "claim", "collect", "continue", "next",
                      "great", "nice", "yes", "awesome"},

    CloseBeforeCycle = true,
    CloseKeywords = {"close", "exit", "back", "x"},
    CloseNever    = {"backpack", "bag", "shop", "store"},

    Sequence      = {},
    SequenceDelay = 0.6,
    StepTimeout   = 3.0,

    Keybinds = { UI = Enum.KeyCode.RightShift, Farm = Enum.KeyCode.F1,
                 Open = Enum.KeyCode.F2, Force = Enum.KeyCode.F3 },
}
mark("config")

local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local UIS     = game:GetService("UserInputService")
local LP      = Players.LocalPlayer

local OWN_GUI_NAME = "MM2CandyFarm"

local LOWFILTER = {}
for i, f in ipairs(CONFIG.NameFilter) do LOWFILTER[i] = f:lower() end

local function jit(t)
    if not CONFIG.Humanize then return t end
    return t * (1 + (math.random() * 2 - 1) * CONFIG.JitterPct)
end

local STATE = {
    farm = CONFIG.AutoFarm, open = CONFIG.AutoOpen, force = false,
    collected = 0, hops = 0, boxes = 0, skipped = 0,
    started = os.clock(), candy = nil, checkedOnce = false,
    lastCheck = 0, log = "starting...", walletName = "?",
    onBoxPage = false, waiting = false,
}
local attempts, claimed = {}, {}

local candySrc, readCandy, findCandySource, probeBalance
local uiLock = false

local function pgui() return LP:FindFirstChildOfClass("PlayerGui") end

local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return nil end
    return c, h, r
end

local function isCandy(p)
    if not p:IsA("BasePart") then return false end
    local n = p.Name:lower()
    local ok = false
    for i = 1, #LOWFILTER do
        if n:find(LOWFILTER[i], 1, true) then ok = true break end
    end
    if not ok then return false end
    local s = p.Size
    if math.max(s.X, s.Y, s.Z) > CONFIG.MaxSize then return false end
    local m = p:FindFirstAncestorOfClass("Model")
    if m and Players:GetPlayerFromCharacter(m) then return false end
    return true
end

local function stillThere(p)
    if not p or not p.Parent then return false end
    if p.Transparency >= 1 then return false end
    return p:IsDescendantOf(workspace)
end

local function promptDead(p)
    for _, d in ipairs(p:GetChildren()) do
        if d:IsA("ProximityPrompt") and d.Enabled == false then return true end
    end
    return false
end

local function prune(now)
    for p, t in pairs(claimed) do
        if not p.Parent or t < now then claimed[p] = nil end
    end
    for p in pairs(attempts) do
        if not p.Parent then attempts[p] = nil end
    end
end

local candyList, candySet = {}, {}

local function rebuildCandyList()
    local out, set = {}, {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if isCandy(d) then out[#out + 1] = d; set[d] = true end
    end
    candyList, candySet = out, set
end

workspace.DescendantAdded:Connect(function(d)
    if not STATE.farm or candySet[d] then return end
    if d:IsA("BasePart") and isCandy(d) then
        candySet[d] = true
        candyList[#candyList + 1] = d
    end
end)

workspace.DescendantRemoving:Connect(function(d)
    if candySet[d] then candySet[d] = nil end
end)

local function validTarget(p, now)
    if not stillThere(p) then return false end
    local c = claimed[p]
    if c and now < c then return false end
    if (attempts[p] or 0) >= CONFIG.MaxAttempts then return false end
    return true
end

local function applyNoclip(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
end

local function clearNoclip(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.CanCollide = true
        end
    end
end

local function interact(part)
    for _, d in ipairs(part:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled ~= false then
            if fireproximityprompt then pcall(fireproximityprompt, d, d.HoldDuration) end
        elseif d:IsA("ClickDetector") then
            if fireclickdetector then pcall(fireclickdetector, d) end
        end
    end
end

local function forceTouch(target, char)
    if not getconnections or not target.Parent then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local body = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not hrp then return end
    pcall(function()
        for _, c in ipairs(getconnections(target.Touched)) do
            if c.Function then
                pcall(c.Function, hrp)
                if body then pcall(c.Function, body) end
            end
        end
    end)
end

local function glideTo(pos, char, hrp)
    if not char.Parent or not hrp.Parent then return end
    local startPos = hrp.Position
    local delta = pos - startPos
    local dist = delta.Magnitude
    if dist < 0.1 then return end

    local flat = Vector3.new(delta.X, 0, delta.Z)
    local rot = flat.Magnitude > 1
        and CFrame.lookAt(Vector3.zero, flat.Unit)
        or (hrp.CFrame - hrp.CFrame.Position)

    local duration = dist / math.max(CONFIG.TweenSpeed, 1)
    local t0 = os.clock()
    while true do
        if not char.Parent or not hrp.Parent then return end
        local a = (os.clock() - t0) / duration
        if a > 1 then a = 1 end
        hrp.CFrame = CFrame.new(startPos:Lerp(pos, a)) * rot
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if a >= 1 then break end
        task.wait()
    end
end

local function goGrab(target, char, hrp, holdFor)
    glideTo(target.Position, char, hrp)
    local rot  = hrp.CFrame - hrp.CFrame.Position
    local base = target.Position
    local t0 = os.clock()
    local nextRefire = CONFIG.ReInteractAt
    local firstDone = false

    while os.clock() - t0 < holdFor do
        if not stillThere(target) then break end
        local bob = math.sin((os.clock() - t0) * 6) * 0.4
        hrp.CFrame = CFrame.new(base + Vector3.new(0, bob, 0)) * rot
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        if not firstDone then
            firstDone = true
            interact(target); forceTouch(target, char)
        elseif (os.clock() - t0) >= nextRefire then
            nextRefire = nextRefire + CONFIG.ReInteractAt
            interact(target); forceTouch(target, char)
        end
        task.wait(0.04)
    end
    if stillThere(target) then interact(target); forceTouch(target, char) end
end

local function pickNearest(now, hrp)
    local best, bestD
    for i = 1, #candyList do
        local p = candyList[i]
        if validTarget(p, now) then
            local d = (p.Position - hrp.Position).Magnitude
            if not bestD or d < bestD then best, bestD = p, d end
        end
    end
    return best
end
mark("helpers")

task.spawn(function()
    local lastScan, lastValidate, lastPrune, nextHop = 0, 0, 0, 0
    local hopsSinceRest = 0
    local restTarget = math.random(CONFIG.RestAfterMin, CONFIG.RestAfterMax)
    local noclipChar = nil

    while task.wait(CONFIG.TickRate) do
        local char, _, hrp = getChar()

        if STATE.farm and char then
            if char ~= noclipChar then applyNoclip(char); noclipChar = char end
        elseif not STATE.farm and noclipChar then
            clearNoclip(noclipChar); noclipChar = nil
        end

        if not STATE.farm or not char then continue end

        local now = os.clock()
        if now - lastScan > CONFIG.RescanTime then
            lastScan = now
            rebuildCandyList()
        end
        if now - lastPrune > CONFIG.PruneTime then
            lastPrune = now
            prune(now)
        end
        if now - lastValidate > CONFIG.ValidateTime then
            lastValidate = now
            for i = #candyList, 1, -1 do
                if not stillThere(candyList[i]) then
                    candySet[candyList[i]] = nil
                    table.remove(candyList, i)
                end
            end
        end

        if now >= nextHop then
            local target = pickNearest(now, hrp)
            if target then
                local hopStart = os.clock()
                attempts[target] = (attempts[target] or 0) + 1
                claimed[target] = hopStart + CONFIG.DwellTime + CONFIG.RetryDwell + 1.0

                goGrab(target, char, hrp, jit(CONFIG.DwellTime))

                if CONFIG.RetryOnMiss and stillThere(target) and not promptDead(target) then
                    STATE.log = "retry: " .. target.Name
                    goGrab(target, char, hrp, jit(CONFIG.RetryDwell))
                end

                if not stillThere(target) or promptDead(target) then
                    STATE.collected += 1
                else
                    STATE.skipped += 1
                    STATE.log = "stuck: " .. target.Name
                end

                attempts[target] = CONFIG.MaxAttempts
                STATE.hops += 1
                nextHop = os.clock() + jit(CONFIG.HopInterval)

                hopsSinceRest += 1
                if hopsSinceRest >= restTarget then
                    hopsSinceRest = 0
                    restTarget = math.random(CONFIG.RestAfterMin, CONFIG.RestAfterMax)
                    local rest = CONFIG.RestMin + math.random() * (CONFIG.RestMax - CONFIG.RestMin)
                    STATE.log = string.format("rest %.1fs", rest)
                    task.wait(rest)
                end
            else
                nextHop = now + 0.2
            end
        end
    end
end)
mark("farm loop")

local function isOwnGui(o)
    local p = o
    while p do
        if p:IsA("ScreenGui") then return p.Name == OWN_GUI_NAME end
        p = p.Parent
    end
    return false
end

local function chainVisible(o)
    local pg = pgui()
    local p = o
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return true
end

local function visibleButtons()
    local out = {}
    local pg = pgui(); if not pg then return out end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
            and d.Visible and d.AbsoluteSize.X > 0 and d.AbsoluteSize.Y > 0
            and not isOwnGui(d) and chainVisible(d.Parent) then
            out[#out + 1] = d
        end
    end
    return out
end

local function buttonLabel(b)
    local t = b.Name
    if b:IsA("TextButton") then t = t .. " " .. b.Text end
    return t
end

local function labelDeep(b)
    local parts = { buttonLabel(b) }
    local n = 1
    for _, c in ipairs(b:GetChildren()) do
        if c:IsA("TextLabel") or c:IsA("TextButton") then
            parts[#parts + 1] = c.Text
            n += 1
            if n >= 5 then break end
        end
    end
    return table.concat(parts, " ")
end

local function sigOf(list)
    local parts = {}
    for i = 1, #list do parts[i] = list[i]:GetFullName() end
    return table.concat(parts, ",")
end

local function buttonSet()
    local s = {}
    for _, b in ipairs(visibleButtons()) do s[b] = true end
    return s
end

local function fireButton(b)
    if not b or not b.Parent then return false end
    pcall(function() b.Active = true end)
    local function via(sig)
        if not getconnections then return false end
        local n = 0
        pcall(function()
            for _, c in ipairs(getconnections(sig)) do
                if c.Enabled ~= false and c.Function then
                    n += 1
                    pcall(function() c.Function(b) end)
                end
            end
        end)
        return n > 0
    end
    if via(b.MouseButton1Click) then return true end
    if via(b.Activated) then return true end
    if firesignal and pcall(firesignal, b.MouseButton1Click) then return true end
    if via(b.MouseButton1Down) then return true end
    return pcall(function() b:Activate() end)
end

local function pickTopButtonAt(mx, my)
    local pg = pgui(); if not pg then return nil end
    local fallback
    for _, y in ipairs({my, my - 36}) do
        for _, o in ipairs(pg:GetGuiObjectsAtPosition(mx, y)) do
            if o:IsA("GuiButton") and o.Visible and chainVisible(o.Parent) then
                if not fallback then fallback = o end
                if getconnections and #getconnections(o.MouseButton1Click) > 0 then return o end
            end
        end
    end
    return fallback
end

local function resolvePath(path)
    local node = pgui()
    if not node then return nil end
    for part in string.gmatch(path, "[^%.]+") do
        node = node and node:FindFirstChild(part)
    end
    return node
end

local function pathFromPg(o)
    local parts, n, pg = {}, o, pgui()
    while n and n ~= pg do
        table.insert(parts, 1, n.Name)
        n = n.Parent
    end
    return table.concat(parts, ".")
end
mark("ui helpers")

local function viewportY()
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize.Y or 1080
end

local function viewportX()
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize.X or 1920
end

local function inBottomRow(b)
    return b.AbsolutePosition.Y >= viewportY() * CONFIG.RowYThreshold
end

local function bottomRow(list)
    local out = {}
    for _, b in ipairs(list) do
        if inBottomRow(b) then out[#out + 1] = b end
    end
    table.sort(out, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
    return out
end

local function findIn(list, keywords)
    for _, kw in ipairs(keywords) do
        for _, b in ipairs(list) do
            if buttonLabel(b):lower():find(kw, 1, true) then return b end
        end
    end
    return nil
end

local function findInDeep(list, keywords)
    for _, kw in ipairs(keywords) do
        for _, b in ipairs(list) do
            if labelDeep(b):lower():find(kw, 1, true) then return b end
        end
    end
    return nil
end

local function nonTabButtons()
    local out = {}
    for _, b in ipairs(visibleButtons()) do
        if not inBottomRow(b) then out[#out + 1] = b end
    end
    return out
end

local function findUnbox()
    for _, kw in ipairs(CONFIG.UnboxKeywords) do
        for _, b in ipairs(nonTabButtons()) do
            if buttonLabel(b):lower():find(kw, 1, true) then return b end
        end
    end
    return nil
end

local function waitForUnbox(timeout)
    local t0 = os.clock()
    repeat
        local b = findUnbox()
        if b then return b end
        task.wait(0.15)
    until os.clock() - t0 > timeout
    return nil
end

local function isCloseButton(b)
    local l = buttonLabel(b):lower()
    for _, bad in ipairs(CONFIG.CloseNever) do
        if l:find(bad, 1, true) then return false end
    end
    for _, kw in ipairs(CONFIG.CloseKeywords) do
        if l == kw then return true end
        if #kw > 2 and l:find(kw, 1, true) then return true end
    end
    return false
end

local function closeAll()
    STATE.onBoxPage = false
    for _ = 1, 3 do
        local vis = visibleButtons()
        local before = sigOf(vis)
        local found
        for _, b in ipairs(vis) do
            if isCloseButton(b) then found = b break end
        end
        if not found then return end
        fireButton(found)
        task.wait(jit(0.5))
        if sigOf(visibleButtons()) == before then return end
    end
end
mark("nav helpers")

local boxTabIdx, boxTabName, eventRef = nil, nil, nil
local shopSrc, boxTileSrc = nil, nil

local function clickFirst(keywords, preferBody)
    local b
    if preferBody then b = findIn(nonTabButtons(), keywords) end
    if not b then b = findIn(visibleButtons(), keywords) end
    if b then fireButton(b) end
    return b
end

local function clickEvent()
    local b = eventRef
    if not (b and b.Parent and b.Visible and chainVisible(b.Parent)) then
        b = findIn(visibleButtons(), CONFIG.EventKeywords)
        eventRef = b
    end
    if b then fireButton(b) end
    return b
end

local function findShop()
    local s = shopSrc
    if s and s.Parent and s.Visible and chainVisible(s.Parent) then return s end

    local vis = visibleButtons()
    for _, b in ipairs(vis) do
        if b.Name:lower():find("shop", 1, true) then return b end
    end
    local byLabel = findInDeep(vis, CONFIG.ShopKeywords)
    if byLabel then return byLabel end

    local vx = viewportX()
    for _, b in ipairs(vis) do
        local sz, pos = b.AbsoluteSize, b.AbsolutePosition
        if not inBottomRow(b) and pos.X > vx * 0.68
            and sz.X > 34 and sz.X < 150 and math.abs(sz.X - sz.Y) < 40 then
            print("[MM2] shop guess: " .. b.Name)
            return b
        end
    end
    return nil
end

local function clickShop()
    local b = findShop()
    if b then fireButton(b) end
    return b
end

local function findBoxTile()
    local s = boxTileSrc
    if s and s.Parent and s.Visible and chainVisible(s.Parent) then return s end
    return findInDeep(nonTabButtons(), CONFIG.BoxTileKeywords)
end

local function dismissReward()
    if findUnbox() then return false end
    for _, kw in ipairs(CONFIG.RewardKeywords) do
        for _, b in ipairs(nonTabButtons()) do
            if buttonLabel(b):lower() == kw then
                fireButton(b)
                STATE.log = "popup cleared: " .. b.Name
                task.wait(jit(0.5))
                return true
            end
        end
    end
    return false
end

-- v5.2: the buy gate. Live read off the box page when we have it, cached value
-- otherwise. Unknown balance = not affordable (park and wait, never guess).
local function affordable()
    if STATE.force then return true end
    if not CONFIG.RequireBalance then return true end
    local bal = readCandy()
    if bal then STATE.candy = bal end
    if not bal then bal = STATE.candy end
    return bal ~= nil and bal >= CONFIG.BoxCost
end

local function tabUsable(b)
    return b and b.Parent and b.Visible and chainVisible(b.Parent)
end

local function tryTab(b, label)
    if not tabUsable(b) then return nil end
    fireButton(b)
    local unbox = waitForUnbox(1.6)
    if unbox then
        STATE.log = "box tab " .. label .. ": " .. b.Name
        return unbox
    end
    return nil
end

local function reachBoxPage(beforeSet)
    local unbox = findUnbox()
    if unbox then return unbox end

    if CONFIG.UseShopButton then
        unbox = waitForUnbox(1.2)
        if unbox then STATE.log = "box page via SHOP"; return unbox end

        local tile = findBoxTile()
        if tile then
            STATE.log = "box tile: " .. tile.Name
            fireButton(tile)
            task.wait(jit(0.8))
            unbox = waitForUnbox(2.5)
            if unbox then STATE.log = "box page via SHOP>tile"; return unbox end
            STATE.log = "tile clicked - no unbox"
        else
            STATE.log = "no box tile found"
        end

        if not CONFIG.TabFallback then return nil end
        STATE.log = "SHOP path failed - trying tab row"
    end

    if boxTabIdx then
        local row = bottomRow(visibleButtons())
        local cand = row[boxTabIdx]
        if cand and (not boxTabName or cand.Name == boxTabName) then
            unbox = tryTab(cand, "(cached #" .. boxTabIdx .. ")")
            if unbox then return unbox end
        end
        boxTabIdx, boxTabName = nil, nil
    end

    local fresh = {}
    for _, b in ipairs(visibleButtons()) do
        if not beforeSet[b] then fresh[#fresh + 1] = b end
    end

    local row = bottomRow(fresh)
    if #row < CONFIG.BoxTabIndex then row = bottomRow(visibleButtons()) end

    local order = {}
    if row[CONFIG.BoxTabIndex] then order[#order + 1] = row[CONFIG.BoxTabIndex] end
    for i, b in ipairs(row) do
        if i ~= CONFIG.BoxTabIndex then order[#order + 1] = b end
    end

    for _, cand in ipairs(order) do
        if not cand.Parent then continue end
        unbox = tryTab(cand, "#" .. CONFIG.BoxTabIndex)
        if unbox then
            for i, b in ipairs(row) do
                if b == cand then boxTabIdx, boxTabName = i, cand.Name break end
            end
            return unbox
        end
    end
    return nil
end

local function unboxAndBuy(unbox)
    local before = readCandy()
    fireButton(unbox)
    task.wait(jit(1.3))

    local buy = clickFirst(CONFIG.BuyKeywords, true)
    if buy then
        STATE.log = "buy: " .. buy.Name
        task.wait(jit(1.2))
        local after = readCandy()          -- v5.2: keep the gate value fresh
        if after then STATE.candy = after
        elseif before then STATE.candy = math.max(0, before - CONFIG.BoxCost) end
        return true
    end

    task.wait(jit(1.0))
    local after = readCandy()
    if before and after and after < before then
        STATE.log = "opened (no confirm step)"
        STATE.candy = after
    else
        STATE.log = "unbox fired - no confirm found"
        if before then STATE.candy = math.max(0, before - CONFIG.BoxCost) end
    end
    return true
end

local function runBoxCycle()
    uiLock = true

    -- fast path: page already open -> gate first, then unbox
    if STATE.onBoxPage then
        if not affordable() then
            STATE.log = string.format("have %s/%d - not buying",
                STATE.candy and tostring(STATE.candy) or "?", CONFIG.BoxCost)
            STATE.waiting = true
            uiLock = false
            return false
        end
        local unbox = findUnbox()
        if not unbox and dismissReward() then unbox = waitForUnbox(1.0) end
        if unbox and unboxAndBuy(unbox) then
            STATE.boxes += 1
            STATE.waiting = false
            uiLock = false
            return true
        end
        STATE.onBoxPage = false
        STATE.log = "fast path miss - full cycle"
    end

    if CONFIG.CloseBeforeCycle then closeAll() end
    task.wait(jit(0.3))

    local before = buttonSet()
    local ev
    if CONFIG.UseShopButton then ev = clickShop() end
    if not ev and (CONFIG.TabFallback or not CONFIG.UseShopButton) then ev = clickEvent() end
    if not ev then STATE.log = "no shop/event button"; uiLock = false; return false end
    STATE.log = "nav: " .. ev.Name
    task.wait(jit(1.1))

    local unbox = reachBoxPage(before)
    if not unbox then
        STATE.log = "box page not reached"
        eventRef, shopSrc = nil, nil
        uiLock = false
        return false
    end

    -- the account total is on this page: read it, then gate on it
    candySrc = findCandySource()
    local bal = readCandy()
    if bal then
        STATE.candy = bal
        STATE.checkedOnce = true
        STATE.lastCheck = os.clock()
    end

    if not affordable() then
        STATE.log = string.format("have %s/%d - page open, waiting",
            STATE.candy and tostring(STATE.candy) or "?", CONFIG.BoxCost)
        STATE.waiting = true
        STATE.onBoxPage = true          -- stay here, next cycle re-checks
        uiLock = false
        return false
    end

    unboxAndBuy(unbox)

    STATE.boxes += 1
    STATE.waiting = false
    STATE.onBoxPage = true
    uiLock = false
    return true
end
mark("open flow")

local function waitForButton(path, timeout)
    local t0 = os.clock()
    repeat
        local b = resolvePath(path)
        if b and b.Visible and chainVisible(b.Parent) then return b end
        task.wait(0.08)
    until os.clock() - t0 > timeout
    return nil
end

local function replaySequence()
    local before = STATE.candy
    local sigBefore = sigOf(visibleButtons())
    local timedOut = 0
    for i, path in ipairs(CONFIG.Sequence) do
        local b = waitForButton(path, CONFIG.StepTimeout)
        if b then
            fireButton(b)
            STATE.log = "step " .. i .. "/" .. #CONFIG.Sequence .. "  " .. b.Name
        else
            timedOut += 1
            STATE.log = "step " .. i .. " TIMEOUT  " .. path:sub(-20)
        end
        task.wait(jit(CONFIG.SequenceDelay))
    end
    task.wait(jit(1.2))
    local after = readCandy()
    if before and after and after < before then
        STATE.boxes += 1
        if STATE.candy then STATE.candy = math.max(0, STATE.candy - CONFIG.BoxCost) end
        STATE.log = "OPENED"
    elseif timedOut > 0 then
        STATE.log = timedOut .. " step(s) never appeared"
    elseif sigOf(visibleButtons()) == sigBefore then
        STATE.log = "no UI change - wrong step order?"
    end
    if after then STATE.candy = after end
end

task.spawn(function()
    local lastCycle = 0
    while task.wait(0.5) do
        if not STATE.open then continue end
        if uiLock then continue end
        if os.clock() - lastCycle < jit(CONFIG.CycleCooldown) then continue end

        -- cheap early-out before touching any UI
        if not affordable() and not STATE.onBoxPage then
            if STATE.candy and STATE.candy < CONFIG.BoxCost then
                STATE.log = string.format("have %d/%d - waiting", STATE.candy, CONFIG.BoxCost)
                STATE.waiting = true
                lastCycle = os.clock()
                continue
            end
        end

        if CONFIG.OpenMode == "recorded" and #CONFIG.Sequence > 0 then
            if CONFIG.CloseBeforeCycle then closeAll() end
            replaySequence()
        else
            runBoxCycle()
        end
        lastCycle = os.clock()
    end
end)
mark("open loop")

local function walletPath(o)
    local parts, n, pg, depth = {}, o, pgui(), 0
    while n and n ~= pg and depth < 4 do
        parts[#parts + 1] = n.Name
        n = n.Parent
        depth += 1
    end
    return table.concat(parts, " "):lower()
end

local function matchesWallet(o)
    local n = walletPath(o)
    for _, kw in ipairs(CONFIG.WalletKeywords) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

local function scoreWallet(o)
    local n = walletPath(o)
    local s = 0
    if n:find("wallet",  1, true) then s += 120 end
    if n:find("balance", 1, true) then s += 60  end
    if n:find("total",   1, true) then s += 60  end
    if n:find("owned",   1, true) then s += 50  end
    if n:find("candy",   1, true) then s += 40  end
    if n:find("sweet",   1, true) then s += 25  end
    if n:find("collect", 1, true) then s -= 30  end
    if n:find("cost", 1, true) or n:find("price", 1, true) then s -= 40 end
    if o:IsA("TextLabel") then s += 20 end
    return s
end

readCandy = function()
    local s = candySrc
    if not s or not s.Parent then return nil end
    if s:IsA("TextLabel") or s:IsA("TextButton") then
        local t = s.Text:gsub("[^%d]", "")
        return #t > 0 and tonumber(t) or nil
    end
    return tonumber(s.Value)
end

findCandySource = function()
    local best, bestScore = nil, -math.huge
    local function consider(o, numeric)
        if not numeric or not matchesWallet(o) then return end
        if o:FindFirstAncestor(OWN_GUI_NAME) then return end
        local s = scoreWallet(o)
        if s > bestScore then best, bestScore = o, s end
    end
    local pg = pgui()
    if pg then
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("TextLabel") and o.Visible and chainVisible(o.Parent) then
                consider(o, #(o.Text:gsub("[^%d]", "")) > 0)
            end
        end
    end
    for _, root in ipairs({LP:FindFirstChild("leaderstats"), LP, RS}) do
        if root then
            for _, o in ipairs(root:GetDescendants()) do
                if o:IsA("IntValue") or o:IsA("NumberValue") or o:IsA("StringValue") then
                    consider(o, tonumber(o.Value) ~= nil)
                end
            end
        end
    end
    return best
end

probeBalance = function()
    if uiLock then return end
    uiLock = true

    local navigated = false
    if findUnbox() then
        STATE.onBoxPage = true
    else
        local before = buttonSet()
        local ev
        if CONFIG.UseShopButton then ev = clickShop() end
        if not ev and (CONFIG.TabFallback or not CONFIG.UseShopButton) then ev = clickEvent() end
        if ev then
            task.wait(jit(1.1))
            navigated = reachBoxPage(before) ~= nil
            STATE.onBoxPage = navigated
        end
    end

    candySrc = findCandySource()
    local v = readCandy()
    if v then STATE.candy = v end
    if candySrc then STATE.walletName = candySrc.Name end
    STATE.checkedOnce = true
    STATE.lastCheck = os.clock()
    STATE.log = string.format("balance %s/%d%s",
        STATE.candy and tostring(STATE.candy) or "?", CONFIG.BoxCost,
        (STATE.candy and STATE.candy >= CONFIG.BoxCost) and " OK" or " low")

    if navigated and not STATE.open and CONFIG.CloseBeforeCycle then closeAll() end
    uiLock = false
end

task.spawn(function()
    task.wait(4)
    while true do
        local gap = CONFIG.BalanceCheckMin
            + math.random() * (CONFIG.BalanceCheckMax - CONFIG.BalanceCheckMin)
        task.wait(gap)
        if os.clock() - STATE.lastCheck >= gap then probeBalance() end
    end
end)
mark("wallet")

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end

