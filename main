--[[ MM2 HALLOWEEN 2026 • CANDY AUTOFARM v3  (by Venice)
     GUI-first + on-screen error reporting. Tween speed 25. ]]

print("[MM2 v3] start")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local VirtualUser = game:GetService("VirtualUser")
local UserInputService = game:GetService("UserInputService")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

--================ UI FIRST (nothing can hide it) ================
local gui = Instance.new("ScreenGui")
gui.Name = "MM2CandyAutofarm"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
pcall(function() gui.Parent = PlayerGui end)
if not gui.Parent then pcall(function() gui.Parent = game:GetService("CoreGui") end) end
print("[MM2 v3] gui parent =", tostring(gui.Parent))

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 250, 0, 320)
frame.Position = UDim2.new(0, 12, 0, 90)
frame.BackgroundColor3 = Color3.fromRGB(22, 20, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
local stroke = Instance.new("UIStroke", frame)
stroke.Color = Color3.fromRGB(255, 140, 0)
stroke.Thickness = 1.5

local layout = Instance.new("UIListLayout", frame)
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 28)
title.BackgroundTransparency = 1
title.Text = "MM2 CANDY AUTOFARM v3"
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.TextColor3 = Color3.fromRGB(255, 160, 40)
title.LayoutOrder = 0
title.Parent = frame

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 60)
status.BackgroundTransparency = 1
status.Text = "booting..."
status.TextWrapped = true
status.Font = Enum.Font.Gotham
status.TextSize = 11
status.TextColor3 = Color3.fromRGB(160, 160, 175)
status.LayoutOrder = 99
status.Parent = frame
local function setStatus(s) status.Text = tostring(s) end

local banner = Instance.new("TextLabel")
banner.Size = UDim2.new(0, 260, 0, 32)
banner.Position = UDim2.new(0, 12, 0, 50)
banner.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
banner.Text = "SCRIPT LOADED"
banner.Font = Enum.Font.GothamBold
banner.TextSize = 13
banner.TextColor3 = Color3.fromRGB(20, 20, 20)
banner.Parent = gui
Instance.new("UICorner", banner).CornerRadius = UDim.new(0, 8)
task.delay(5, function() pcall(function() banner:Destroy() end) end)
print("[MM2 v3] UI built OK")

--================ LOGIC (error-protected) ================
local ok, err = xpcall(function()

    local CFG = {
        TweenSpeed = 25, CollectRange = 6000,
        BoxCooldown = 1.5, BoxCost = 600,
        AutoFarm = true, Noclip = true, AutoOpenBox = true, AntiAFK = true,
    }
    local STATE = "starting"

    local char, hrp
    local function bindChar(c)
        char = c
        hrp = c:WaitForChild("HumanoidRootPart", 15)
    end
    if LP.Character then bindChar(LP.Character) end
    LP.CharacterAdded:Connect(bindChar)

    local hasFTT = (typeof(firetouchinterest) == "function")
    local function fireTouch(a, b)
        if not hasFTT then return end
        pcall(function() firetouchinterest(a, b, 0); firetouchinterest(a, b, 1) end)
    end

    -- noclip
    local saved, active = {}, false
    task.spawn(function()
        while true do
            if CFG.Noclip then
                if char then
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then
                            if saved[p] == nil then saved[p] = p.CanCollide end
                            p.CanCollide = false
                        end
                    end
                end
                active = true
            elseif active then
                if char then
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") and saved[p] ~= nil then p.CanCollide = saved[p] end
                    end
                end
                saved, active = {}, false
            end
            task.wait(0.1)
        end
    end)

    -- candy
    local function getCandyList()
        local list = {}
        for _, obj in ipairs(workspace:GetChildren()) do
            local c = obj:FindFirstChild("CoinContainer") or obj:FindFirstChild("CandyContainer")
            if c then
                for _, item in ipairs(c:GetChildren()) do
                    local part = item
                    if item:IsA("Model") then
                        part = item:FindFirstChild("CoinVisual") or item:FindFirstChild("CandyVisual")
                            or item:FindFirstChildWhichIsA("BasePart")
                    end
                    if part and part:IsA("BasePart") and part.Parent then
                        table.insert(list, part)
                    end
                end
            end
        end
        return list
    end

    local function collect(part)
        if not hrp or not part or not part.Parent then return end
        pcall(function() hrp.CFrame = CFrame.new(part.Position) end)
        fireTouch(hrp, part)
        if part.Parent then fireTouch(hrp, part.Parent) end
    end

    local function farmLoop()
        while CFG.AutoFarm do
            if hrp and hrp.Parent then
                local best, bestD
                for _, part in ipairs(getCandyList()) do
                    local d = (hrp.Position - part.Position).Magnitude
                    if d <= CFG.CollectRange and (not bestD or d < bestD) then best, bestD = part, d end
                end
                if best then
                    STATE = string.format("farming (%.0f studs)", bestD)
                    local dur = math.max(bestD / math.max(CFG.TweenSpeed, 1), 0.05)
                    local tw = TweenService:Create(hrp,
                        TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = CFrame.new(best.Position) })
                    tw:Play()
                    local t0 = os.clock()
                    while CFG.AutoFarm and best.Parent
                        and tw.PlaybackState == Enum.PlaybackState.Playing
                        and (os.clock() - t0) < dur + 2 do task.wait() end
                    if tw.PlaybackState == Enum.PlaybackState.Playing then tw:Cancel() end
                    collect(best)
                    task.wait(0.05)
                else
                    STATE = "no candy (in lobby?)"
                    task.wait(0.25)
                end
            else
                STATE = "waiting for character"
                task.wait(0.3)
            end
        end
        STATE = "farm off"
    end

    -- box
    local boxRemotes
    local function findBoxRemotes()
        if boxRemotes then return boxRemotes end
        boxRemotes = {}
        local folder = ReplicatedStorage:FindFirstChild("Remotes")
        if folder then
            local r = folder:FindFirstChild("BoxOpened")
            if r and r:IsA("RemoteEvent") then table.insert(boxRemotes, r) end
        end
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = string.lower(v.Name)
                if (string.find(n, "box") or string.find(n, "crate") or string.find(n, "unbox"))
                    and not table.find(boxRemotes, v) then
                    table.insert(boxRemotes, v)
                end
            end
        end
        return boxRemotes
    end

    local function clickOpenButtons()
        for _, d in ipairs(PlayerGui:GetDescendants()) do
            if d:IsA("TextButton") and d.Visible and d.AbsoluteSize.Magnitude > 0 then
                local t = string.lower(d.Text)
                if string.find(t, "open") or string.find(t, "unbox") then
                    local c = d.AbsolutePosition + d.AbsoluteSize / 2
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0)
                        task.wait(0.03)
                        VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
                    end)
                end
            end
        end
    end

    local function getCandyCount()
        for k, v in pairs(LP:GetAttributes()) do
            if type(v) == "number" and string.find(string.lower(k), "candy") then return v end
        end
        for _, d in ipairs(LP:GetDescendants()) do
            if (d:IsA("IntValue") or d:IsA("NumberValue"))
                and string.find(string.lower(d.Name), "candy") then return d.Value end
        end
        return nil
    end

    local function openBox()
        local remotes = findBoxRemotes()
        if #remotes > 0 then
            for _, r in ipairs(remotes) do pcall(function() r:FireServer() end) end
        else
            clickOpenButtons()
        end
    end

    local function boxLoop()
        local last = 0
        while CFG.AutoOpenBox do
            if os.clock() - last >= CFG.BoxCooldown then
                local n = getCandyCount()
                if n == nil or n >= CFG.BoxCost then openBox(); last = os.clock() end
            end
            task.wait(0.1)
        end
    end

    if CFG.AntiAFK then
        LP.Idled:Connect(function()
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end)
    end

    -- toggles
    local function addToggle(text, order, get, set)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -20, 0, 32)
        b.LayoutOrder = order
        b.BackgroundColor3 = get() and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(40, 38, 50)
        b.Text = text .. (get() and ": ON" or ": OFF")
        b.TextColor3 = Color3.fromRGB(205, 205, 215)
        b.Font = Enum.Font.GothamMedium
        b.TextSize = 12
        b.Parent = frame
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
        b.MouseButton1Click:Connect(function()
            set(not get())
            local on = get()
            b.Text = text .. (on and ": ON" or ": OFF")
            b.BackgroundColor3 = on and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(40, 38, 50)
        end)
    end

    addToggle("Auto Farm Candy", 1, function() return CFG.AutoFarm end,
        function(v) CFG.AutoFarm = v; if v then task.spawn(farmLoop) end end)
    addToggle("Noclip", 2, function() return CFG.Noclip end,
        function(v) CFG.Noclip = v end)
    addToggle("Auto Open Box", 3, function() return CFG.AutoOpenBox end,
        function(v) CFG.AutoOpenBox = v; if v then task.spawn(boxLoop) end end)

    local speedRow = Instance.new("Frame")
    speedRow.Size = UDim2.new(1, -20, 0, 32)
    speedRow.BackgroundColor3 = Color3.fromRGB(40, 38, 50)
    speedRow.LayoutOrder = 4
    speedRow.Parent = frame
    Instance.new("UICorner", speedRow).CornerRadius = UDim.new(0, 7)
    local sl = Instance.new("TextLabel")
    sl.Size = UDim2.new(0.6, 0, 1, 0); sl.Position = UDim2.new(0, 10, 0, 0)
    sl.BackgroundTransparency = 1; sl.Text = "Tween speed"
    sl.TextXAlignment = Enum.TextXAlignment.Left
    sl.TextColor3 = Color3.fromRGB(205, 205, 215)
    sl.Font = Enum.Font.GothamMedium; sl.TextSize = 12; sl.Parent = speedRow
    local sb = Instance.new("TextBox")
    sb.Size = UDim2.new(0.3, 0, 0.7, 0); sb.Position = UDim2.new(0.66, 0, 0.15, 0)
    sb.BackgroundColor3 = Color3.fromRGB(25, 24, 32); sb.Text = "25"
    sb.TextColor3 = Color3.fromRGB(255, 160, 40)
    sb.Font = Enum.Font.GothamBold; sb.TextSize = 12; sb.Parent = speedRow
    Instance.new("UICorner", sb).CornerRadius = UDim.new(0, 6)
    sb.FocusLost:Connect(function()
        local n = tonumber(sb.Text)
        if n and n > 0 then CFG.TweenSpeed = n end
        sb.Text = tostring(CFG.TweenSpeed)
    end)

    task.spawn(farmLoop)
    task.spawn(boxLoop)

    task.spawn(function()
        while true do
            local n = getCandyCount()
            setStatus(string.format("state: %s\ncandy: %s | speed: %d",
                STATE, n and tostring(n) or "?", CFG.TweenSpeed))
            task.wait(0.4)
        end
    end)

    print("[MM2 v3] all systems started")

end, function(e) return tostring(e) .. "\n" .. debug.traceback() end)

if not ok then
    setStatus("ERROR:\n" .. err)
    print("[MM2 v3] ERROR:", err)
else
    setStatus("running")
end
