    Size = UDim2.new(1, -20, 1, -44), Position = UDim2.new(0, 10, 0, 40),
    BackgroundTransparency = 1,
}, main)
new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)

local stats = new("TextLabel", {
    Size = UDim2.new(1, 0, 0, 90), LayoutOrder = 1,
    BackgroundColor3 = Color3.fromRGB(28, 22, 36), BorderSizePixel = 0,
    TextColor3 = Color3.fromRGB(200, 200, 210), Font = Enum.Font.Code,
    TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top, Text = "",
}, body)
new("UICorner", { CornerRadius = UDim.new(0, 6) }, stats)
new("
