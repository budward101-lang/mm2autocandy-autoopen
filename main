--=============================================================
--  MM2 • HALLOWEEN 2026  —  CANDY AUTOFARM + AUTO OPEN BOX
--  Keyless LocalScript. Delta / Codex / Wave / Solara / AWP / Krnl / Xeno
--  Keys: RightShift = UI | F1 = Farm | F2 = Auto-Open | F3 = Force Open
--=============================================================

local CONFIG = {
    --========== MOVEMENT: 1 hop per second ==========
    HopInterval   = 1.0,
    HoverHeight   = 2.5,
    RescanTime    = 0.8,
    VerifyDelay   = 0.3,
    RetryOnMiss   = true,
    ClaimCooldown = 4.0,
    NearestFirst  = true,

    --========== CANDY DETECTION ==========
    NameFilter    = {"candy", "coin"},
    MaxSize       = 8,

    --========== AUTO OPEN ==========
    AutoFarm      = true,
    AutoOpen      = true,
    BoxCost       = 600,
    StepCooldown  = 1.5,
    RequireBalance = true,
    UseVirtualClick = true,   -- stage 3 press. disable if it misbehaves

    -- any ScreenGui whose name contains one of these is ignored entirely.
    -- add your executor's panel name here if the dump shows it.
    ExcludeGuis = {
        "MM2CandyFarm",
        "Delta", "Codex", "Wave", "Solara", "AWP", "Krnl", "Xeno",
        "ScriptBlox", "Owl", "Hydrogen", "Fluxus", "Arceus", "Vega",
    },

    PinnedButtons = {
        -- "HalloweenIcon",
        -- "EventFrame.CaseTab",
    },

    Keybinds = { UI = Enum.KeyCode.RightShift, Farm = Enum.KeyCode.F1,
                 Open = Enum.KeyCode.F2, Force = Enum.KeyCode.F3 },
}

local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local UIS     = game:GetService("UserInputService")
local VIM     = game:GetService("VirtualInputManager")
local LP      = Players.LocalPlayer

local STATE = {
    farm = CONFIG.AutoFarm, open = CONFIG.AutoOpen, force = false,
    collected = 0, hops = 0, boxes = 0, missed = 0, fresh = 0, dead = 0,
    moving = false,
    started = os.clock(), candy = nil, candyPath = "?", log = "starting...",
}

local claimed = {}
local dead = {}
local failCount = {}
local DEAD_TIME = 10
local OUR_GUI = nil

--==================== HELPERS ====================

local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return nil end
    return c, h, r
end

local function nameMatches(name, list)
    name = name:lower()
    for _, f in ipairs(list) do
        if name:find(f, 1, true) then return true end
    end
    return false
end

local function isCandy(p)
    if not p:IsA("BasePart") then return false end
    local s = p.Size
    if math.max(s.X, s.Y, s.Z) > CONFIG.MaxSize then return false end
    if not nameMatches(p.Name, CONFIG.NameFilter) then return false end
    local m = p:FindFirstAncestorOfClass("Model")
    if m and Players:GetPlayerFromCharacter(m) then return false end
    return true
end

local function stillThere(p)
    if not p or not p.Parent then return false end
    if not p:IsDescendantOf(workspace) then return false end
    if p.Transparency >= 1 then return false end
    return true
end

local function pruneClaimed(now)
    for p, t in pairs(claimed) do
        if not p.Parent or (now - t) > CONFIG.ClaimCooldown then claimed[p] = nil end
    end
end

local function validTarget(p, now)
    if not stillThere(p) then return false end
    if not isCandy(p) then return false end
    local c = claimed[p]
    if c and (now - c) < CONFIG.ClaimCooldown then return false end
    return true
end

local function scanCandies()
    local out = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if isCandy(d) then out[#out + 1] = d end
    end
    return out
end

--==================== MOVEMENT ====================

local function interact(part)
    for _, d in ipairs(part:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled ~= false then
            if fireproximityprompt then
                pcall(fireproximityprompt, d, 0)
            else
                pcall(function()
                    d:InputHoldBegin(); task.wait(d.HoldDuration); d:InputHoldEnd()
                end)
            end
        elseif d:IsA("ClickDetector") then
            if fireclickdetector then pcall(fireclickdetector, d) end
        end
    end
end

local function hopOnce(target, char, hrp)
    char:PivotTo(CFrame.new(target.Position + Vector3.new(0, CONFIG.HoverHeight, 0)))
    hrp.AssemblyLinearVelocity = Vector3.zero
end

local function scheduleVerify(part, char, hrp)
    task.spawn(function()
        task.wait(CONFIG.VerifyDelay)
        if not stillThere(part) then STATE.collected += 1 return end

        if CONFIG.RetryOnMiss and part.Parent then
            STATE.moving = true
            char:PivotTo(CFrame.new(part.Position))
            hrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(CONFIG.VerifyDelay)
            STATE.moving = false
        end

        if stillThere(part) then
            claimed[part] = os.clock()
            STATE.missed += 1
            STATE.log = "skip (taken): " .. part.Name
        else
            STATE.collected += 1
        end
    end)
end

local function pickTarget(list, hrp, now)
    local best, bestD = nil, math.huge
    for i = 1, #list do
        local p = list[i]
        if validTarget(p, now) then
            if not CONFIG.NearestFirst then return p end
            local d = (p.Position - hrp.Position).Magnitude
            if d < bestD then best, bestD = p, d end
        end
    end
    return best
end

task.spawn(function()
    local list, lastScan, nextHop = {}, 0, 0
    while task.wait() do
        if not STATE.farm then task.wait(0.05) continue end

        local char, _, hrp = getChar()
        if not char then task.wait(0.1) continue end

        local now = os.clock()
        if now - lastScan > CONFIG.RescanTime then
            lastScan = now
            list = scanCandies()
        end
        pruneClaimed(now)

        local valid = {}
        for i = 1, #list do
            if validTarget(list[i], now) then valid[#valid + 1] = list[i] end
        end
        list = valid

        if now >= nextHop and not STATE.moving then
            local target = pickTarget(list, hrp, now)
            if target and validTarget(target, now) then
                nextHop = now + CONFIG.HopInterval
                hopOnce(target, char, hrp)
                interact(target)
                scheduleVerify(target, char, hrp)
                STATE.hops += 1
            else
                nextHop = now + 0.25
            end
        end
    end
end)

--==================== GUI READING ====================

local function pgui() return LP:FindFirstChildOfClass("PlayerGui") end

local function chainVisible(o)
    local pg = pgui()
    local p = o
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return true
end

local function owningScreenGui(o)
    local s = o
    while s and not s:IsA("ScreenGui") do s = s.Parent end
    return s
end

-- true if this button belongs to our own panel or a known executor overlay
local function isForeign(o)
    if OUR_GUI and o:IsDescendantOf(OUR_GUI) then return true end
    local sg = owningScreenGui(o)
    if not sg then return false end
    local n = sg.Name:lower()
    for _, x in ipairs(CONFIG.ExcludeGuis) do
        if n:find(x:lower(), 1, true) then return true end
    end
    return false
end

-- GAME buttons only
local function gameButtons()
    local out = {}
    local pg = pgui(); if not pg then return out end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
            and d.Visible and chainVisible(d.Parent)
            and not isForeign(d) then
            out[#out + 1] = d
        end
    end
    return out
end

local function buttonLabel(b)
    local t = b.Name
    if b:IsA("TextButton") then t = t .. " | " .. b.Text end
    return t
end

local function uiSignature()
    local parts = {}
    for _, b in ipairs(gameButtons()) do
        parts[#parts + 1] = b:GetFullName()
    end
    return #parts .. ":" .. table.concat(parts, ",")
end

--==================== PRESS MECHANISMS ====================

local function signalStrategy(b)
    if not getconnections then return false end
    for _, sigName in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
        local sig = b[sigName]
        if sig then
            local conns
            pcall(function() conns = getconnections(sig) end)
            if conns then
                local live = 0
                for _, c in ipairs(conns) do
                    if c.Enabled ~= false and c.Function then live += 1 end
                end
                if live > 0 then
                    for _, c in ipairs(conns) do
                        if c.Enabled ~= false and c.Function then
                            pcall(function() c.Function(b) end)
                        end
                    end
                    return true
                end
            end
        end
    end
    return false
end

-- hides our own panel first so the synthetic click can't land on it
local function virtualClick(b)
    local wasEnabled = OUR_GUI and OUR_GUI.Enabled
    if OUR_GUI then OUR_GUI.Enabled = false end
    task.wait(0.06)

    local ok = pcall(function()
        local p, s = b.AbsolutePosition, b.AbsoluteSize
        local x, y = p.X + s.X / 2, p.Y + s.Y / 2
        VIM:SendMouseMoveEvent(x, y, false)
        task.wait(0.03)
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)

    task.wait(0.05)
    if OUR_GUI then OUR_GUI.Enabled = wasEnabled end
    return ok
end

local function pressVerified(b)
    if not b or not b.Parent then return false, "gone" end
    pcall(function() b.Active = true end)

    local base = uiSignature()

    if signalStrategy(b) then
        task.wait(0.3)
        if uiSignature() ~= base then return true, "signal" end
    end

    if firesignal then
        pcall(firesignal, b.MouseButton1Click)
        task.wait(0.25)
        if uiSignature() ~= base then return true, "firesignal" end
    end

    if CONFIG.UseVirtualClick then
        virtualClick(b)
        task.wait(0.35)
        if uiSignature() ~= base then return true, "virtualclick" end
    end

    pcall(function() b:Activate() end)
    task.wait(0.25)
    if uiSignature() ~= base then return true, "activate" end

    return false, "no effect"
end

local function isDead(b)
    local t = dead[b]
    return t and (os.clock() - t) < DEAD_TIME
end

--==================== AUTO OPEN BOX ====================

local function buttonSet()
    local s = {}
    for _, b in ipairs(gameButtons()) do s[b] = true end
    return s
end

local function countSet(s)
    local n = 0
    for _ in pairs(s) do n += 1 end
    return n
end

local function newButtonsSince(baseline)
    local out = {}
    for _, b in ipairs(gameButtons()) do
        if not baseline[b] then out[#out + 1] = b end
    end
    return out
end

local NEGATIVE = {"close", "exit"}

local function candidatePriority(b)
    local lbl = buttonLabel(b):lower()
    for _, neg in ipairs(NEGATIVE) do
        if lbl:find(neg, 1, true) then return nil end
    end
    if nameMatches(lbl, {"buy", "purchase", "confirm", "yes", "claim"}) then return 1 end
    if nameMatches(lbl, {"unbox", "open", "hatch", "spin", "roll"}) then return 2 end
    if nameMatches(lbl, {"case", "box", "crate", "halloween", "candy", "ember"}) then return 3 end
    if nameMatches(lbl, {"shop", "inventory", "store", "back", "tab"}) then return 4 end
    return 5
end

local BASELINE = nil
local function recapture()
    BASELINE = buttonSet()
    dead = {}; failCount = {}
    STATE.log = "baseline: " .. countSet(BASELINE) .. " game buttons"
end

local function pickOpener()
    for _, b in ipairs(gameButtons()) do
        if BASELINE[b] and nameMatches(buttonLabel(b), {"halloween", "event"}) then
            return b
        end
    end
    for _, b in ipairs(gameButtons()) do
        if nameMatches(buttonLabel(b), {"halloween", "event", "crate"}) then return b end
    end
end

task.spawn(function()
    local lastPress = 0
    local wasOpen = false

    while task.wait(0.2) do
        if STATE.open and not wasOpen then recapture() end
        wasOpen = STATE.open
        if not STATE.open then continue end
        if os.clock() - lastPress < CONFIG.StepCooldown then continue end

        if CONFIG.RequireBalance and not STATE.force then
            local c = STATE.candy
            if c and c < CONFIG.BoxCost then
                STATE.log = "wait
