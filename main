--=============================================================
--  MM2 • HALLOWEEN 2026  —  CANDY AUTOFARM + AUTO OPEN BOX
--  Keys: RightShift = UI | F1 = Farm | F2 = Auto-Open | F3 = Force
--  Fixed 20 studs/s + bottom-tab-row navigation (box = 4th icon)
--=============================================================

local CONFIG = {
    --========== MOVEMENT ==========
    TweenSpeed    = 20,
    SettleDelay   = 0.15,
    DwellTime     = 3.0,
    ReInteractAt  = 0.5,
    RetryDwell    = 2.0,
    RetryOnMiss   = true,
    MaxAttempts   = 3,
    ClaimCooldown = 5.0,
    HopInterval   = 0.25,
    RescanTime    = 3.0,
    ValidateTime  = 0.25,
    PruneTime     = 0.5,
    TickRate      = 0.1,
    NearestFirst  = true,

    --========== ANTI-KICK / HUMANIZER ==========
    Humanize      = true,
    JitterPct     = 0.3,
    RestAfterMin  = 15,
    RestAfterMax  = 28,
    RestMin       = 1.5,
    RestMax       = 4.5,

    --========== CANDY DETECTION ==========
    NameFilter    = {"candy", "coin"},
    MaxSize       = 8,

    --========== AUTO OPEN ==========
    AutoFarm      = true,
    AutoOpen      = true,
    BoxCost       = 600,
    RequireBalance = true,
    CycleCooldown = 3.0,
    BalanceCheckMin = 300,
    BalanceCheckMax = 600,

    --========== BOX OPEN FLOW ==========
    OpenMode      = "builtin",
    EventKeywords = {"halloween", "event"},
    BoxTabIndex   = 4,       -- 4th icon in the bottom bar = box
    RowYThreshold = 0.70,    -- bottom 30% of screen = the tab bar
    UnboxKeywords = {"unbox", "open box", "hatch", "open"},
    BuyKeywords   = {"buy", "purchase", "confirm", "600"},

    CloseBeforeCycle = true,
    CloseKeywords = {"close", "exit", "back", "x"},
    CloseNever    = {"backpack", "bag", "shop", "store"},

    Sequence      = {},
    SequenceDelay = 0.6,
    StepTimeout   = 3.0,

    Keybinds = { UI = Enum.KeyCode.RightShift, Farm = Enum.KeyCode.F1,
                 Open = Enum.KeyCode.F2, Force = Enum.KeyCode.F3 },
}

local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local UIS     = game:GetService("UserInputService")
local LP      = Players.LocalPlayer

local OWN_GUI_NAME = "MM2CandyFarm"

local LOWFILTER = {}
for i, f in ipairs(CONFIG.NameFilter) do LOWFILTER[i] = f:lower() end

local function jit(t)
    if not CONFIG.Humanize then return t end
    return t * (1 + (math.random() * 2 - 1) * CONFIG.JitterPct)
end

local STATE = {
    farm = CONFIG.AutoFarm, open = CONFIG.AutoOpen, force = false,
    collected = 0, hops = 0, boxes = 0, skipped = 0,
    started = os.clock(), candy = nil, checkedOnce = false,
    lastCheck = 0, log = "starting...",
}
local attempts, claimed = {}, {}
print("[MM2] boot")

--==================== HELPERS ====================

local function pgui() return LP:FindFirstChildOfClass("PlayerGui") end

local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return nil end
    return c, h, r
end

local function isCandy(p)
    if not p:IsA("BasePart") then return false end
    local n = p.Name:lower()
    local ok = false
    for i = 1, #LOWFILTER do
        if n:find(LOWFILTER[i], 1, true) then ok = true break end
    end
    if not ok then return false end
    local s = p.Size
    if math.max(s.X, s.Y, s.Z) > CONFIG.MaxSize then return false end
    local m = p:FindFirstAncestorOfClass("Model")
    if m and Players:GetPlayerFromCharacter(m) then return false end
    return true
end

local function stillThere(p)
    if not p or not p.Parent then return false end
    if p.Transparency >= 1 then return false end
    return p:IsDescendantOf(workspace)
end

local function promptDead(p)
    for _, d in ipairs(p:GetChildren()) do
        if d:IsA("ProximityPrompt") and d.Enabled == false then return true end
    end
    return false
end

local function prune(now)
    for p, t in pairs(claimed) do
        if not p.Parent or t < now then claimed[p] = nil end
    end
    for p in pairs(attempts) do
        if not p.Parent then attempts[p] = nil end
    end
end

--==================== CACHED CANDY TRACKING ====================

local candyList, candySet = {}, {}

local function rebuildCandyList()
    local out, set = {}, {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if isCandy(d) then out[#out + 1] = d; set[d] = true end
    end
    candyList, candySet = out, set
end

workspace.DescendantAdded:Connect(function(d)
    if not STATE.farm or candySet[d] then return end
    if d:IsA("BasePart") and isCandy(d) then
        candySet[d] = true
        candyList[#candyList + 1] = d
    end
end)

workspace.DescendantRemoving:Connect(function(d)
    if candySet[d] then candySet[d] = nil end
end)

local function validTarget(p, now)
    if not stillThere(p) then return false end
    local c = claimed[p]
    if c and now < c then return false end
    if (attempts[p] or 0) >= CONFIG.MaxAttempts then return false end
    return true
end

--==================== NOCLIP ====================

local function applyNoclip(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
end

local function clearNoclip(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.CanCollide = true
        end
    end
end

--==================== MOVEMENT ====================

local function interact(part)
    for _, d in ipairs(part:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled ~= false then
            if fireproximityprompt then
                pcall(fireproximityprompt, d, d.HoldDuration)
            end
        elseif d:IsA("ClickDetector") then
            if fireclickdetector then pcall(fireclickdetector, d) end
        end
    end
end

local function forceTouch(target, char)
    if not getconnections or not target.Parent then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local body = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not hrp then return end
    pcall(function()
        for _, c in ipairs(getconnections(target.Touched)) do
            if c.Function then
                pcall(c.Function, hrp)
                if body then pcall(c.Function, body) end
            end
        end
    end)
end

local function glideTo(pos, char, hrp)
    if not char.Parent or not hrp.Parent then return end
    local startPos = hrp.Position
    local delta = pos - startPos
    local dist = delta.Magnitude
    if dist < 0.1 then return end

    local flat = Vector3.new(delta.X, 0, delta.Z)
    local rot = flat.Magnitude > 1
        and CFrame.lookAt(Vector3.zero, flat.Unit)
        or (hrp.CFrame - hrp.CFrame.Position)

    local duration = dist / math.max(CONFIG.TweenSpeed, 1)
    local t0 = os.clock()
    while true do
        if not char.Parent or not hrp.Parent then return end
        local a = (os.clock() - t0) / duration
        if a > 1 then a = 1 end
        hrp.CFrame = CFrame.new(startPos:Lerp(pos, a)) * rot
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if a >= 1 then break end
        task.wait()
    end
end

local function goGrab(target, char, hrp, holdFor)
    glideTo(target.Position, char, hrp)

    local rot  = hrp.CFrame - hrp.CFrame.Position
    local base = target.Position
    local t0 = os.clock()
    local nextRefire = CONFIG.ReInteractAt
    local firstDone = false

    while os.clock() - t0 < holdFor do
        if not stillThere(target) then break end
        local bob = math.sin((os.clock() - t0) * 6) * 0.4
        hrp.CFrame = CFrame.new(base + Vector3.new(0, bob, 0)) * rot
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        if not firstDone then
            firstDone = true
            interact(target); forceTouch(target, char)
        elseif (os.clock() - t0) >= nextRefire then
            nextRefire = nextRefire + CONFIG.ReInteractAt
            interact(target); forceTouch(target, char)
        end
        task.wait(0.04)
    end
    if stillThere(target) then interact(target); forceTouch(target, char) end
end

--==================== FARM LOOP ====================

local function pickNearest(now, hrp)
    local best, bestD
    for i = 1, #candyList do
        local p = candyList[i]
        if validTarget(p, now) then
            local d = (p.Position - hrp.Position).Magnitude
            if not bestD or d < bestD then best, bestD = p, d end
        end
    end
    return best
end

task.spawn(function()
    local lastScan, lastValidate, lastPrune, nextHop = 0, 0, 0, 0
    local hopsSinceRest = 0
    local restTarget = math.random(CONFIG.RestAfterMin, CONFIG.RestAfterMax)
    local noclipChar = nil

    while task.wait(CONFIG.TickRate) do
        local char, _, hrp = getChar()

        if STATE.farm and char then
            if char ~= noclipChar then applyNoclip(char); noclipChar = char end
        elseif not STATE.farm and noclipChar then
            clearNoclip(noclipChar); noclipChar = nil
        end

        if not STATE.farm or not char then continue end

        local now = os.clock()
        if now - lastScan > CONFIG.RescanTime then
            lastScan = now
            rebuildCandyList()
        end
        if now - lastPrune > CONFIG.PruneTime then
            lastPrune = now
            prune(now)
        end
        if now - lastValidate > CONFIG.ValidateTime then
            lastValidate = now
            for i = #candyList, 1, -1 do
                if not stillThere(candyList[i]) then
                    candySet[candyList[i]] = nil
                    table.remove(candyList, i)
                end
            end
        end

        if now >= nextHop then
            local target = pickNearest(now, hrp)
            if target then
                local hopStart = os.clock()
                attempts[target] = (attempts[target] or 0) + 1
                claimed[target] = hopStart + CONFIG.DwellTime + CONFIG.RetryDwell + 1.0

                goGrab(target, char, hrp, jit(CONFIG.DwellTime))

                if CONFIG.RetryOnMiss and stillThere(target) and not promptDead(target) then
                    STATE.log = "retry: " .. target.Name
                    goGrab(target, char, hrp, jit(CONFIG.RetryDwell))
                end

                if not stillThere(target) or promptDead(target) then
                    STATE.collected += 1
                else
                    STATE.skipped += 1
                    STATE.log = "stuck: " .. target.Name
                end

                attempts[target] = CONFIG.MaxAttempts
                STATE.hops += 1
                nextHop = os.clock() + jit(CONFIG.HopInterval)

                hopsSinceRest += 1
                if hopsSinceRest >= restTarget then
                    hopsSinceRest = 0
                    restTarget = math.random(CONFIG.RestAfterMin, CONFIG.RestAfterMax)
                    local rest = CONFIG.RestMin + math.random() * (CONFIG.RestMax - CONFIG.RestMin)
                    STATE.log = string.format("rest %.1fs", rest)
                    task.wait(rest)
                end
            else
                nextHop = now + 0.2
            end
        end
    end
end)
print("[MM2] farm loop ok")

--==================== CANDY BALANCE (slow poll) ====================

local candySrc = nil

local function findCandySource()
    for _, src in ipairs({LP, RS}) do
        for _, v in ipairs(src:GetDescendants()) do
            if (v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue"))
                and v.Name:lower():find("candy", 1, true) then
                if tonumber(v.Value) then return v end
            end
        end
    end
    local pg = pgui()
    if pg then
        for _, l in ipairs(pg:GetDescendants()) do
            if l:IsA("TextLabel") and l.Visible then
                local a = l
                while a and a ~= pg do
                    if a.Name:lower():find("candy", 1, true) then
                        if tonumber((l.Text:gsub("[^%d]", ""))) then return l end
                        break
                    end
                    a = a.Parent
                end
            end
        end
    end
    return nil
end

local function readCandy()
    local s = candySrc
    if not s or not s.Parent then return nil end
    if s:IsA("TextLabel") then
        return tonumber((s.Text:gsub("[^%d]", "")))
    end
    return tonumber(s.Value)
end

local function doBalanceCheck()
    candySrc = findCandySource()
    STATE.candy = readCandy()
    STATE.checkedOnce = true
    STATE.lastCheck = os.clock()
    STATE.log = "balance: " .. (STATE.candy and tostring(STATE.candy) or "?") .. "/" .. CONFIG.BoxCost
end

task.spawn(function()
    task.wait(4)
    while true do
        doBalanceCheck()
        local wait = CONFIG.BalanceCheckMin
            + math.random() * (CONFIG.BalanceCheckMax - CONFIG.BalanceCheckMin)
        task.wait(wait)
    end
end)

--==================== UI HELPERS ====================

local function isOwnGui(o)
    local p = o
    while p do
        if p:IsA("ScreenGui") then return p.Name == OWN_GUI_NAME end
        p = p.Parent
    end
    return false
end

local function chainVisible(o)
    local pg = pgui()
    local p = o
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return true
end

local function visibleButtons()
    local out = {}
    local pg = pgui(); if not pg then return out end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
            and d.Visible and d.AbsoluteSize.X > 0 and d.AbsoluteSize.Y > 0
            and not isOwnGui(d)
            and chainVisible(d.Parent) then
            out[#out + 1] = d
        end
    end
    return out
end

local function buttonLabel(b)
    local t = b.Name
    if b:IsA("TextButton") then t = t .. " " .. b.Text end
    return t
end

local function sigOf(list)
    local parts = {}
    for i = 1, #list do parts[i] = list[i]:GetFullName() end
    return table.concat(parts, ",")
end

local function buttonSet()
    local s = {}
    for _, b in ipairs(visibleButtons()) do s[b] = true end
    return s
end

local function fireButton(b)
    if not b or not b.Parent then return false end
    pcall(function() b.Active = true end)
    local function via(sig)
        if not getconnections then return false end
        local n = 0
        pcall(function()
            for _, c in ipairs(getconnections(sig)) do
                if c.Enabled ~= false and c.Function then
                    n += 1
                    pcall(function() c.Function(b) end)
                end
            end
        end)
        return n > 0
    end
    if via(b.MouseButton1Click) then return true end
    if via(b.Activated) then return true end
    if firesignal and pcall(firesignal, b.MouseButton1Click) then return true end
    if via(b.MouseButton1Down) then return true end
    return pcall(function() b:Activate() end)
end

local function resolvePath(path)
    local node = pgui()
    if not node then return nil end
    for part in string.gmatch(path, "[^%.]+") do
        node = node and node:FindFirstChild(part)
    end
    return node
end

local function pathFromPg(o)
    local parts, n, pg = {}, o, pgui()
    while n and n ~= pg do
        table.insert(parts, 1, n.Name)
        n = n.Parent
    end
    return table.concat(parts, ".")
end

--==================== BOTTOM TAB ROW ====================

local function viewportY()
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize.Y or 1080
end

local function inBottomRow(b)
    return b.AbsolutePosition.Y >= viewportY() * CONFIG.RowYThreshold
end

-- the tab bar only: bottom strip, ordered left to right
local function bottomRow(list)
    local out = {}
    for _, b in ipairs(list) do
        if inBottomRow(b) then out[#out + 1] = b end
    end
    table.sort(out, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
    return out
end

local function findIn(list, keywords)
    for _, kw in ipairs(keywords) do
        for _, b in ipairs(list) do
            if buttonLabel(b):lower():find(kw, 1, true) then return b end
        end
    end
    return nil
end

-- an unbox/open button lives in the page body, NOT in the tab bar
local function findUnbox()
    local vis = visibleButtons()
    for _, kw in ipairs(CONFIG.UnboxKeywords) do
        for _, b in ipairs(vis) do
            if not inBottomRow(b) and buttonLabel(b):lower():find(kw, 1, true) then
                return b
            end
        end
    end
    return nil
end

local function waitForUnbox(timeout)
    local t0 = os.clock()
    repeat
        local b = findUnbox()
        if b then return b end
        task.wait(0.15)
    until os.clock() - t0 > timeout
    return nil
end

--==================== CLOSE / BACK ====================

local function isCloseButton(b)
    local l = buttonLabel(b):lower()
    for _, bad in ipairs(CONFIG.CloseNever) do
        if l:find(bad, 1, true) then return false end
    end
    for _, kw in ipairs(CONFIG.CloseKeywords) do
        if l == kw then return true end
        if #kw > 2 and l:find(kw, 1, true) then return true end
    end
    return false
end

local function closeAll()
    for _ = 1, 3 do
        local vis = visibleButtons()
        local before = sigOf(vis)
        local found
        for _, b in ipairs(vis) do
            if isCloseButton(b) then found = b break end
        end
        if not found then return end
        fireButton(found)
        task.wait(jit(0.5))
        if sigOf(visibleButtons()) == before then return end
    end
end

--==================== BOX OPEN FLOW ====================

local function clickFirst(keywords)
    local b = findIn(visibleButtons(), keywords)
    if b then fireButton(b) end
    return b
end

local function reachBoxPage(beforeSet)
    if findUnbox() then return findUnbox() end

    -- candidates = new buttons in the bottom bar; fall back to the whole bar
    local fresh = {}
    for _, b in ipairs(visibleButtons()) do
        if not beforeSet[b] then fresh[#fresh + 1] = b end
    end

    local row = bottomRow(fresh)
    if #row < CONFIG.BoxTabIndex then
        row = bottomRow(visibleButtons())
    end

    print("[MM2] bottom tab row (" .. #row .. "):")
    for i, b in ipairs(row) do
        print(string.format("  %d) x=%4d  %-24s | %s",
            i, math.floor(b.AbsolutePosition.X), b.Name, buttonLabel(b)))
    end

    -- configured index first, then the rest of the row
    local order = {}
    if row[CONFIG.BoxTabIndex] then order[#order + 1] = row[CONFIG.BoxTabIndex] end
    for i, b in ipairs(row) do
        if i ~= CONFIG.BoxTabIndex then order[#order + 1] = b end
    end

    for _, cand in ipairs(order) do
        if not cand.Parent then continue end
        fireButton(cand)
        local unbox = waitForUnbox(1.6)
        if unbox then
            STATE.log = "box tab #" .. CONFIG.BoxTabIndex .. ": " .. cand.Name
            print("[MM2] box page reached via: " .. cand.Name)
            return unbox
        end
    end
    return nil
end

local function runBoxCycle()
    if CONFIG.CloseBeforeCycle then closeAll() end
    task.wait(jit(0.3))

    local before = buttonSet()
    local ev = clickFirst(CONFIG.EventKeywords)
    if not ev then STATE.log = "no event button"; return false end
    STATE.log = "event: " .. ev.Name
    task.wait(jit(1.1))

    local unbox = reachBoxPage(before)
    if not unbox then
        STATE.log = "box page not reached"
        return false
    end

    fireButton(unbox)
    STATE.log = "unbox: " .. unbox.Name
    task.wait(jit(1.3))

    local buy = clickFirst(CONFIG.BuyKeywords)
    if buy then
        STATE.log = "buy: " .. buy.Name
        task.wait(jit(1.2))
    end

    STATE.boxes += 1
    if STATE.candy then STATE.candy = math.max(0, STATE.candy - CONFIG.BoxCost) end
    return true
end

--==================== RECORDED SEQUENCE (optional) ====================

local function waitForButton(path, timeout)
    local t0 = os.clock()
    repeat
        local b = resolvePath(path)
        if b and b.Visible and chainVisible(b.Parent) then return b end
        task.wait(0.08)
    until os.clock() - t0 > timeout
    return nil
end

local function replaySequence()
    local before = STATE.candy
    local sigBefore = sigOf(visibleButtons())
    local timedOut = 0

    for i, path in ipairs(CONFIG.Sequence) do
        local b = waitForButton(path, CONFIG.StepTimeout)
        if b then
            fireButton(b)
            STATE.log = "step " .. i .. "/" .. #CONFIG.Sequence .. "  " .. b.Name
        else
            timedOut += 1
            STATE.log = "step " .. i .. " TIMEOUT  " .. path:sub(-20)
        end
        task.wait(jit(CONFIG.SequenceDelay))
    end

    task.wait(jit(1.2))
    local after = readCandy()
    if before and after and after < before then
        STATE.boxes += 1
        if STATE.candy then STATE.candy = math.max(0, STATE.candy - CONFIG.BoxCost) end
        STATE.log = "OPENED"
    elseif timedOut > 0 then
        STATE.log = timedOut .. " step(s) never appeared"
    elseif sigOf(visibleButtons()) == sigBefore then
        STATE.log = "no UI change - wrong step order?"
    end
    if after then STATE.candy = after end
end

--==================== AUTO OPEN LOOP ====================

task.spawn(function()
    local lastCycle = 0
    while task.wait(0.5) do
        if not STATE.open then continue end
        if os.clock() - lastCycle < jit(CONFIG.CycleCooldown) then continue end

        if CONFIG.RequireBalance and not STATE.force then
            if not STATE.checkedOnce then continue end
            local c = STATE.candy
            if c and c < CONFIG.BoxCost then
                STATE.log = string.format("balance %d/%d - waiting", c, CONFIG.BoxCost)
                continue
            end
        end

        if CONFIG.OpenMode == "recorded" and #CONFIG.Sequence > 0 then
            if CONFIG.CloseBeforeCycle then closeAll() end
            replaySequence()
        else
            runBoxCycle()
        end
        lastCycle = os.clock()
    end
end)
print("[MM2] open loop ok")

--==================== UI ====================

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end

local gui = new("ScreenGui", {
    Name = OWN_GUI_NAME, ResetOnSpawn = false, IgnoreGuiInset = true,
}, LP:WaitForChild("PlayerGui"))

local main = new("Frame", {
    Size = UDim2.new(0, 305, 0, 610), Position = UDim2.new(0, 20, 0, 55),
    BackgroundColor3 = Color3.fromRGB(20, 16, 28), BorderSizePixel = 0, Active = true,
}, gui)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, main)
new("UIStroke", { Color = Color3.fromRGB(255, 140, 40), Thickness = 1.5 }, main)

local header = new("TextLabel", {
    Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Color3.fromRGB(32, 22, 42),
    Text = "  MM2 CANDY FARM", TextColor3 = Color3.fromRGB(255, 170, 70),
    Font = Enum.Font.GothamBold, TextSize = 15,
    TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0,
}, main)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, header)

local body = new("Frame", {
    Size = UDim2.new(1, -20, 1, -42), Position = UDim2.new(0, 10, 0, 38),
    BackgroundTransparency = 1,
}, main)
new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, body)

local stats = new("TextLabel", {
    Size = UDim2.new(1, 0, 0, 92), LayoutOrder = 1,
    BackgroundColor3 = Color3.fromRGB(28, 22, 36), BorderSizePixel = 0,
    TextColor3 = Color3.fromRGB(200, 200, 210), Font = Enum.Font.Code,
    TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top, Text = "",
}, body)
new("UICorner", { CornerRadius = UDim.new(0, 6) }, stats)
new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8) }, stats)

local function mkBtn(order, text, color, h)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, h or 26), LayoutOrder = order,
        BackgroundColor3 = color, Text = text,
        TextColor3 = Color3.fromRGB(230, 230, 235),
        Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0,
    }, body)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
    return b
end

local function makeToggle(order, text, getter, setter)
    local b = mkBtn(order, "", Color3.fromRGB(35, 28, 45))
    local function refresh()
        b.Text = text .. ": " .. (getter() and "ON" or "OFF")
        b.TextColor3 = getter() and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(255, 110, 110)
    end
    b.MouseButton1Click:Connect(function() setter(not getter()); refresh() end)
    refresh()
end

makeToggle(2, "Candy Autofarm", function() return STATE.farm end, function(v) STATE.farm = v end)
makeToggle(3, "Auto Open Box", function() return STATE.open end, function(v) STATE.open = v end)
makeToggle(4, "Anti-kick (humanize)",
    function() return CONFIG.Humanize end, function(v) CONFIG.Humanize = v end)

mkBtn(5, "Check balance now", Color3.fromRGB(40, 60, 45))
    .MouseButton1Click:Connect(function() doBalanceCheck() end)

local TABS = {1, 2, 3, 4, 5, 6, 7, 8}
local tabBtn = mkBtn(6, "", Color3.fromRGB(50, 42, 30))
local function refreshTab()
    tabBtn.Text = string.format("Bottom tab #%d  (click to change)", CONFIG.BoxTabIndex)
end
tabBtn.MouseButton1Click:Connect(function()
    local idx = 1
    for i, v in ipairs(TABS) do
        if v == CONFIG.BoxTabIndex then idx = i break end
    end
    idx = idx % #TABS + 1
    CONFIG.BoxTabIndex = TABS[idx]
    refreshTab()
    STATE.log = "bottom tab #" .. CONFIG.BoxTabIndex
end)
refreshTab()

local modeBtn = mkBtn(7, "", Color3.fromRGB(45, 40, 55))
local function refreshMode()
    modeBtn.Text = "Open flow: " .. (CONFIG.OpenMode == "builtin" and "built-in" or "recorded")
        .. "  (click to change)"
end
modeBtn.MouseButton1Click:Connect(function()
    CONFIG.OpenMode = CONFIG.OpenMode == "builtin" and "recorded" or "builtin"
    refreshMode()
    STATE.log = "open flow: " .. CONFIG.OpenMode
end)
refreshMode()

local DWELLS = {1.0, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0, 6.0}
local dwellBtn = mkBtn(8, "", Color3.fromRGB(50, 42, 30))
local function refreshDwell()
    dwellBtn.Text = string.format("Stand on candy: %.1fs  (click to change)", CONFIG.DwellTime)
end
dwellBtn.MouseButton1Click:Connect(function()
    local idx = 1
    for i, v in ipairs(DWELLS) do
        if math.abs(v - CONFIG.DwellTime) < 0.01 then idx = i break end
    end
    idx = idx % #DWELLS + 1
    CONFIG.DwellTime = DWELLS[idx]
    CONFIG.ReInteractAt = math.min(CONFIG.DwellTime * 0.3, 0.6)
    refreshDwell()
    STATE.log = "dwell " .. CONFIG.DwellTime .. "s"
end)
refreshDwell()

--==================== STEP RECORDER ====================

local picking = false

local function pickTopButton()
    local pg = pgui()
    local m = UIS:GetMouseLocation()
    local fallback
    for _, y in ipairs({m.Y, m.Y - 36}) do
        for _, o in ipairs(pg:GetGuiObjectsAtPosition(m.X, y)) do
            if o:IsA("GuiButton") and o.Visible and chainVisible(o.Parent) then
                if not fallback then fallback = o end
                if getconnections and #getconnections(o.MouseButton1Click) > 0 then
                    return o
                end
            end
        end
    end
    return fallback
end

local function printSteps()
    print("===== RECORDED STEPS (" .. #CONFIG.Sequence .. ") =====")
    for i, p in ipairs(CONFIG.Sequence) do print("  " .. i .. ") " .. p) end
    print("    Sequence = {")
    for _, p in ipairs(CONFIG.Sequence) do print('        "' .. p .. '",') end
    print("    },")
end

local function addStep()
    if picking then return end
    picking = true
    local conn
    local function cleanup()
        picking = false
        if conn then conn:Disconnect() end
    end
    task.delay(8, function()
        if picking then cleanup(); STATE.log = "pick timed out" end
    end)

    conn = UIS.InputBegan:Connect(function(i, gp)
        if not picking or gp then return end
        if i.UserInputType ~= Enum.UserInputType.MouseButton1
            and i.UserInputType ~= Enum.UserInputType.Touch then return end
        cleanup()
        task.wait(0.05)
        local b = pickTopButton()
        if not b then STATE.log = "no button there"; return end
        CONFIG.Sequence[#CONFIG.Sequence + 1] = pathFromPg(b)
        STATE.log = "step " .. #CONFIG.Sequence .. ": " .. b.Name
        printSteps()
    end)
end

mkBtn(9, "ADD STEP  (click button in game)", Color3.fromRGB(30, 65, 40), 30)
    .MouseButton1Click:Connect(addStep)

mkBtn(10, "Remove last step", Color3.fromRGB(55, 45, 35))
    .MouseButton1Click:Connect(function()
        if #CONFIG.Sequence == 0 then STATE.log = "nothing to remove"; return end
        local removed = table.remove(CONFIG.Sequence)
        STATE.log = "removed: " .. removed:sub(-22)
        printSteps()
    end)

do
    local dragging, startPos, startInput
    header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; startInput = i.Position; startPos = main.Position
        end
    end)
    header.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startInput
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

task.spawn(function()
    local lastText = ""
    while task.wait(0.5) do
        local run = os.clock() - STATE.started
        local since = STATE.lastCheck > 0
            and string.format("%dm%02ds", math.floor((os.clock() - STATE.lastCheck) / 60),
                math.floor((os.clock() - STATE.lastCheck) % 60))
            or "never"
        local txt = string.format(
            "picked  : %d   skipped: %d\nhops    : %d  (%.2f/s)\ntime    : %02d:%02d\nboxes   : %d   steps: %d\nbalance : %s (checked %s ago)\nflow    : %s   tab #%d\nlog     : %s",
            STATE.collected, STATE.skipped, STATE.hops,
            STATE.hops / math.max(run, 0.001),
            math.floor(run / 60), math.floor(run % 60),
            STATE.boxes, #CONFIG.Sequence,
            STATE.candy and tostring(STATE.candy) or "?", since,
            CONFIG.OpenMode, CONFIG.BoxTabIndex,
            (STATE.log or ""):sub(1, 30))
        if txt ~= lastText then
            lastText = txt
            stats.Text = txt
        end
    end
end)

UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == CONFIG.Keybinds.UI then main.Visible = not main.Visible
    elseif i.KeyCode == CONFIG.Keybinds.Farm then STATE.farm = not STATE.farm
    elseif i.KeyCode == CONFIG.Keybinds.Open then STATE.open = not STATE.open
    elseif i.KeyCode == CONFIG.Keybinds.Force then STATE.force = not STATE.force end
end)

print("[MM2 Candy Farm] loaded — RightShift UI | F1 farm | F2 open | F3 force")
