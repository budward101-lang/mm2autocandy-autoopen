--============================================================
-- MM2 HALLOWEEN - Candy Autofarm + Halloween Box Opener
-- Noclip | TweenSpeed 25 | core APIs only
-- RightShift = hide/show UI | F1 = farm | F2 = box
--============================================================

local CFG = {
    Tween = 25, -- studs per second
    Hold = 0.05, -- settle on a candy
    Revisit = 2.5, -- secs before a candy can be picked again
    Radius = 120, -- outer pick range
    BandMin = 20, -- preferred pick band: min studs
    BandMax = 40, -- preferred pick band: max studs
    MaxSize = 8, -- ignore map parts bigger than this
    AntiAFK = true,
    Mode = "Remote", -- Remote | GUI
    Crate = "Halloween2026Box", -- arg 1 (captured from OpenCrate)
    BoxType = "MysteryBox", -- arg 2
    Pay = "Candies2026", -- arg 3 (currency)

    -- full bag handling
    AutoReset = true, -- reset character when the bag is full
    BagSize = 0, -- 0 = auto detect. Set to your bag cap (e.g. 50) to force it
    UseBagGui = true, -- read the counter off attributes / values / GUI
    UseBanner = false, -- extra "bag full" text check (fuzzy, off by default)
    MinCap = 5, -- ignore x/y labels whose capacity is smaller than this
    MinPicks = 3, -- must bank this many this life before a reset can trip
    FullConfirm = 3, -- consecutive full readings needed before resetting
    BagGrace = 2.5, -- secs after spawn before bag resets are allowed
    FailLimit = 10, -- last-resort: consecutive dead picks = bag full
    Settle = 0.8, -- grace after respawn before farming again
    RoundGrace = 3, -- secs of no candies before a round counts as over
    Stall = 10, -- secs of no grabs = clear targets and retarget
    TweenSlack = 1.5, -- extra secs before a glide is declared stuck
    PickupWait = 0.6, -- max secs to wait for a pickup to register

    -- PERF TUNING
    CandyTTL = 0.12, -- reuse a candy scan this long (secs)
    SourceScan = 1.5, -- how often to re-scan candidate counter sources
    ContainerRetry = 1.0, -- min secs between CoinContainer re-searches

    -- SOURCE TRUST
    Debug       = true,  -- print a verdict table for every candidate every 10s
    ForceSource = "",    -- set to a substring of a source name to hard-pin it
    Observe     = 8,     -- secs a candidate must prove itself before locking
    VerifyWin   = 10,    -- sliding window for the post-lock re-verify
    MaxRate     = 12,    -- reject sources ticking faster than this /s
    JumpMax     = 25,    -- reject sources with single-tick jumps bigger than this
    MinHits     = 2,     -- must tick at least this many times in the window
    CorrelLow   = 0.5,   -- source delta must be >= selfDelta * this
    CorrelHigh  = 3.0,   -- ...and <= selfDelta * this + Slack
    Slack       = 8,     -- hard headroom over the confirmed pickup count
    Blacklist   = 30,    -- secs a dropped source is ignored
}

