    TextYAlignment = Enum.TextYAlignment.Top, Text = "waiting for a round",
}, body)

local function say(s) status.Text = tostring(s) end

--==================== DRAG + KEYS ====================
do
    local drag, from, origin
    head.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag, from, origin = true, i.Position, win.Position
        end
    end)
    head.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - from
            win.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X,
                origin.Y.Scale, origin.Y.Offset + d.Y)
        end
    end)
    UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.RightShift then
            win.Visible = not win.Visible
        elseif i.KeyCode == Enum.KeyCode.F1 then
            farmBtn.MouseButton1Click:Fire()
        elseif i.KeyCode == Enum.KeyCode.F2 then
            boxBtn.MouseButton1Click:Fire()
        elseif i.KeyCode == Enum.KeyCode.F3 then
            resetBtn.MouseButton1Click:Fire()
        elseif i.KeyCode == Enum.KeyCode.F4 then
            learnBtn.MouseButton1Click:Fire()
        end
    end)
end

--==================== CORE STATE ====================
local alive = true
local boundHum
local roundActive = false
local lastSeen = 0

local visited = {}
local firstGrab = true
local resetting, resets, failStreak, pickedAtReset = false, 0, 0, 0
local resetStart = 0
local spawnedAt = os.clock() - 10
local lastGrabAt = os.clock()
local ticks, stalls = 0, 0
local lastResetReason = "-"

--==================== NOCLIP ====================
RUN.Stepped:Connect(function()
    if not alive then return end
    local ch = lp.Character
    if not ch then return end
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
    end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end)

--==================== CANDY ====================
local function isCandy(d)
    if not d:IsA("BasePart") then return false end
    if d.Transparency >= 0.99 then return false end
    if d.CanTouch == false then return false end
    local id = d:GetAttribute("CoinID")
    if id then return id == "Candy" end
    local n = d.Name:lower()
    if not (n:find("candy", 1, true) or n:find("coin", 1, true)) then return false end
    local s = d.Size
    if math.max(s.X, s.Y, s.Z) > CFG.MaxSize then return false end
    local m = d:FindFirstAncestorOfClass("Model")
    if m and P:GetPlayerFromCharacter(m) then return false end
    return true
end

local function findCandy()
    local scope = workspace:FindFirstChild("CoinContainer", true) or workspace
    local out = {}
    for _, d in ipairs(scope:GetDescendants()) do
        if isCandy(d) then out[#out + 1] = d end
    end
    return out
end

local function grab(part, hrp)
    if not part or not part.Parent or not hrp or not hrp.Parent then return "gone" end

    local dist = (part.Position - hrp.Position).Magnitude
    local dur = math.max(dist / CFG.Tween, 0.02)
    local tw = TS:Create(hrp,
        TweenInfo.new(dur, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(part.Position) })

    local done = false
    local conn = tw.Completed:Connect(function() done = true end)
    tw:Play()

    local t0 = os.clock()
    while not done and (os.clock() - t0) < (dur + CFG.TweenSlack) do
        if not hrp.Parent or not part.Parent then break end
        local cur = lp.Character
        if not cur or cur:FindFirstChild("HumanoidRootPart") ~= hrp then break end
        task.wait(0.03)
    end
    pcall(function() conn:Disconnect() end)
    if not done then pcall(function() tw:Cancel() end) end

    if not part.Parent then return "gone" end
    task.wait(CFG.Hold)
    if not part.Parent then return "gone" end

    for _, x in ipairs(part:GetDescendants()) do
        if x:IsA("ProximityPrompt") then
            pcall(function()
                if fireproximityprompt then
                    fireproximityprompt(x)
                else
                    x:InputHoldBegin(); task.wait(x.HoldDuration); x:InputHoldEnd()
                end
            end)
        elseif x:IsA("ClickDetector") and fireclickdetector then
            pcall(fireclickdetector, x)
        end
    end

    return "ok"
end

--==================== ROUND WATCHER ====================
safeLoop("round", function()
    task.wait(0.5)
    local live = #findCandy() > 0
    local now = os.clock()

    if live then
        lastSeen = now
        if not roundActive then
            roundActive = true
            firstGrab = true
            say("round live")
        end
    elseif roundActive and (now - lastSeen) > CFG.RoundGrace then
        roundActive = false
        say("round over - waiting")
    end
end)

--==================== BAG COUNTER DETECTION ====================
local learnedMax
local bagSource = "none"
local fullStreak = 0
local lastFullReason = "-"
local cornerText = "none"

local banned = {}      -- src -> true, never moved while picks happened
local counterSeen = {} -- src -> { last, picked, changed, born }

local function isOurs(d) return d:IsDescendantOf(gui) end

local function inCorner(d)
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local vp = cam.ViewportSize
    if not vp or vp.X <= 0 or vp.Y <= 0 then return false end
    local pos, size = d.AbsolutePosition, d.AbsoluteSize
    if not pos or not size then return false end
    local cx = (pos.X + size.X / 2) / vp.X
    local cy = (pos.Y + size.Y / 2) / vp.Y
    return cx >= CFG.CornerX and cy >= CFG.CornerY
end

local function cornerLabels()
    local out = {}
    local p = lp:FindFirstChildOfClass("PlayerGui")
    if not p then return out end
    for _, d in ipairs(p:GetDescendants()) do
        if not isOurs(d) and (d:IsA("TextLabel") or d:IsA("TextButton"))
        and d.Visible and #d.Text <= 16 and d.Text:find("%d") and inCorner(d) then
            out[#out + 1] = d
        end
    end
    table.sort(out, function(a, b)
        local ay, by = a.AbsolutePosition.Y, b.AbsolutePosition.Y
        if math.abs(ay - by) > 8 then return ay < by end
        return a.AbsolutePosition.X < b.AbsolutePosition.X
    end)
    return out
end

local function cornerRead()
    local labels = cornerLabels()
    if #labels == 0 then return nil end

    for _, d in ipairs(labels) do
        local a, b = d.Text:match("(%d+)%s*/%s*(%d+)")
        if a and b and tonumber(b) >= CFG.MinCap then
            return tonumber(a), tonumber(b), "corner:" .. d.Name
        end
    end

    local nums = {}
    for _, d in ipairs(labels) do
        local n = d.Text:match("%d+")
        if n then nums[#nums + 1] = tonumber(n) end
    end

    if #nums >= 2 then
        local cur, max = nums[1], nums[2]
        if max < cur then cur, max = max, cur end
        if max >= CFG.MinCap then return cur, max, "corner-split" end
    end
    if #nums == 1 then return nums[1], nil, "corner-num" end
    return nil
end

local function scoreName(n)
    n = tostring(n):lower()
    local s = 0
    if n:find("candy", 1, true) then s = s + 12 end
    if n:find("bag", 1, true) then s = s + 12 end
    if n:find("2026", 1, true) then s = s + 2 end
    if n:find("count", 1, true) then s = s + 5 end
    if n:find("amount", 1, true) then s = s + 5 end
    if n:find("held", 1, true) then s = s + 4 end
    if n:find("total", 1, true) then s = s + 4 end
    if n:find("max", 1, true) then s = s + 6 end
    if n:find("cap", 1, true) then s = s + 6 end
    if n:find("coin", 1, true) then s = s + 3 end
    return s
end

local function companionMax(attrs, name)
    local base = tostring(name):lower():gsub("%d+", "")
    if base == "" then return nil end
    for k, v in pairs(attrs) do
        if type(v) == "number" and v >= CFG.MinCap then
            local kl = k:lower()
            if kl:find("max", 1, true) or kl:find("cap", 1, true) then
                local kb = kl:gsub("%d+", "")
                if kb ~= "" and (kb:find(base, 1, true) or base:find(kb, 1, true)) then
                    return v
                end
            end
        end
    end
end

local function gatherCandidates()
    local out = {}
    local function add(cur, max, name, src, bonus)
        if type(cur) ~= "number" then return end
        if cur < 0 or cur > 1e6 then return end
        if max and (max < CFG.MinCap or max > 1e6) then max = nil end
        local s = scoreName(name) + (bonus or 0)
        if max then s = s + 10 end
        if s == 0 then s = 1 end
        out[#out + 1] = { cur = cur, max = max, src = src, score = s, name = tostring(name) }
    end

    local ccur, cmax, csrc = cornerRead()
    if ccur then add(ccur, cmax, csrc, csrc, CFG.CornerBonus) end

    local attrs = lp:GetAttributes()
    for k, v in pairs(attrs) do
        if type(v) == "number" then add(v, companionMax(attrs, k), k, "attr:" .. k) end
    end

    for _, c in ipairs(lp:GetChildren()) do
        if c:IsA("IntValue") or c:IsA("NumberValue") then
            add(c.Value, nil, c.Name, "value:" .. c.Name)
        end
    end

    local ls = lp:FindFirstChild("leaderstats")
    if ls then
        for _, c in ipairs(ls:GetChildren()) do
            if c:IsA("IntValue") or c:IsA("NumberValue") then
                add(c.Value, nil, c.Name, "stats:" .. c.Name)
            end
        end
    end

    local p = lp:FindFirstChildOfClass("PlayerGui")
    if p then
        for _, d in ipairs(p:GetDescendants()) do
            if not isOurs(d) and (d:IsA("TextLabel") or d:IsA("TextButton"))
            and d.Visible and #d.Text < 40 then
                local a, b = d.Text:match("(%d+)%s*/%s*(%d+)")
                if a and b then
                    local bonus = inCorner(d) and CFG.CornerBonus or 0
                    add(tonumber(a), tonumber(b), d.Name .. " " .. d.Text, "gui:" .. d.Name, bonus)
                end
            end
        end
    end

    table.sort(out, function(x, y) return x.score > y.score end)
    return out
end

-- best candidate that hasn't been banned
local function readBag()
    for _, c in ipairs(gatherCandidates()) do
        if not banned[c.src] then
            bagSource = c.src
            return c.cur, c.max, c.src, c.score
        end
    end
    return nil
end

local function isRaw(src)
    if not src then return false end
    return src:sub(1, 4) == "attr" or src:sub(1, 5) == "value" or src:sub(1, 5) == "stats"
end

-- a GUI counter is only trusted once we have seen it move with our picks
local function trusted(src)
    if isRaw(src) then return true end
    local rec = counterSeen[src]
    return rec ~= nil and rec.changed == true
end

local function trustLabel(src)
    if not src then return "none" end
    if isRaw(src) then return "raw" end
    local rec = counterSeen[src]
    if not rec then return "new" end
    if rec.changed then return "ok" end
    return "static?"
end

--==================== COUNTER VALIDATOR ====================
safeLoop("counter", function()
    task.wait(0.3)
    local cur, max, src = readBag()
    if not src or not cur then return end

    local rec = counterSeen[src]
    if not rec then
        counterSeen[src] = { last = cur, picked = picked, changed = false, born = os.clock() }
        return
    end

    if cur ~= rec.last then
        rec.changed = true
        rec.last = cur
        rec.picked = picked
        return
    end

    -- never moved while we were picking: it is decoration, not the bag
    if not rec.changed
    and (picked - rec.picked) >= CFG.TrustPicks
    and (os.clock() - rec.born) > 4 then
        banned[src] = true
        print(("[MM2] counter '%s' static at %s/%s - banned"):format(src, tostring(cur), tostring(max)))
    end
end)

--==================== BAG FULL ====================
local function bagBanner()
    local p = lp:FindFirstChildOfClass("PlayerGui")
    if not p then return nil end
    for _, d in ipairs(p:GetDescendants()) do
        if not isOurs(d) and (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
            local t = d.Text:lower()
            if #t < 40 and t:find("bag", 1, true) and t:find("full", 1, true) then
                return d.Text
            end
        end
    end
end

local function bagIsFull()
    if not CFG.AutoReset then fullStreak = 0 return false end
    if (os.clock() - spawnedAt) < CFG.BagGrace then fullStreak = 0 return false end

    local held = picked - pickedAtReset
    if held < CFG.MinPicks then fullStreak = 0 return false end

    local reason

    if CFG.BagSize > 0 then
        if held >= CFG.BagSize then
            reason = ("count %d/%d"):format(held, CFG.BagSize)
        end
    end

    if not reason and CFG.UseBagGui then
        local cur, max, src = readBag()
        if cur and cur > 0 and trusted(src) then
            local cap = max or learnedMax
            if cap then
                learnedMax = cap
                if cur >= cap then
                    reason = ("%d/%d via %s (held %d)"):format(cur, cap, src, held)
                end
            end
        end
        if not reason and CFG.UseBanner then
            local b = bagBanner()
            if b then reason = "banner: " .. b end
        end
    end

    if reason then
        lastFullReason = reason
        fullStreak = fullStreak + 1
        if fullStreak >= CFG.FullConfirm then
            fullStreak = 0
            return true, reason
        end
    else
        fullStreak = 0
        lastFullReason = "-"
    end

    return false
end

--==================== DEATH / SPAWN ====================
local function onDied()
    alive = false
    visited = {}
    failStreak = 0
    fullStreak = 0
    say(roundActive and "dead in round - idling" or "dead - idling")
end

local function onSpawned(ch)
    spawnedAt = os.clock()
    fullStreak = 0
    task.spawn(function()
        local hum = ch:FindFirstChildOfClass("Humanoid") or ch:WaitForChild("Humanoid", 6)
        if not hum then return end
        if boundHum ~= hum then
            boundHum = hum
            pcall(function() hum.Died:Connect(onDied) end)
        end
    end)
end

if lp.Character then onSpawned(lp.Character) end
lp.CharacterAdded:Connect(onSpawned)

--==================== RESET ====================
local function doReset(reason)
    if resetting or not alive then return end
    resetting = true
    resetStart = os.clock()
    alive = false
    failStreak = 0
    fullStreak = 0
    resets = resets + 1
    lastResetReason = reason
    say("bag full (" .. reason .. ") - resetting")
    print("[MM2] auto reset:", reason)

    local old = lp.Character
    pcall(function()
        local hum = old and old:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0
        elseif old then old:BreakJoints() end
    end)

    task.spawn(function()
        task.wait(4)
        if resetting and lp.Character == old then
            pcall(function() lp:LoadCharacter() end)
        end
    end)
end

--==================== FARM STEP ====================
local function farmStep()
    if not farmOn then task.wait(0.2) return end
    if resetting or not alive then task.wait(0.2) return end
    if not roundActive then task.wait(0.2) return end

    local ch = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then task.wait(0.2) return end

    local full, why = bagIsFull()
    if full then doReset(why) return end

    local now = os.clock()

    for k, v in pairs(visited) do
        if not k.Parent or (now - v) > 10 then visited[k] = nil end
    end

    local list = findCandy()
    if #list == 0 then lastGrabAt = now task.wait(0.2) return end

    local near, band = {}, {}
    for _, c in ipairs(list) do
        local v = visited[c]
        if not (v and (now - v) < CFG.Revisit) then
            local d = (c.Position - hrp.Position).Magnitude
            if d <= CFG.Radius then
                near[#near + 1] = c
                if d >= CFG.BandMin and d <= CFG.BandMax then
                    band[#band + 1] = c
                end
            end
        end
    end

    local target
    if firstGrab and #near > 0 then
        target = near[math.random(1, #near)]
        firstGrab = false
    elseif #band > 0 then
        target = band[math.random(1, #band)]
    else
        local bd
        for _, c in ipairs(list) do
            local v = visited[c]
            if not (v and (now - v) < CFG.Revisit) then
                local d = (c.Position - hrp.Position).Magnitude
                if not bd or d < bd then target, bd = c, d end
            end
        end
    end

    if not target then lastGrabAt = os.clock() task.wait(0.1) return end

    local ok, res = pcall(grab, target, hrp)
    visited[target] = os.clock()
    lastGrabAt = os.clock()
    ticks = ticks + 1

    if not ok then
        print("[MM2] grab error: " .. tostring(res))
        task.wait(0.2)
        return
    end

    if res == "ok" then
        if not target.Parent then
            picked = picked + 1
            failStreak = 0
        else
            failStreak = failStreak + 1
            if failStreak >= CFG.FailLimit
            and (picked - pickedAtReset) >= CFG.MinPicks then
                if CFG.LearnFromFails then
                    local cur, _, src = readBag()
                    if cur and cur > 0 and trusted(src) and (not learnedMax or cur > learnedMax) then
                        learnedMax = cur
                        print("[MM2] learned bag cap from dead picks:", cur)
                    end
                end
                doReset(failStreak .. " dead picks")
            end
        end
    end
end

safeLoop("farm", farmStep)

--==================== WATCHDOG ====================
safeLoop("watch", function()
    task.wait(0.25)

    local ch = lp.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")

    if hum then
        if boundHum ~= hum then
            boundHum = hum
            pcall(function() hum.Died:Connect(onDied) end)
        end

        local h = hum.Health > 0
        if h and not alive and (os.clock() - spawnedAt) >= CFG.Settle then
            alive = true
            resetting = false
            visited = {}
            failStreak = 0
            fullStreak = 0
            firstGrab = true
            pickedAtReset = picked
            lastGrabAt = os.clock()
            say(roundActive and "alive in round - farming" or "alive - waiting for round")
        elseif not h and alive then
            alive = false
            say(roundActive and "dead in round - idling" or "dead - idling")
        end
    elseif alive then
        alive = false
    end

    if resetting and (os.clock() - resetStart) > 20 then
        resetting = false
        print("[MM2] resetting watchdog released")
    end

    if farmOn and alive and roundActive and not resetting
    and (os.clock() - lastGrabAt) > CFG.Stall then
        visited = {}
        firstGrab = true
        lastGrabAt = os.clock()
        stalls = stalls + 1
        print("[MM2] stall watchdog - cleared targets")
    end
end)

--==================== BOX ====================
local function visibleButtons()
    local out = {}
    local p = lp:FindFirstChildOfClass("PlayerGui")
    if not p then return out end
    for _, d in ipairs(p:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
            out[#out + 1] = d
        end
    end
    return out
end

local function clickKeyword(kws)
    for _, b in ipairs(visibleButtons()) do
        local label = b.Name .. " "
        if b:IsA("TextButton") then label = label .. b.Text end
        label = label:lower()
        for _, k in ipairs(kws) do
            if label:find(k, 1, true) then
                pcall(function()
                    if firesignal then
                        firesignal(b.MouseButton1Click)
                    else
                        b:Activate()
                    end
                end)
                return b
            end
        end
    end
end

local function openBox()
    if CFG.Mode == "Remote" then
        local ok, result = pcall(function()
            return OpenCrate:InvokeServer(CFG.Crate, CFG.BoxType, CFG.Pay)
        end)

        if not ok then
            return "invoke errored: " .. tostring(result)
        end

        if type(result) == "table" then
            boxes = boxes + 1
            lastRarity = tostring(result.Rarity or "?")
            print("[MM2] rolled:", result.Rarity, result.Name or result.Item or "?")
            return "opened - rarity: " .. lastRarity
        end

        return "returned " .. tostring(result) .. " (nil = open failed, check Candies2026)"
    else
        local b = clickKeyword({ "open", "unbox", "box", "crate", "halloween" })
        if b then boxes = boxes + 1; return "clicked " .. b.Name end
        return "no matching button on screen"
    end
end

--==================== BUTTONS ====================
farmBtn.MouseButton1Click:Connect(function()
    farmOn = not farmOn
    farmBtn.Text = "Farm Candy: " .. (farmOn and "ON" or "OFF")
    farmBtn.BackgroundColor3 = farmOn and Color3.fromRGB(26, 120, 60)
        or Color3.fromRGB(46, 34, 62)
    lastGrabAt = os.clock()
    fullStreak = 0
    say(farmOn and "farming candies..." or "farm stopped")
end)

boxBtn.MouseButton1Click:Connect(function()
    local msg = openBox()
    say(msg)
    print("[MM2] " .. msg)
end)

modeBtn.MouseButton1Click:Connect(function()
    CFG.Mode = (CFG.Mode == "Remote") and "GUI" or "Remote"
    modeBtn.Text = "Box Mode: " .. CFG.Mode
    say("box mode = " .. CFG.Mode)
end)

resetBtn.MouseButton1Click:Connect(function()
    if not alive then say("already dead") return end
    doReset("manual")
end)

-- fill the bag, press once. adopts the current count as the cap and clears bans.
learnBtn.MouseButton1Click:Connect(function()
    banned = {}
    local cur, max, src = readBag()
    if not cur then
        say("no counter found - set CFG.BagSize manually")
        print("[MM2] learn failed: no counter candidate")
        return
    end
    local cap = max or cur
    learnedMax = cap
    counterSeen[src] = counterSeen[src] or { changed = true, last = cur, picked = picked, born = os.clock() }
    counterSeen[src].changed = true
    print(("[MM2] learned cap %d from %s"):format(cap, tostring(src)))
    say(("learned cap %d from %s - resets at %d"):format(cap, tostring(src), cap))
    if alive then doReset("learned cap") end
end)

scanBtn.MouseButton1Click:Connect(function()
    print("===== SHOP REMOTES =====")
    for _, x in ipairs(Shop:GetChildren()) do
        print(x.ClassName, x:GetFullName())
    end

    print("===== BOTTOM-RIGHT CORNER LABELS =====")
    local cl = cornerLabels()
    if #cl == 0 then print("  none detected in corner region") end
    for _, d in ipairs(cl) do
        print(("  %s  pos=(%.0f,%.0f) text=%q"):format(
            d:GetFullName(), d.AbsolutePosition.X, d.AbsolutePosition.Y, d.Text))
    end
    print("  cornerRead() ->", cornerRead())

    print("===== BAG DIAG =====")
    print("-- player attributes --")
    for k, v in pairs(lp:GetAttributes()) do print("  ", k, typeof(v), tostring(v)) end
    print("-- values parented to player --")
    for _, c in ipairs(lp:GetChildren()) do
        if c:IsA("ValueBase") then print("  ", c.ClassName, c.Name, tostring(c.Value)) end
    end

    print("-- all scored candidates (best first) --")
    for i, c in ipairs(gatherCandidates()) do
        if i > 12 then break end
        print(("  %2d) score=%d cur=%s max=%s banned=%s trust=%s src=%s"):format(
            i, c.score, tostring(c.cur), tostring(c.max),
            tostring(banned[c.src] or false), trustLabel(c.src), c.src))
    end

    print("-- gating --")
    print("  held since reset:", picked - pickedAtReset, "minPicks:", CFG.MinPicks)
    print("  fullStreak:", fullStreak, "learnedMax:", tostring(learnedMax))
    print("  spawnedAgo:", ("%.1fs"):format(os.clock() - spawnedAt))
    print("  lastReset:", lastResetReason)
    print("-- round / loop --")
    print("  roundActive:", roundActive, "candies:", #findCandy(),
        "alive:", alive, "resetting:", resetting, "ticks:", ticks, "stalls:", stalls)
    say("diag printed - check console")
end)

--==================== STATS ====================
local function stateLine()
    if resetting then return "RESETTING" end
    if not roundActive then
        return alive and "no round - idle" or "no round - dead"
    end
    return alive and "IN ROUND - alive" or "IN ROUND - dead"
end

task.spawn(function()
    while task.wait(0.4) do
        local ok, err = pcall(function()
            local run = os.clock() - started

            local ccur, cmax, csrc = cornerRead()
            cornerText = ccur and ((cmax and ("%d/%d"):format(ccur, cmax) or tostring(ccur)) .. " " .. tostring(csrc))
                or "none"

            local bagLine = "?"
            local cur, max, src, score = readBag()
            if cur then
                bagLine = (max and ("%d/%d"):format(cur, max) or tostring(cur))
                    .. " " .. tostring(src) .. " s" .. tostring(score or 0)
            elseif learnedMax then
                bagLine = "learned cap " .. learnedMax
            end

            local age = os.clock() - lastGrabAt
            local tickAge = age < 60 and ("%.1fs ago"):format(age) or ("%.0fm ago"):format(age / 60)

            stats.Text = string.format(
                "state  : %s\nround  : %s\ntick   : %s  stalls:%d\npicked : %d  boxes:%d  resets:%d\nheld   : %d\ncorner : %s\ntrust  : %s\nbag    : %s\ncap    : %s\nfull   : %d/%d\nlast   : %s\nuptime : %02d:%02d  per/hr:%.0f",
                stateLine(), roundActive and "active" or "none",
                tickAge, stalls,
                picked, boxes, resets,
                picked - pickedAtReset,
                cornerText,
                trustLabel(src),
                bagLine,
                learnedMax and tostring(learnedMax) or (CFG.BagSize > 0 and tostring(CFG.BagSize) or "none"),
                fullStreak, CFG.FullConfirm,
                lastResetReason,
                run // 60, run % 60,
                picked / math.max(run / 3600, 0.0001))
        end)
        if not ok then print("[MM2] stats error: " .. tostring(err)) end
    end
end)

--==================== ANTI AFK ====================
if CFG.AntiAFK then
    pcall(function()
        local cons = getconnections and getconnections(lp.Idled)
        if cons and #cons > 0 then
            for _, c in ipairs(cons) do
                pcall(function()
                    if c.Disable then c.Disable(c) elseif c.Disconnect then c.Disconnect(c) end
                end)
            end
        else
            lp.Idled:Connect(function()
                VU:CaptureController()
                VU:ClickButton2(Vector2.new())
            end)
        end
    end)
end

print("[MM2 Halloween] loaded - RightShift UI | F1 farm | F2 box | F3 reset | F4 learn cap")
