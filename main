local pinning = false
local function pickWallet()
    if pinning then return end
    pinning = true
    local conn
    local function cleanup() pinning = false; if conn then conn:Disconnect() end end
    task.delay(8, function() if pinning then cleanup(); STATE.log = "wallet pick timed out" end end)
    conn = UIS.InputBegan:Connect(function(i, gp)
        if not pinning or gp then return end
        if i.UserInputType ~= Enum.UserInputType.MouseButton1
            and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local m = UIS:GetMouseLocation()
        cleanup()
        local pg = pgui()
        local found
        for _, y in ipairs({m.Y, m.Y - 36}) do
            for _, o in ipairs(pg:GetGuiObjectsAtPosition(m.X, y)) do
                if (o:IsA("TextLabel") or o:IsA("TextButton"))
                    and o.Visible and chainVisible(o.Parent)
                    and #(o.Text:gsub("[^%d]", "")) > 0 then found = o; break end
            end
            if found then break end
        end
        if not found then STATE.log = "no number label there"; return end
        candySrc = found
        STATE.candy = readCandy()
        STATE.checkedOnce = true
        STATE.walletName = found.Name
        STATE.lastCheck = os.clock()
        STATE.log = "wallet pinned: " .. found.Name
    end)
end

