--=====================================================================
--  MM2 Halloween | Candy Autofarm + Halloween Crate Opener
--  Noclip + TweenSpeed 25 | lands ON candies so Touched always fires
--=====================================================================

local CONFIG = {
	TweenSpeed      = 25,            -- studs / second
	CandyID         = "Candy",       -- CoinID attribute value
	TouchHold       = 0.10,          -- seconds parked on a candy
	IdleWait        = 0.10,
	AntiAFK         = true,
	AutoResetOnFull = false,
	Payment         = "Coins",       -- Coins | Diamonds | Key
	CrateName       = "Halloween Box",
}

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Tween      = game:GetService("TweenService")
local RS         = game:GetService("ReplicatedStorage")
local VU         = game:GetService("VirtualUser")
local UIS        = game:GetService("UserInputService")

local plr = Players.LocalPlayer
local autofarm, noclipOn = false, true
local statusText

--=====================================================
--  GUI
--=====================================================
local function new(c, p, parent)
	local o = Instance.new(c)
	for k, v in pairs(p) do o[k] = v end
	o.Parent = parent
	return o
end

local gui = new("ScreenGui", {
	Name = "VeniceMM2Halloween", ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, nil)
pcall(function() gui.Parent = game:GetService("CoreGui") end)
if not gui.Parent then gui.Parent = plr:WaitForChild("PlayerGui") end

local main = new("Frame", {
	Size = UDim2.new(0, 250, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	Position = UDim2.new(0, 20, 0, 90),
	BackgroundColor3 = Color3.fromRGB(26, 18, 36),
	BorderSizePixel = 0, Active = true,
}, gui)
new("UICorner", {CornerRadius = UDim.new(0, 10)}, main)
new("UIStroke", {Color = Color3.fromRGB(255, 122, 24), Thickness = 1.5}, main)
new("UIListLayout", {
	Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder,
}, main)
new("UIPadding", {
	PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
	PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
}, main)

local title = new("TextLabel", {
	Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold, TextSize = 15,
	TextColor3 = Color3.fromRGB(255, 140, 40),
	Text = "MM2 Halloween  |  Venice",
}, main)

local function makeBtn(text, order)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), LayoutOrder = order,
		BackgroundColor3 = Color3.fromRGB(58, 36, 90),
		BorderSizePixel = 0, Font = Enum.Font.GothamBold,
		TextSize = 13, TextColor3 = Color3.fromRGB(255, 255, 255),
		Text = text, AutoButtonColor = true,
	}, main)
	new("UICorner", {CornerRadius = UDim.new(0, 7)}, b)
	return b
end

local farmBtn    = makeBtn("Auto Farm Candy: OFF", 1)
local crateBtn   = makeBtn("Open Halloween Crate", 2)
local payBtn     = makeBtn("Pay With: Coins", 3)
local crateNameBtn = makeBtn("Crate: " .. CONFIG.CrateName, 4)
local scanBtn    = makeBtn("Scan Unbox Remotes", 5)

statusText = new("TextLabel", {
	Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1, Font = Enum.Font.Gotham,
	TextSize = 11, TextWrapped = true, LayoutOrder = 6,
	TextColor3 = Color3.fromRGB(190, 180, 210), Text = "Ready.",
}, main)

local function setStatus(s) statusText.Text = s end

-- dragging
do
	local drag, start, startPos
	main.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then
			drag, start, startPos = true, i.Position, main.Position
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - start
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
			                          startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then drag = false end
	end)
	UIS.InputBegan:Connect(function(i, gp)
		if not gp and i.KeyCode == Enum.KeyCode.RightShift then
			main.Visible = not main.Visible
		end
	end)
end

--=====================================================
--  NOCLIP  (persistent, survives respawn)
--=====================================================
RunService.Stepped:Connect(function()
	if not noclipOn then return end
	local char = plr.Character
	if not char then return end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			d.CanCollide = false
		end
	end
end)

--=====================================================
--  CANDY
--=====================================================
local function getContainer()
	for _, v in ipairs(workspace:GetChildren()) do
		if v:IsA("Model") then
			local c = v:FindFirstChild("CoinContainer")
			if c then return c end
		end
	end
	local c = workspace:FindFirstChild("CoinContainer", true)
	return c
end

local function getCandies()
	local list, c = {}, getContainer()
	if not c then return list end
	for _, v in ipairs(c:GetChildren()) do
		local id = v:GetAttribute("CoinID")
		local isCandy = (id == CONFIG.CandyID)
			or (id == nil and v.Name:lower():find("candy"))
		if isCandy and v:FindFirstChild("TouchInterest") then
			table.insert(list, v)
		end
	end
	return list
end

local function hrp()
	local ch = plr.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

-- tween straight onto the candy, park on it, then micro-nudge so the
-- TouchInterest definitely registers (noclip can't skip it this way)
local function goTo(part)
	local root = hrp()
	if not root or not part.Parent then return end
	local target = part.Position
	local dist = (target - root.Position).Magnitude
	if dist < 0.5 then return end

	local tw = Tween:Create(root,
		TweenInfo.new(math.max(dist / CONFIG.TweenSpeed, 0.05), Enum.EasingStyle.Linear),
		{CFrame = CFrame.new(target)})
	tw:Play()
	tw.Completed:Wait()

	if not part.Parent then return end
	task.wait(CONFIG.TouchHold)
	if part.Parent then
		root.CFrame = part.CFrame * CFrame.new(0, 0.75, 0)
		task.wait(0.03)
		root.CFrame = part.CFrame
		task.wait(0.03)
	end
end

--=====================================================
--  FARM LOOP
--=====================================================
task.spawn(function()
	while true do
		if autofarm then
			local root = hrp()
			local candies = getCandies()
			if root and #candies > 0 then
				local best, bestD
				for _, c in ipairs(candies) do
					local d = (c.Position - root.Position).Magnitude
					if not bestD or d < bestD then best, bestD = c, d end
				end
				local ok, err = pcall(goTo, best)
				if not ok then setStatus("Farm: " .. tostring(err)) end
			else
				task.wait(CONFIG.IdleWait)
			end
		end
		task.wait()
	end
end)

-- bag full -> optional respawn
pcall(function()
	RS.Remotes.Gameplay.CoinCollected.OnClientEvent:Connect(function(kind, cur, max)
		if CONFIG.AutoResetOnFull and kind == CONFIG.CandyID
		and tonumber(cur) == tonumber(max) then
			local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if h then h.Health = 0 end
		end
	end)
end)

--=====================================================
--  UNBOX REMOTE FINDER
--=====================================================
local function findUnboxRemotes()
	local out = {}
	local paths = {
		{"Remotes","Gameplay","Unbox"},
		{"Remotes","Gameplay","UnboxItem"},
		{"Remotes","Gameplay","UnboxBox"},
		{"Remotes","Gameplay","OpenCrate"},
		{"Remotes","Gameplay","CrateOpen"},
		{"Remotes","Unbox"},
		{"Remotes","Gameplay","Box"},
	}
	for _, p in ipairs(paths) do
		local node, ok = RS, true
		for _, seg in ipairs(p) do
			node = node:FindFirstChild(seg)
			if not node then ok = false break end
		end
		if ok and (node:IsA("RemoteEvent") or node:IsA("RemoteFunction")) then
			if not table.find(out, node) then table.insert(out, node) end
		end
	end
	for _, d in ipairs(RS:GetDescendants()) do
		if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
			local n = d.Name:lower()
			if (n:find("unbox", 1, true) or n:find("crateopen", 1, true)
			or n:find("openbox", 1, true) or n:find("open_crate", 1, true)) then
				if not table.find(out, d) then table.insert(out, d) end
			end
		end
	end
	return out
end

-- halloween crate names living in ReplicatedStorage
local crateOptions = { CONFIG.CrateName }
do
	local seen = { [CONFIG.CrateName] = true }
	for _, d in ipairs(RS:GetDescendants()) do
		local n = d.Name:lower()
		if n:find("halloween", 1, true)
		and (n:find("box") or n:find("crate") or n:find("egg")) then
			if not seen[d.Name] then
				seen[d.Name] = true
				table.insert(crateOptions, d.Name)
			end
		end
	end
end

local crateIndex, payIndex = 1, 1
local payments = { "Coins", "Diamonds", "Key" }

local function openCrate()
	local remotes = findUnboxRemotes()
	if #remotes == 0 then
		setStatus("No unbox remote found. Hit Scan and read the console.")
		return
	end
	local r = remotes[1]
	task.spawn(function()
		local ok, err = pcall(function()
			if r:IsA("RemoteFunction") then
				r:InvokeServer(CONFIG.CrateName, 1, CONFIG.Payment)
			else
				r:FireServer(CONFIG.CrateName, 1, CONFIG.Payment)
			end
		end)
		setStatus(ok and ("Opened with " .. r.Name .. " (" .. CONFIG.CrateName .. ")")
			or ("Unbox error: " .. tostring(err)))
	end)
end

--=====================================================
--  BUTTONS
--=====================================================
farmBtn.MouseButton1Click:Connect(function()
	autofarm = not autofarm
	farmBtn.Text = "Auto Farm Candy: " .. (autofarm and "ON" or "OFF")
	farmBtn.BackgroundColor3 = autofarm and Color3.fromRGB(24, 130, 60)
		or Color3.fromRGB(58, 36, 90)
	setStatus(autofarm and "Farming candies..." or "Farm stopped.")
end)

crateBtn.MouseButton1Click:Connect(openCrate)

payBtn.MouseButton1Click:Connect(function()
	payIndex = payIndex % #payments + 1
	CONFIG.Payment = payments[payIndex]
	payBtn.Text = "Pay With: " .. CONFIG.Payment
end)

crateNameBtn.MouseButton1Click:Connect(function()
	crateIndex = crateIndex % #crateOptions + 1
	CONFIG.CrateName = crateOptions[crateIndex]
	crateNameBtn.Text = "Crate: " .. CONFIG.CrateName
end)

scanBtn.MouseButton1Click:Connect(function()
	local remotes = findUnboxRemotes()
	print("=== MM2 unbox remote candidates ===")
	for i, r in ipairs(remotes) do
		print(i, r:GetFullName(), r.ClassName)
	end
	if #remotes == 0 then print("none found") end
	print("=== halloween crate names ===")
	for _, n in ipairs(crateOptions) do print(n) end
	setStatus("Found " .. #remotes .. " remote(s) - check console.")
end)

--=====================================================
--  ANTI AFK
--=====================================================
if CONFIG.AntiAFK then
	local GC = getconnections or get_signal_cons
	if GC then
		for _, c in ipairs(GC(plr.Idled)) do
			if c.Disable then c.Disable(c) elseif c.Disconnect then c.Disconnect(c) end
		end
	else
		plr.Idled:Connect(function()
			VU:CaptureController()
			VU:ClickButton2(Vector2.new())
		end)
	end
end

setStatus("RightShift hides the menu. Noclip is always on.")
print("[Venice] MM2 Halloween autofarm loaded.")
