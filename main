-- the EVENT tab: prefer a bottom-bar button whose label says "event"
local function findEventTab()
    local vis = visibleButtons()
    for _, kw in ipairs(CONFIG.EventTabKeywords) do
        for _, b in ipairs(vis) do
            if inBottomRow(b) and buttonLabel(b):lower():find(kw, 1, true) then return b end
        end
    end
    return findIn(vis, CONFIG.EventTabKeywords)
end

-- the row of event icons (equal buttons in a row, lower half, above the tab strip)
local function eventIcons()
    local byParent = {}
    for _, b in ipairs(visibleButtons()) do
        local p = b.Parent
        if p then
            local g = byParent[p]
            if not g then g = {}; byParent[p] = g end
            g[#g + 1] = b
        end
    end

    local vh = viewportY()
    local best, bestN = nil, 0
    for _, list in pairs(byParent) do
        if #list >= CONFIG.EventPreviewIndex then
            local row = {}
            local refY = list[1].AbsolutePosition.Y
            local refH = list[1].AbsoluteSize.Y
            local refW = list[1].AbsoluteSize.X
            for _, b in ipairs(list) do
                if math.abs(b.AbsolutePosition.Y - refY) < 24
                    and math.abs(b.AbsoluteSize.Y - refH) < 24
                    and math.abs(b.AbsoluteSize.X - refW) < 24 then
                    row[#row + 1] = b
                end
            end
            if #row >= CONFIG.EventPreviewIndex then
                local avgY = 0
                for _, b in ipairs(row) do avgY += b.AbsolutePosition.Y end
                avgY /= #row
                if avgY > vh * 0.40 and avgY < vh * 0.92 and #row > bestN then
                    best, bestN = row, #row
                end
            end
        end
    end
    if not best then return {} end
    table.sort(best, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
    return best
end

