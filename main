-- ============================================================
--  MM2 HALLOWEEN 2026 - CANDY AUTOFARM        (by Venice)
--  - auto-collects candy on the map (noclips through walls)
--  - auto-opens the Halloween Box '26
--  - tween speed 25 studs/sec (editable in the panel)
--  - RightShift hides/shows the panel
--  Place: Murder Mystery 2 (142823291) - PC + mobile
-- ============================================================

print("[MM2 Farm] script start")

local function svc(name)
    local ok, s = pcall(function() return game:GetService(name) end)
    if ok then return s end
    return nil
end

local Players             = svc("Players")
local TweenService        = svc("TweenService")
local ReplicatedStorage   = svc("ReplicatedStorage")
local UserInputService    = svc("UserInputService")
local VirtualInputManager = svc("VirtualInputManager")
local VirtualUser         = svc("VirtualUser")

local LP        = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

-- ============================================================
--  CONFIG
-- ============================================================
local CFG = {
    TweenSpeed   = 25,     -- studs per second
    CollectRange = 6000,
    BoxCooldown  = 1.5,
    BoxCost      = 600,
    AutoFarm     = true,
    Noclip       = true,
    AutoOpenBox  = true,
    AntiAFK      = true,
}

local STATE = "booting"

-- ============================================================
--  GUI (built first - nothing can hide it)
-- ============================================================
local gui = Instance.new("ScreenGui")
gui.Name = "MM2CandyFarm"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
pcall(function() gui.Parent = PlayerGui end)
if not gui.Parent then
    pcall(function() gui.Parent = svc("CoreGui") end)
end
print("[MM2 Farm] gui parent =", tostring(gui.Parent))

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 250, 0, 330)
frame.Position = UDim2.new(0, 12, 0, 90)
frame.BackgroundColor3 = Color3.fromRGB(22, 20, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
local stroke = Instance.new("UIStroke", frame)
stroke.Color = Color3.fromRGB(255, 140, 0)
stroke.Thickness = 1.5

local layout = Instance.new("UIListLayout", frame)
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 28)
title.BackgroundTransparency = 1
title.Text = "MM2 CANDY AUTOFARM"
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.TextColor3 = Color3.fromRGB(255, 160, 40)
title.LayoutOrder = 0
title.Parent = frame

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 60)
status.BackgroundTransparency = 1
status.Text = "booting..."
status.TextWrapped = true
status.Font = Enum.Font.Gotham
status.TextSize = 11
status.TextColor3 = Color3.fromRGB(160, 160, 175)
status.LayoutOrder = 99
status.Parent = frame

local function setStatus(s)
    status.Text = tostring(s)
end

local banner = Instance.new("TextLabel")
banner.Size = UDim2.new(0, 260, 0, 32)
banner.Position = UDim2.new(0, 12, 0, 50)
banner.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
banner.Text = "SCRIPT LOADED"
banner.Font = Enum.Font.GothamBold
banner.TextSize = 13
banner.TextColor3 = Color3.fromRGB(20, 20, 20)
banner.Parent = gui
Instance.new("UICorner", banner).CornerRadius = UDim.new(0, 8)
task.delay(5, function()
    pcall(function() banner:Destroy() end)
end)

local mini = Instance.new("TextButton")
mini.Size = UDim2.new(0, 58, 0, 26)
mini.Position = UDim2.new(0, 12, 0, 20)
mini.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
mini.Text = "MM2"
mini.Font = Enum.Font.GothamBold
mini.TextSize = 13
mini.TextColor3 = Color3.fromRGB(20, 20, 20)
mini.Visible = false
mini.Parent = gui
Instance.new("UICorner", mini).CornerRadius = UDim.new(0, 6)

mini.MouseButton1Click:Connect(function()
    frame.Visible = true
    mini.Visible = false
end)

if UserInputService then
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            frame.Visible = not frame.Visible
            mini.Visible = not frame.Visible
        end
    end)
end

print("[MM2 Farm] ui built")

-- ============================================================
--  LOGIC (protected - errors show on the panel)
-- ============================================================
local ok, err = xpcall(function()

    local char, hrp

    local function bindChar(c)
        char = c
        hrp = c:WaitForChild("HumanoidRootPart", 15)
        print("[MM2 Farm] character bound")
    end
    if LP.Character then bindChar(LP.Character) end
    LP.CharacterAdded:Connect(bindChar)

    -- --------------------------------------------------------
    -- NOCLIP
    -- --------------------------------------------------------
    local saved, active = {}, false
    task.spawn(function()
        while true do
            if CFG.Noclip then
                if char then
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then
                            if saved[p] == nil then saved[p] = p.CanCollide end
                            p.CanCollide = false
                        end
                    end
                end
                active = true
            elseif active then
                if char then
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") and saved[p] ~= nil then
                            p.CanCollide = saved[p]
                        end
                    end
                end
                saved, active = {}, false
            end
            task.wait(0.1)
        end
    end)

    -- --------------------------------------------------------
    -- CANDY
    -- --------------------------------------------------------
    local function getCandyList()
        local list = {}
        for _, obj in ipairs(workspace:GetChildren()) do
            local container = obj:FindFirstChild("CoinContainer")
                or obj:FindFirstChild("CandyContainer")
            if container then
                for _, item in ipairs(container:GetChildren()) do
                    local part = item
                    if item:IsA("Model") then
                        part = item:FindFirstChild("CoinVisual")
                            or item:FindFirstChild("CandyVisual")
                            or item:FindFirstChildWhichIsA("BasePart")
                    end
                    if part and part:IsA("BasePart") and part.Parent then
                        table.insert(list, part)
                    end
                end
            end
        end
        return list
    end

    local function collect(part)
        if not hrp or not part or not part.Parent then return end
        pcall(function() hrp.CFrame = CFrame.new(part.Position) end)
        if typeof(firetouchinterest) == "function" then
            pcall(function()
                firetouchinterest(hrp, part, 0)
                firetouchinterest(hrp, part, 1)
            end)
            if part.Parent then
                pcall(function()
                    firetouchinterest(hrp, part.Parent, 0)
                    firetouchinterest(hrp, part.Parent, 1)
                end)
            end
        end
    end

    local function farmLoop()
        while CFG.AutoFarm do
            if hrp and hrp.Parent then
                local best, bestD
                for _, part in ipairs(getCandyList()) do
                    local d = (hrp.Position - part.Position).Magnitude
                    if d <= CFG.CollectRange and (not bestD or d < bestD) then
                        best, bestD = part, d
                    end
                end

                if best then
                    STATE = string.format("farming (%.0f studs)", bestD)
                    local dur = math.max(bestD / math.max(CFG.TweenSpeed, 1), 0.05)
                    local tw = TweenService:Create(
                        hrp,
                        TweenInfo.new(dur, Enum.EasingStyle.Linear),
                        { CFrame = CFrame.new(best.Position) }
                    )
                    tw:Play()
                    local t0 = os.clock()
                    while CFG.AutoFarm
                        and best.Parent
                        and tw.PlaybackState == Enum.PlaybackState.Playing
                        and (os.clock() - t0) < dur + 2 do
                        task.wait()
                    end
                    if tw.PlaybackState == Enum.PlaybackState.Playing then
                        tw:Cancel()
                    end
                    collect(best)
                    task.wait(0.05)
                else
                    STATE = "no candy (in lobby?)"
                    task.wait(0.25)
                end
            else
                STATE = "waiting for character"
                task.wait(0.3)
            end
        end
        STATE = "farm off"
    end

    -- --------------------------------------------------------
    -- HALLOWEEN BOX
    -- --------------------------------------------------------
    local boxRemotes
    local function getBoxRemotes()
        if boxRemotes then return boxRemotes end
        boxRemotes = {}
        if not ReplicatedStorage then return boxRemotes end

        local folder = ReplicatedStorage:FindFirstChild("Remotes")
        if folder then
            local r = folder:FindFirstChild("BoxOpened")
            if r and r:IsA("RemoteEvent") then
                table.insert(boxRemotes, r)
            end
        end

        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = string.lower(v.Name)
                if (string.find(n, "box") or string.find(n, "crate") or string.find(n, "unbox"))
                    and not table.find(boxRemotes, v) then
                    table.insert(boxRemotes, v)
                end
            end
        end
        return boxRemotes
    end

    local function clickOpenButtons()
        if not VirtualInputManager then return end
        for _, d in ipairs(PlayerGui:GetDescendants()) do
            if d:IsA("TextButton") and d.Visible and d.AbsoluteSize.Magnitude > 0 then
                local t = string.lower(d.Text)
                if string.find(t, "open") or string.find(t, "unbox") then
                    local c = d.AbsolutePosition + d.AbsoluteSize / 2
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0)
                        task.wait(0.03)
                        VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
                    end)
                end
            end
        end
    end

    local function fireWorldPrompts()
        for _, d in ipairs(workspace:GetDescendants()) do
            local n = string.lower(d.Name)
            if string.find(n, "box") or string.find(n, "crate") then
                if d:IsA("ProximityPrompt") then
                    pcall(function() fireproximityprompt(d) end)
                elseif d:IsA("ClickDetector") then
                    pcall(function() fireclickdetector(d) end)
                end
            end
        end
    end

    local function getCandyCount()
        for k, v in pairs(LP:GetAttributes()) do
            if type(v) == "number" and string.find(string.lower(k), "candy") then
                return v
            end
        end
        for _, d in ipairs(LP:GetDescendants()) do
            if (d:IsA("IntValue") or d:IsA("NumberValue"))
                and string.find(string.lower(d.Name), "candy") then
                return d.Value
            end
        end
        return nil
    end

    local function openBox()
        local remotes = getBoxRemotes()
        if #remotes > 0 then
            for _, r in ipairs(remotes) do
                pcall(function() r:FireServer() end)
            end
        else
            clickOpenButtons()
            fireWorldPrompts()
        end
    end

    local function boxLoop()
        local last = 0
        while CFG.AutoOpenBox do
            if os.clock() - last >= CFG.BoxCooldown then
                local n = getCandyCount()
                if n == nil or n >= CFG.BoxCost then
                    openBox()
                    last = os.clock()
                end
            end
            task.wait(0.1)
        end
    end

    -- --------------------------------------------------------
    -- ANTI-AFK
    -- --------------------------------------------------------
    if CFG.AntiAFK then
        LP.Idled:Connect(function()
            if VirtualUser then
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new())
                end)
            elseif VirtualInputManager then
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end)
            end
        end)
    end

    -- --------------------------------------------------------
    -- DIAGNOSTICS
    -- --------------------------------------------------------
    local function diagnose()
        local maps = {}
        for _, o in ipairs(workspace:GetChildren()) do
            if o:FindFirstChild("CoinContainer") or o:FindFirstChild("CandyContainer") then
                table.insert(maps, o.Name)
            end
        end
        local remotes = getBoxRemotes()
        print("========== MM2 FARM DIAGNOSTICS ==========")
        print("placeid:", game.PlaceId, game.PlaceId == 142823291 and "(MM2 OK)" or "(NOT MM2)")
        print("character:", tostring(LP.Character))
        print("hrp:", tostring(hrp))
        print("firetouchinterest:", tostring(typeof(firetouchinterest) == "function"))
        print("maps with container:", #maps > 0 and table.concat(maps, ", ") or "NONE - join a round")
        print("candy parts visible:", #getCandyList())
        print("candy count:", tostring(getCandyCount()))
        print("box remotes:", #remotes)
        for _, r in ipairs(remotes) do print("   ", r:GetFullName()) end
        print("==========================================")
        return #maps > 0, #remotes
    end

    -- --------------------------------------------------------
    -- CONTROLS
    -- --------------------------------------------------------
    local function addToggle(text, order, get, set)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -20, 0, 32)
        b.LayoutOrder = order
        b.BackgroundColor3 = get() and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(40, 38, 50)
        b.Text = text .. (get() and ": ON" or ": OFF")
        b.TextColor3 = Color3.fromRGB(205, 205, 215)
        b.Font = Enum.Font.GothamMedium
        b.TextSize = 12
        b.Parent = frame
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
        b.MouseButton1Click:Connect(function()
            set(not get())
            local on = get()
            b.Text = text .. (on and ": ON" or ": OFF")
            b.BackgroundColor3 = on and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(40, 38, 50)
        end)
    end

    addToggle("Auto Farm Candy", 1,
        function() return CFG.AutoFarm end,
        function(v)
            CFG.AutoFarm = v
            if v then task.spawn(farmLoop) end
        end)

    addToggle("Noclip", 2,
        function() return CFG.Noclip end,
        function(v) CFG.Noclip = v end)

    addToggle("Auto Open Box", 3,
        function() return CFG.AutoOpenBox end,
        function(v)
            CFG.AutoOpenBox = v
            if v then task.spawn(boxLoop) end
        end)

    local speedRow = Instance.new("Frame")
    speedRow.Size = UDim2.new(1, -20, 0, 32)
    speedRow.BackgroundColor3 = Color3.fromRGB(40, 38, 50)
    speedRow.LayoutOrder = 4
    speedRow.Parent = frame
    Instance.new("UICorner", speedRow).CornerRadius = UDim.new(0, 7)

    local speedLabel = Instance.new("TextLabel")
    speedLabel.Size = UDim2.new(0.6, 0, 1, 0)
    speedLabel.Position = UDim2.new(0, 10, 0, 0)
    speedLabel.BackgroundTransparency = 1
    speedLabel.Text = "Tween speed"
    speedLabel.TextXAlignment = Enum.TextXAlignment.Left
    speedLabel.TextColor3 = Color3.fromRGB(205, 205, 215)
    speedLabel.Font = Enum.Font.GothamMedium
    speedLabel.TextSize = 12
    speedLabel.Parent = speedRow

    local speedBox = Instance.new("TextBox")
    speedBox.Size = UDim2.new(0.3, 0, 0.7, 0)
    speedBox.Position = UDim2.new(0.66, 0, 0.15, 0)
    speedBox.BackgroundColor3 = Color3.fromRGB(25, 24, 32)
    speedBox.Text = tostring(CFG.TweenSpeed)
    speedBox.TextColor3 = Color3.fromRGB(255, 160, 40)
    speedBox.Font = Enum.Font.GothamBold
    speedBox.TextSize = 12
    speedBox.Parent = speedRow
    Instance.new("UICorner", speedBox).CornerRadius = UDim.new(0, 6)
    speedBox.FocusLost:Connect(function()
        local n = tonumber(speedBox.Text)
        if n and n > 0 then CFG.TweenSpeed = n end
        speedBox.Text = tostring(CFG.TweenSpeed)
    end)

    local diagBtn = Instance.new("TextButton")
    diagBtn.Size = UDim2.new(1, -20, 0, 30)
    diagBtn.LayoutOrder = 5
    diagBtn.BackgroundColor3 = Color3.fromRGB(50, 60, 90)
    diagBtn.Text = "Diagnose (see console)"
    diagBtn.TextColor3 = Color3.fromRGB(210, 220, 240)
    diagBtn.Font = Enum.Font.GothamMedium
    diagBtn.TextSize = 12
    diagBtn.Parent = frame
    Instance.new("UICorner", diagBtn).CornerRadius = UDim.new(0, 7)
    diagBtn.MouseButton1Click:Connect(function()
        local inRound, remotes = diagnose()
        diagBtn.Text = inRound and ("OK - in round, " .. remotes .. " remote(s)")
            or "No map - join a round"
        task.delay(3, function()
            diagBtn.Text = "Diagnose (see console)"
        end)
    end)

    -- --------------------------------------------------------
    -- STATUS + AUTO START
    -- --------------------------------------------------------
    task.spawn(function()
        while true do
            local n = getCandyCount()
            setStatus(string.format("state: %s\ncandy: %s  |  speed: %d",
                STATE, n and tostring(n) or "?", CFG.TweenSpeed))
            task.wait(0.4)
        end
    end)

    task.spawn(farmLoop)
    task.spawn(boxLoop)
    print("[MM2 Farm] all systems started")

end, function(e)
    return tostring(e) .. "\n" .. debug.traceback()
end)

if not ok then
    setStatus("ERROR:\n" .. err)
    print("[MM2 Farm] ERROR:", err)
else
    setStatus("running")
end
