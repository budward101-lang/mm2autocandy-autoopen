--=============================================================
--  MM2 HALLOWEEN — CANDY FARM (patched original, staged boot)
--  Only 3 diffs from your working build:
--   1. attempts[] caps hops per candy at 2 -> kills the 4x retry
--   2. auto-open learns your remotes and replays them (no UI needed)
--   3. spy installs LAZILY on button press, never blocks boot
--=============================================================
print("[MM2] 1 boot")

local CONFIG = {
    HopInterval   = 1.0,  HoverHeight = 2.5, RescanTime = 0.8, VerifyDelay = 0.3,
    RetryOnMiss   = true, MaxAttempts = 2,   ClaimCooldown = 3.0, NearestFirst = true,
    NameFilter    = {"candy", "coin"},       MaxSize = 8,
    AutoFarm      = true, AutoOpen = true,   BoxCost = 600, StepCooldown = 1.5,
    RequireBalance = true,
    Keybinds = { UI = Enum.KeyCode.RightShift, Farm = Enum.KeyCode.F1, Open = Enum.KeyCode.F2 },
}
local P    = game:GetService("Players")
local RS   = game:GetService("ReplicatedStorage")
local UIS  = game:GetService("UserInputService")
local LP   = P.LocalPlayer
local S = { farm = CONFIG.AutoFarm, open = CONFIG.AutoOpen, force = false,
            picked = 0, hops = 0, boxes = 0, skipped = 0, log = "init", t0 = os.clock() }
local attempts, claimed = {}, {}
print("[MM2] 2 config ok")

local function pgui() return LP:FindFirstChildOfClass("PlayerGui") end
local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return nil end
    return c, h, r
end
local function nameMatches(n, list)
    n = n:lower()
    for _, f in ipairs(list) do if n:find(f, 1, true) then return true end end
    return false
end
local function isCandy(p)
    if not p:IsA("BasePart") then return false end
    local s = p.Size
    if math.max(s.X, s.Y, s.Z) > CONFIG.MaxSize then return false end
    if not nameMatches(p.Name, CONFIG.NameFilter) then return false end
    local m = p:FindFirstAncestorOfClass("Model")
    if m and P:GetPlayerFromCharacter(m) then return false end
    return true
end
local function stillThere(p)
    if not p or not p.Parent or not p:IsDescendantOf(workspace) then return false end
    if p.Transparency >= 1 then return false end
    return true
end
local function promptDead(p)
    for _, d in ipairs(p:GetChildren()) do
        if d:IsA("ProximityPrompt") and d.Enabled == false then return true end
    end
    return false
end
local function prune(now)
    for p, t in pairs(claimed) do
        if not p.Parent or t < now then claimed[p] = nil end
    end
    for p in pairs(attempts) do if not p.Parent then attempts[p] = nil end end
end
local function validTarget(p, now)
    if not stillThere(p) or not isCandy(p) then return false end
    local c = claimed[p]
    if c and now < c then return false end
    if (attempts[p] or 0) >= CONFIG.MaxAttempts then return false end
    return true
end
local function scanCandies()
    local out = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if isCandy(d) then out[#out + 1] = d end
    end
    return out
end
print("[MM2] 3 helpers ok")

local function interact(part)
    for _, d in ipairs(part:GetChildren()) do
        if d:IsA("ProximityPrompt") and d.Enabled ~= false then
            if fireproximityprompt then pcall(fireproximityprompt, d, d.HoldDuration) end
        elseif d:IsA("ClickDetector") then
            if fireclickdetector then pcall(fireclickdetector, d) end
        end
    end
end
local function hop(target, char, hrp)
    char:PivotTo(CFrame.new(target.Position + Vector3.new(0, CONFIG.HoverHeight, 0)))
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.spawn(function()
        task.wait(0.07)
        if target.Parent then
            char:PivotTo(CFrame.new(target.Position))
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        interact(target)
    end)
end
local function verify(part, char, hrp)
    task.spawn(function()
        task.wait(CONFIG.VerifyDelay)
        if not stillThere(part) or promptDead(part) then
            S.picked += 1
            attempts[part] = CONFIG.MaxAttempts
            return
        end
        if CONFIG.RetryOnMiss and stillThere(part) then
            char:PivotTo(CFrame.new(part.Position))
            hrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(CONFIG.VerifyDelay)
            interact(part)
            task.wait(CONFIG.VerifyDelay)
            if not stillThere(part) or promptDead(part) then
                S.picked += 1
                attempts[part] = CONFIG.MaxAttempts
                return
            end
        end
        attempts[part] = CONFIG.MaxAttempts
        S.skipped += 1
        S.log = "stuck: " .. part.Name
    end)
end

task.spawn(function()
    local list, lastScan, nextHop = {}, 0, 0
    while task.wait() do
        if not S.farm then task.wait(0.05) continue end
        local char, _, hrp = getChar()
        if not char then task.wait(0.1) continue end
        local now = os.clock()
        if now - lastScan > CONFIG.RescanTime then
            lastScan = now
            list = scanCandies()
        end
        prune(now)
        local best, bestD = nil, math.huge
        for i = 1, #list do
            local p = list[i]
            if validTarget(p, now) then
                local d = (p.Position - hrp.Position).Magnitude
                if d < bestD then best, bestD = p, d end
            end
        end
        if now >= nextHop and best then
            attempts[best] = (attempts[best] or 0) + 1
            claimed[best] = now + 1.05
            nextHop = now + CONFIG.HopInterval
            hop(best, char, hrp)
            verify(best, char, hrp)
            S.hops += 1
            print("[MM2] hop " .. S.hops .. " -> " .. best:GetFullName())
        end
    end
end)
print("[MM2] 4 farm loop ok")

--==================== LAZY SPY ====================
local SPY = { installed = false, rec = false, seq = {}, until_ = 0, self_ = false }
local function installSpy()
    if SPY.installed then return true end
    if type(hookfunction) ~= "function" then return false end
    SPY.installed = true
    pcall(function()
        local orig = Instance.new("RemoteEvent").FireServer
        hookfunction(orig, function(self, ...)
            if SPY.rec and not SPY.self_ and os.clock() < SPY.until_ then
                SPY.seq[#SPY.seq + 1] = { r = self, a = table.pack(...) }
            end
            return orig(self, ...)
        end)
    end)
    return true
end
local function replay()
    for _, s in ipairs(SPY.seq) do
        if s.r and s.r.Parent then
            SPY.self_ = true
            pcall(function() s.r:FireServer(table.unpack(s.a, 1, s.a.n)) end)
            SPY.self_ = false
        end
        task.wait(0.25)
    end
end
print("[MM2] 5 spy ok")

--==================== OPEN LOOP ====================
local function visibleButtons()
    local out = {}
    local pg = pgui(); if not pg then return out end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
            out[#out + 1] = d
        end
    end
    return out
end
local function label(b)
    return b:IsA("TextButton") and (b.Name .. " " .. b.Text) or b.Name
end
local function fireBtn(b)
    if not b or not b.Parent then return end
    if getconnections then
        local n = 0
        pcall(function()
            for _, c in ipairs(getconnections(b.MouseButton1Click)) do
                if c.Function then n += 1; pcall(function() c.Function(b) end) end
            end
        end)
        if n > 0 then return end
    end
    pcall(function() b:Activate() end)
end

task.spawn(function()
    local last = 0
    while task.wait(0.2) do
        if not S.open then continue end
        if os.clock() - last < CONFIG.StepCooldown then continue end
        if #SPY.seq > 0 then
            replay()
            last = os.clock()
            S.boxes += 1
            S.log = "replayed " .. #SPY.seq
            task.wait(1.2)
            continue
        end
        local best, bestP
        for _, b in ipairs(visibleButtons()) do
            local l = label(b):lower()
            if not l:find("close", 1, true) and not l:find("back", 1, true) then
                local pri
                if l:find("buy") or l:find("confirm") then pri = 1
                elseif l:find("open") or l:find("unbox") then pri = 2
                elseif l:find("box") or l:find("halloween") or l:find("event") then pri = 3 end
                if pri and (not bestP or pri < bestP) then best, bestP = b, pri end
            end
        end
        if best then
            fireBtn(best); last = os.clock()
            S.log = "clicked " .. best.Name
            task.wait(1.0)
        else
            S.log = "no button"
            task.wait(0.4)
        end
    end
end)
print("[MM2] 6 open loop ok")

--==================== UI ====================
local function new(c, pr, pa)
    local o = Instance.new(c)
    for k, v in pairs(pr) do o[k] = v end
    o.Parent = pa
    return o
end
local gui = new("ScreenGui", { Name = "MM2CandyFarm2", ResetOnSpawn = false,
    IgnoreGuiInset = true }, LP:WaitForChild("PlayerGui"))
local main = new("Frame", { Size = UDim2.new(0, 300, 0, 330), Position = UDim2.new(0, 20, 0, 70),
    BackgroundColor3 = Color3.fromRGB(20, 16, 28), BorderSizePixel = 0, Active = true }, gui)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, main)
new("UIStroke", { Color = Color3.fromRGB(255, 140, 40), Thickness = 1.5 }, main)
new("TextLabel", { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Color3.fromRGB(32, 22, 42),
    Text = "  MM2 CANDY FARM", TextColor3 = Color3.fromRGB(255, 170, 70),
    Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left,
    BorderSizePixel = 0 }, main)
local body = new("Frame", { Size = UDim2.new(1, -20, 1, -42), Position = UDim2.new(0, 10, 0, 38),
    BackgroundTransparency = 1 }, main)
new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, body)
local stats = new("TextLabel", { Size = UDim2.new(1, 0, 0, 84), LayoutOrder = 1,
    BackgroundColor3 = Color3.fromRGB(28, 22, 36), BorderSizePixel = 0,
    TextColor3 = Color3.fromRGB(200, 200, 210), Font = Enum.Font.Code, TextSize = 12,
    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top }, body)
new("UICorner", { CornerRadius = UDim.new(0, 6) }, stats)
new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8) }, stats)

local function mkBtn(o, txt, col)
    local b = new("TextButton", { Size = UDim2.new(1, 0, 0, 28), LayoutOrder = o,
        BackgroundColor3 = col, Text = txt, TextColor3 = Color3.fromRGB(230, 230, 235),
        Font = Enum.Font.GothamMedium, TextSize = 13, BorderSizePixel = 0 }, body)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
    return b
end
local function mkTog(o, txt, g, s)
    local b = mkBtn(o, "", Color3.fromRGB(35, 28, 45))
    local function r()
        b.Text = txt .. ": " .. (g() and "ON" or "OFF")
        b.TextColor3 = g() and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(255, 110, 110)
    end
    b.MouseButton1Click:Connect(function() s(not g()); r() end)
    r()
end
mkTog(2, "Candy Autofarm", function() return S.farm end, function(v) S.farm = v end)
mkTog(3, "Auto Open", function() return S.open end, function(v) S.open = v end)
mkTog(4, "Force (ignore balance)", function() return S.force end, function(v) S.force = v end)
mkBtn(5, "LEARN: record one manual box open (15s)", Color3.fromRGB(35, 55, 40))
    .MouseButton1Click:Connect(function()
        if not installSpy() then S.log = "no hookfunction here"; return end
        SPY.seq = {}; SPY.rec = true; SPY.until_ = os.clock() + 15
        S.log = "RECORDING - open a box now"
        print("[MM2] recording...")
        task.delay(15, function()
            SPY.rec = false
            S.log = "recorded " .. #SPY.seq
            print("[MM2] recorded " .. #SPY.seq .. " remotes")
        end)
    end)
mkBtn(6, "Clear recording", Color3.fromRGB(55, 40, 40))
    .MouseButton1Click:Connect(function() SPY.seq = {}; S.log = "cleared" end)
mkBtn(7, "Reset skip list", Color3.fromRGB(45, 50, 35))
    .MouseButton1Click:Connect(function() attempts, claimed = {}, {}; S.log = "reset" end)
mkBtn(8, "Hide (RightShift)", Color3.fromRGB(60, 30, 30))
    .MouseButton1Click:Connect(function() main.Visible = false end)
print("[MM2] 7 gui ok")

task.spawn(function()
    while task.wait(0.3) do
        local run = os.clock() - S.t0
        stats.Text = string.format("picked  : %d\nskipped : %d\nhops    : %d  (%.2f/s)\ntime    : %02d:%02d\nboxes   : %d\nseq     : %d\nlog     : %s",
            S.picked, S.skipped, S.hops, S.hops / math.max(run, 0.001),
            math.floor(run / 60), math.floor(run % 60), S.boxes, #SPY.seq, (S.log or ""):sub(1, 28))
    end
end)

UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == CONFIG.Keybinds.UI then main.Visible = not main.Visible
    elseif i.KeyCode == CONFIG.Keybinds.Farm then S.farm = not S.farm
    elseif i.KeyCode == CONFIG.Keybinds.Open then S.open = not S.open end
end)

print("[MM2] 8 loaded")
