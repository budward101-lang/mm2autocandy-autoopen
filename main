	local f = new("Frame", { BackgroundColor3 = C.panelHi, BorderSizePixel = 0, LayoutOrder = order }, statsWrap)
	new("UICorner", { CornerRadius = UDim.new(0, 7) }, f)
	new("TextLabel", { Size = UDim2.new(1, 0, 0, 13), Position = UDim2.new(0, 0, 0, 2),
		BackgroundTransparency = 1, Text = label, TextColor3 = C.dim,
		Font = Enum.Font.Gotham, TextSize = 10 }, f)
	return new("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 0, 13),
		BackgroundTransparency = 1, Text = "0", TextColor3 = C.text,
		Font = Enum.Font.GothamBold, TextSize = 14 }, f)
end

local vPicked = cell("PICKED", 1)
