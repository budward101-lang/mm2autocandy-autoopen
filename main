mk("Clear pins", Color3.fromRGB(50, 42, 30))
    .MouseButton1Click:Connect(function()
        shopPin, tilePin, walletEl = nil, nil, nil
        S.shopName, S.tileName = "NONE", "NONE"
        badTile = {}
        S.log = "pins cleared"
    end)

do
    local dragging, startPos, startInput
    head.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = i.Position
            startPos = frame.Position
        end
    end)
    head.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startInput
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

task.spawn(function()
    local last = ""
    while task.wait(0.5) do
        if gateToggle and gateToggle.__refresh then gateToggle.__refresh() end
        local gate
        if S.force then gate = "FORCED"
        elseif not CFG.Gate then gate = "off"
        elseif S.waiting then gate = "WAITING"
        else gate = "armed" end
        local txt = string.format(
            "picked : %d   boxes: %d\ngate   : %s\nbalance: %s / %d\non page: %s  miss:%d\nshop   : %s [%s]\ntile   : %s [%s]\nlog    : %s",
            S.picked, S.boxes, gate,
            S.candy and tostring(S.candy) or "?", CFG.Cost,
            S.onBox and "YES" or "no", S.miss,
            (S.shopName or "NONE"):sub(1, 18), S.shopHow,
            (S.tileName or "-"):sub(1, 18), S.tileHow,
            (S.log or ""):sub(1, 32))
        if txt ~= last then last = txt; status.Text = txt end
    end
end)

UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift then
        frame.Visible = not frame.Visible
    elseif i.KeyCode == Enum.KeyCode.F1 then
        S.farm = not S.farm
    elseif i.KeyCode == Enum.KeyCode.F2 then
        S.open = not S.open
    elseif i.KeyCode == Enum.KeyCode.F3 then
        S.force = not S.force
    end
end)

print("[MM2] === v12 LOAD COMPLETE ===")
