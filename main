print("T2 start")
local Players = game:GetService("Players")
local Tween = game:GetService("TweenService")
local LP = Players.LocalPlayer

local char, hrp
local function bind(c)
    char = c
    hrp = c:WaitForChild("HumanoidRootPart", 10)
end
if LP.Character then bind(LP.Character) end
LP.CharacterAdded:Connect(bind)

local function list()
    local t = {}
    for _, o in ipairs(workspace:GetChildren()) do
        local c = o:FindFirstChild("CoinContainer") or o:FindFirstChild("CandyContainer")
        if c then
            for _, i in ipairs(c:GetChildren()) do
                local p = i
                if i:IsA("Model") then
                    p = i:FindFirstChildWhichIsA("BasePart")
                end
                if p and p:IsA("BasePart") then
                    table.insert(t, p)
                end
            end
        end
    end
    return t
end

task.spawn(function()
    while true do
        if hrp and hrp.Parent then
            local best, bd
            for _, p in ipairs(list()) do
                local d = (hrp.Position - p.Position).Magnitude
                if not bd or d < bd then best, bd = p, d end
            end
            if best then
                print("moving to candy, dist", math.floor(bd))
                local dur = math.max(bd / 25, 0.05)
                local tw = Tween:Create(hrp,
                    TweenInfo.new(dur, Enum.EasingStyle.Linear),
                    { CFrame = CFrame.new(best.Position) })
                tw:Play()
                tw.Completed:Wait()
                hrp.CFrame = CFrame.new(best.Position)
                pcall(function()
                    firetouchinterest(hrp, best, 0)
                    firetouchinterest(hrp, best, 1)
                end)
                task.wait(0.05)
            else
                print("no candy (in lobby?)")
                task.wait(0.5)
            end
        else
            task.wait(0.5)
        end
    end
end)

print("T2 running")
